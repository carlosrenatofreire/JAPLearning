<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MundoDev</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mundodev.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body { margin: 0; }

        .auth-wrapper {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── Left panel (branding) ──────────────────────────── */
        .auth-panel-left {
            background: var(--md-bg-secondary);
            border-right: 1px solid var(--md-border);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px;
            position: relative;
            overflow: hidden;
        }
        .auth-panel-left::before {
            content: '';
            position: absolute;
            top: -100px; right: -100px;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(232,80,26,0.15) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-panel-left::after {
            content: '';
            position: absolute;
            bottom: -80px; left: -80px;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(200,55,42,0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .auth-brand .brand-icon {
            width: 36px; height: 36px;
            background: var(--md-gradient);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 15px; color: #fff;
        }
        .auth-brand .brand-name {
            font-size: 20px; font-weight: 800;
            color: var(--md-text-primary);
            letter-spacing: -0.02em;
        }
        .auth-brand .brand-name span { color: var(--md-accent); }

        /* ── Hero scene (two windows) ──────────────────────── */
        .auth-hero-scene {
            position: relative;
            padding-left: 28px;
            padding-bottom: 28px;
            margin-bottom: 28px;
        }
        .auth-hero-sheet {
            position: absolute;
            top: 28px; left: 0; right: 28px; bottom: 0;
            background: #141e2e;
            border: 1px solid rgba(99,102,241,0.45);
            border-radius: 10px;
            overflow: hidden;
            opacity: 0.88;
            z-index: 0;
        }
        .auth-hero-sheet .sheet-titlebar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            background: #0e1624;
            border-bottom: 1px solid rgba(99,102,241,0.3);
            font-size: 11px;
            color: #94a3b8;
        }
        .auth-hero-sheet .sheet-body {
            padding: 6px 0;
            font-size: 10px;
        }
        .auth-hero-sheet .sheet-row {
            display: grid;
            grid-template-columns: 28px 1fr 60px 60px;
            padding: 3px 12px;
            color: #64748b;
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }
        .auth-hero-sheet .sheet-row.header {
            color: #94a3b8;
            font-weight: 600;
            background: rgba(255,255,255,0.03);
        }
        .auth-hero-sheet .sheet-row.zebra { background: rgba(255,255,255,0.025); }
        .auth-hero-sheet .sheet-row .val { text-align: right; }
        .auth-hero-sheet .sheet-row .green { color: #4ade80; }
        .auth-hero-sheet .sheet-row .red { color: #f87171; }

        .auth-hero-visual {
            position: relative;
            z-index: 1;
            background: #0d1117;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            overflow: hidden;
            font-family: 'Fira Code', 'Cascadia Code', monospace;
            font-size: 11px;
        }
        .auth-hero-visual .code-titlebar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            background: rgba(255,255,255,0.04);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            font-size: 11px;
            color: #94a3b8;
        }
        .auth-hero-visual pre {
            margin: 0;
            padding: 14px;
            font-size: 11px;
            line-height: 1.6;
            color: #94a3b8;
            overflow: hidden;
        }
        .auth-hero-visual .kw { color: #c792ea; }
        .auth-hero-visual .cl { color: #82aaff; }
        .auth-hero-visual .fn { color: #82aaff; }
        .auth-hero-visual .st { color: #c3e88d; }
        .auth-hero-visual .cm { color: #546e7a; font-style: italic; }
        .auth-hero-visual .nm { color: #f78c6c; }

        .auth-panel-tagline {
            position: relative; z-index: 1;
        }
        .auth-panel-tagline h2 {
            font-size: 32px; font-weight: 800;
            line-height: 1.25;
            margin-bottom: 16px;
        }
        .auth-panel-tagline p {
            font-size: 15px;
            color: var(--md-text-secondary);
            line-height: 1.7;
        }

        .auth-social-proof {
            display: flex;
            align-items: center;
            gap: 16px;
            background: var(--md-bg-card);
            border: 1px solid var(--md-border);
            border-radius: var(--md-radius-lg);
            padding: 16px 20px;
            position: relative; z-index: 1;
        }
        .auth-social-proof .quote {
            font-size: 13px;
            color: var(--md-text-secondary);
            line-height: 1.6;
            font-style: italic;
        }
        .auth-social-proof .author {
            font-size: 12px;
            color: var(--md-text-muted);
            margin-top: 4px;
        }

        /* ── Right panel (form) ─────────────────────────────── */
        .auth-panel-right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
            background: var(--md-bg-primary);
        }
        .auth-form-wrapper {
            width: 100%;
            max-width: 420px;
        }
        .auth-form-title {
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 6px;
        }
        .auth-form-subtitle {
            color: var(--md-text-secondary);
            font-size: 14px;
            margin-bottom: 32px;
        }
        .auth-form-subtitle a { color: var(--md-accent); font-weight: 600; }

        /* ── Responsive ─────────────────────────────────────── */
        @@media (max-width: 768px) {
            .auth-wrapper { grid-template-columns: 1fr; }
            .auth-panel-left { display: none; }
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">

        <!-- Left Branding Panel -->
        <div class="auth-panel-left">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">&lt;/&gt;</div>
                <span class="brand-name">Mundo<span>Dev</span></span>
            </a>

            <div class="auth-panel-tagline">

                <!-- Hero scene: spreadsheet behind, code in front -->
                <div class="auth-hero-scene">
                    <!-- Spreadsheet window (behind) -->
                    <div class="auth-hero-sheet">
                        <div class="sheet-titlebar">
                            <i class="bi bi-file-earmark-excel-fill" style="color:#4ade80; font-size:13px;"></i>
                            <span>KPI_Dashboard_2024.xlsx</span>
                        </div>
                        <div class="sheet-body">
                            <div class="sheet-row header"><span>#</span><span>Indicador</span><span class="val">Meta</span><span class="val">Real</span></div>
                            <div class="sheet-row"><span>1</span><span>Receita</span><span class="val">500k</span><span class="val green">512k</span></div>
                            <div class="sheet-row zebra"><span>2</span><span>Churn</span><span class="val">5%</span><span class="val red">7,2%</span></div>
                            <div class="sheet-row"><span>3</span><span>NPS</span><span class="val">70</span><span class="val green">74</span></div>
                            <div class="sheet-row zebra"><span>4</span><span>CAC</span><span class="val">120</span><span class="val green">98</span></div>
                            <div class="sheet-row"><span>5</span><span>LTV</span><span class="val">1.2k</span><span class="val red">1.1k</span></div>
                            <div class="sheet-row zebra"><span>6</span><span>MRR</span><span class="val">80k</span><span class="val green">83k</span></div>
                        </div>
                    </div>
                    <!-- Code window (front) -->
                    <div class="auth-hero-visual">
                        <div class="code-titlebar">
                            <i class="bi bi-circle-fill" style="color:#ff5f57; font-size:8px;"></i>
                            <i class="bi bi-circle-fill" style="color:#ffbd2e; font-size:8px;"></i>
                            <i class="bi bi-circle-fill" style="color:#28ca41; font-size:8px;"></i>
                            <span style="margin-left:6px;">IndicatorService.cs</span>
                        </div>
                        <pre><span class="kw">public class</span> <span class="cl">IndicatorService</span>
{
  <span class="kw">private readonly</span> <span class="cl">IRepository</span> _repo;

  <span class="kw">public async</span> <span class="cl">Task</span>&lt;<span class="cl">KpiResult</span>&gt;
    <span class="fn">CalculateAsync</span>(<span class="cl">Guid</span> id)
  {
    <span class="kw">var</span> kpi = <span class="kw">await</span> _repo
      .<span class="fn">GetByIdAsync</span>(id);

    <span class="cm">// business rule</span>
    <span class="kw">return new</span> <span class="cl">KpiResult</span>
    {
      Value = kpi.<span class="fn">Calculate</span>(),
      Status = <span class="cl">KpiStatus</span>.Ok
    };
  }
}</pre>
                    </div>
                </div>

                <h2>
                    Da planilha ao<br />
                    <span class="md-gradient-text">sistema corporativo.</span>
                </h2>
                <p>
                    Aprenda a transformar processos reais em arquiteturas sólidas
                    com .NET, C4 Model e as decisões que definem um arquiteto de software.
                </p>
            </div>

            <div class="auth-social-proof">
                <img src="/images/carlos-freire.jpg" alt="Carlos Freire" style="width:48px;height:48px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                <div>
                    <p class="quote">"Formei mais de 50 profissionais que hoje atuam em empresas de topo. A metodologia funciona."</p>
                    <p class="author">Carlos Freire — MCSD, Arquiteto de Software &amp; Tech Lead</p>
                </div>
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="auth-panel-right">
            <div class="auth-form-wrapper">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
