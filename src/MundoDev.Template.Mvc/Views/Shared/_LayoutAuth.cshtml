<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MundoDev</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mundodev.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body { margin: 0; }

        .auth-wrapper {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── Left panel (branding) ──────────────────────────── */
        .auth-panel-left {
            background: var(--md-bg-secondary);
            border-right: 1px solid var(--md-border);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px;
            position: relative;
            overflow: hidden;
        }
        .auth-panel-left::before {
            content: '';
            position: absolute;
            top: -100px; right: -100px;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(232,80,26,0.15) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-panel-left::after {
            content: '';
            position: absolute;
            bottom: -80px; left: -80px;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(200,55,42,0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .auth-brand .brand-icon {
            width: 36px; height: 36px;
            background: var(--md-gradient);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 15px; color: #fff;
        }
        .auth-brand .brand-name {
            font-size: 20px; font-weight: 800;
            color: var(--md-text-primary);
            letter-spacing: -0.02em;
        }
        .auth-brand .brand-name span { color: var(--md-accent); }

        .auth-panel-tagline {
            position: relative; z-index: 1;
        }
        .auth-panel-tagline h2 {
            font-size: 32px; font-weight: 800;
            line-height: 1.25;
            margin-bottom: 16px;
        }
        .auth-panel-tagline p {
            font-size: 15px;
            color: var(--md-text-secondary);
            line-height: 1.7;
        }

        .auth-social-proof {
            display: flex;
            align-items: center;
            gap: 16px;
            background: var(--md-bg-card);
            border: 1px solid var(--md-border);
            border-radius: var(--md-radius-lg);
            padding: 16px 20px;
            position: relative; z-index: 1;
        }
        .auth-social-proof .quote {
            font-size: 13px;
            color: var(--md-text-secondary);
            line-height: 1.6;
            font-style: italic;
        }
        .auth-social-proof .author {
            font-size: 12px;
            color: var(--md-text-muted);
            margin-top: 4px;
        }

        /* ── Right panel (form) ─────────────────────────────── */
        .auth-panel-right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
            background: var(--md-bg-primary);
        }
        .auth-form-wrapper {
            width: 100%;
            max-width: 420px;
        }
        .auth-form-title {
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 6px;
        }
        .auth-form-subtitle {
            color: var(--md-text-secondary);
            font-size: 14px;
            margin-bottom: 32px;
        }
        .auth-form-subtitle a { color: var(--md-accent); font-weight: 600; }

        /* ── Responsive ─────────────────────────────────────── */
        @@media (max-width: 768px) {
            .auth-wrapper { grid-template-columns: 1fr; }
            .auth-panel-left { display: none; }
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">

        <!-- Left Branding Panel -->
        <div class="auth-panel-left">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">&lt;/&gt;</div>
                <span class="brand-name">Mundo<span>Dev</span></span>
            </a>

            <div class="auth-panel-tagline">
                <h2>
                    Da planilha ao<br />
                    <span class="md-gradient-text">sistema corporativo.</span>
                </h2>
                <p>
                    Aprenda a transformar processos reais em arquitecturas sólidas
                    com .NET, C4 Model e as decisões que definem um arquitecto de software.
                </p>
            </div>

            <div class="auth-social-proof">
                <div class="md-avatar md-avatar-lg flex-shrink-0">CF</div>
                <div>
                    <p class="quote">"Formei mais de 50 profissionais que hoje actuam em empresas de topo. A metodologia funciona."</p>
                    <p class="author">Carlos Freire — MCSD, Arquitecto de Software &amp; Tech Lead</p>
                </div>
            </div>
        </div>

        <!-- Right Form Panel -->
        <div class="auth-panel-right">
            <div class="auth-form-wrapper">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
