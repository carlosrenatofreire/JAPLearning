<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MundoDev</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mundodev.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body { margin: 0; }

        .auth-wrapper {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── Left panel (branding) ──────────────────────────── */
        .auth-panel-left {
            background: var(--md-bg-secondary);
            border-right: 1px solid var(--md-border);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px;
            position: relative;
            overflow: hidden;
        }
        .auth-panel-left::before {
            content: '';
            position: absolute;
            top: -100px; right: -100px;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(232,80,26,0.15) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-panel-left::after {
            content: '';
            position: absolute;
            bottom: -80px; left: -80px;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(200,55,42,0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .auth-brand .brand-icon {
            width: 36px; height: 36px;
            background: var(--md-gradient);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 15px; color: #fff;
        }
        .auth-brand .brand-name {
            font-size: 20px; font-weight: 800;
            color: var(--md-text-primary);
            letter-spacing: -0.02em;
        }
        .auth-brand .brand-name span { color: var(--md-accent); }

        /* ── 5-window cascade (login panel, ~82% do hero) ──── */
        .auth-panel-tagline {
            flex: 1; display: flex; flex-direction: column;
            justify-content: center;
            position: relative; z-index: 1;
        }
        .auth-panel-tagline h2 {
            font-size: 26px; font-weight: 800;
            line-height: 1.25; margin-bottom: 10px;
        }
        .auth-panel-tagline p {
            font-size: 14px; color: var(--md-text-secondary); line-height: 1.7; margin: 0;
        }
        /* Cascade wrapper — centra horizontalmente */
        .auth-cascade-wrap {
            display: flex; justify-content: center;
            margin-bottom: 22px;
        }
        .auth-cascade {
            position: relative;
            width: 393px; height: 348px;
            flex-shrink: 0;
        }
        /* Base de cada janela (205×280px, offset 47px/17px) */
        .ahw {
            position: absolute; width: 205px; height: 280px;
            border-radius: 8px; overflow: hidden;
            display: flex; flex-direction: column;
        }
        .ahw-bar {
            display: flex; align-items: center; gap: 6px;
            padding: 6px 10px; font-size: 9px; color: #94a3b8; flex-shrink: 0;
        }
        .ahw-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
        .ahw-body { flex: 1; overflow: hidden; }

        .ahw-excel { top:0;   right:188px; z-index:1; background:#141e2e; border:1px solid rgba(99,102,241,0.45); box-shadow:0 6px 28px rgba(0,0,0,0.55); }
        .ahw-excel .ahw-bar  { background:#1a2640; border-bottom:2px solid rgba(99,102,241,0.35); }
        .ahw-c4    { top:17px; right:141px; z-index:2; background:#0c1322; border:1px solid rgba(232,80,26,0.3);  box-shadow:0 6px 28px rgba(0,0,0,0.5);  }
        .ahw-c4    .ahw-bar  { background:#111827; border-bottom:1px solid rgba(232,80,26,0.25); }
        .ahw-er    { top:34px; right:94px;  z-index:3; background:#0d1a14; border:1px solid rgba(34,197,94,0.35); box-shadow:0 6px 28px rgba(0,0,0,0.48); }
        .ahw-er    .ahw-bar  { background:#0a1510; border-bottom:1px solid rgba(34,197,94,0.25); }
        .ahw-code  { top:51px; right:47px;  z-index:4; background:#1e1e2e; border:1px solid rgba(255,255,255,0.12); box-shadow:0 6px 28px rgba(0,0,0,0.45); }
        .ahw-code  .ahw-bar  { background:#252535; border-bottom:1px solid rgba(255,255,255,0.1); }
        .ahw-dash  { top:68px; right:0;     z-index:5; background:#0f1824; border:1px solid rgba(232,80,26,0.38); box-shadow:0 6px 28px rgba(0,0,0,0.4); }
        .ahw-dash  .ahw-bar  { background:#141e2e; border-bottom:1px solid rgba(232,80,26,0.3); }

        /* Excel */
        .asg { font-family:'Courier New',monospace; font-size:8px; }
        .ashr { display:flex; background:#1a2640; border-bottom:2px solid rgba(99,102,241,0.3); }
        .asr  { display:flex; border-top:1px solid rgba(255,255,255,0.07); }
        .asr:nth-child(even) { background:rgba(255,255,255,0.025); }
        .asn  { width:16px; min-width:16px; padding:3px; color:#64748b; border-right:2px solid rgba(99,102,241,0.25); text-align:center; background:#1a2640; font-weight:600; }
        .asc  { flex:1; padding:3px 5px; border-right:1px solid rgba(255,255,255,0.07); color:#94a3b8; white-space:nowrap; overflow:hidden; }
        .asc.h { color:#cbd5e1; background:#1a2640; text-align:center; font-weight:700; }
        .asc.g { color:#4ade80; font-weight:600; }
        .asc.r { color:#f87171; font-weight:600; }
        .asc.o { color:#fb923c; font-weight:600; }
        .asc.b { color:#e2e8f0; font-weight:700; }

        /* C4 */
        .ac4b { padding:8px 8px 0; }
        .ac4x { background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.12); border-radius:4px; padding:4px 6px; text-align:center; color:#cbd5e1; font-size:8px; line-height:1.3; }
        .ac4x.hi { border-color:rgba(232,80,26,0.55); background:rgba(232,80,26,0.08); }
        .ac4l { font-size:7px; color:#475569; margin-top:1px; }
        .ac4a { text-align:center; color:#475569; font-size:11px; line-height:1.3; }

        /* ER */
        .aerb { padding:8px; }
        .aere { background:rgba(34,197,94,0.07); border:1px solid rgba(34,197,94,0.35); border-radius:4px; overflow:hidden; margin-bottom:4px; }
        .aerh { background:rgba(34,197,94,0.15); padding:3px 6px; font-size:8px; font-weight:700; color:#4ade80; text-align:center; }
        .aerf { display:flex; gap:4px; padding:2px 6px; border-top:1px solid rgba(34,197,94,0.1); color:#94a3b8; font-size:8px; }
        .aerpk { color:#fbbf24; font-size:7px; font-weight:700; width:14px; flex-shrink:0; }
        .aerfk { color:#818cf8; font-size:7px; font-weight:700; width:14px; flex-shrink:0; }

        /* Code */
        .acodeb { padding:9px 10px; font-family:'Courier New',monospace; font-size:9px; line-height:1.6; }
        .acc { color:#546e7a; font-style:italic; }
        .ack { color:#c792ea; }
        .acl { color:#82aaff; }
        .acm { color:#82aaff; }
        .acs { color:#c3e88d; }

        /* Dashboard */
        .adashb { padding:8px; }
        .akpim  { display:grid; grid-template-columns:1fr 1fr 1fr; gap:4px; margin-bottom:6px; }
        .akpic  { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:4px; padding:4px 5px; text-align:center; }
        .akpiv  { font-size:11px; font-weight:800; color:#e2e8f0; display:block; }
        .akpil  { font-size:7px; color:#64748b; }
        .achart { background:rgba(255,255,255,0.03); border-radius:4px; padding:6px; border:1px solid rgba(255,255,255,0.06); margin-bottom:5px; }
        .achtt  { font-size:7px; color:#64748b; margin-bottom:4px; }
        .adrow  { display:flex; justify-content:space-between; font-size:7px; color:#64748b; padding:2px 0; border-bottom:1px solid rgba(255,255,255,0.04); }

        .auth-social-proof {
            display: flex;
            align-items: center;
            gap: 16px;
            background: var(--md-bg-card);
            border: 1px solid var(--md-border);
            border-radius: var(--md-radius-lg);
            padding: 16px 20px;
            position: relative; z-index: 1;
        }
        .auth-social-proof .quote {
            font-size: 13px;
            color: var(--md-text-secondary);
            line-height: 1.6;
            font-style: italic;
        }
        .auth-social-proof .author {
            font-size: 12px;
            color: var(--md-text-muted);
            margin-top: 4px;
        }

        /* ── Right panel (form) ─────────────────────────────── */
        .auth-panel-right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
            background: var(--md-bg-primary);
        }
        .auth-form-wrapper {
            width: 100%;
            max-width: 420px;
        }
        .auth-form-title {
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 6px;
        }
        .auth-form-subtitle {
            color: var(--md-text-secondary);
            font-size: 14px;
            margin-bottom: 32px;
        }
        .auth-form-subtitle a { color: var(--md-accent); font-weight: 600; }

        /* ── Free course cards (register panel) ────────────── */
        .auth-free-intro {
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative; z-index: 1;
        }
        .auth-free-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .auth-free-intro h2 {
            font-size: 28px; font-weight: 800;
            line-height: 1.25; margin-bottom: 8px;
        }
        .auth-free-intro p {
            font-size: 14px; color: var(--md-text-secondary);
            line-height: 1.6; margin-bottom: 24px;
        }
        .free-course-card {
            background: var(--md-bg-card);
            border: 1px solid var(--md-border);
            border-radius: var(--md-radius-lg);
            padding: 16px 18px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            transition: var(--md-transition);
            position: relative;
            overflow: hidden;
        }
        .free-course-card:hover {
            border-color: var(--md-accent);
            background: var(--md-bg-card-hover);
            transform: translateY(-1px);
        }
        .free-course-card::before {
            content: '';
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 3px;
            background: var(--md-gradient);
        }
        .free-course-icon {
            width: 44px; height: 44px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; font-weight: 900;
            flex-shrink: 0;
        }
        .free-course-info { flex: 1; min-width: 0; }
        .free-course-title {
            font-size: 13px; font-weight: 700;
            color: var(--md-text-primary);
            margin: 0 0 4px;
            line-height: 1.3;
        }
        .free-course-meta {
            font-size: 11px; color: var(--md-text-muted);
            display: flex; align-items: center; gap: 10px;
        }

        /* ── Responsive ─────────────────────────────────────── */
        @@media (max-width: 768px) {
            .auth-wrapper { grid-template-columns: 1fr; }
            .auth-panel-left { display: none; }
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">

        <!-- Left Branding Panel -->
        <div class="auth-panel-left">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">&lt;/&gt;</div>
                <span class="brand-name">Mundo<span>Dev</span></span>
            </a>

            @if (IsSectionDefined("AuthLeft"))
            {
                @RenderSection("AuthLeft")
            }
            else
            {
            <div class="auth-panel-tagline">

                <!-- 5-window cascade -->
                <div class="auth-cascade-wrap">
                    <div class="auth-cascade">

                        <!-- Window 1: Excel -->
                        <div class="ahw ahw-excel">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:6px; font-size:10px; opacity:.7;"><i class="bi bi-file-earmark-excel-fill" style="color:#4ade80;"></i> KPI_2024.xlsx</span>
                            </div>
                            <div class="ahw-body">
                                <div class="asg"><span>Indicador</span><span>Meta</span><span>Real</span></div>
                                <div class="ashr"><span>Receita</span><span>500k</span><span class="asc">512k</span></div>
                                <div class="asr"><span>Churn</span><span>5%</span><span class="asn">7,2%</span></div>
                                <div class="ashr"><span>NPS</span><span>70</span><span class="asc">74</span></div>
                                <div class="asr"><span>CAC</span><span>120</span><span class="asc">98</span></div>
                                <div class="ashr"><span>LTV</span><span>1.2k</span><span class="asn">1.1k</span></div>
                                <div class="asr"><span>MRR</span><span>80k</span><span class="asc">83k</span></div>
                            </div>
                        </div>

                        <!-- Window 2: C4 Diagram -->
                        <div class="ahw ahw-c4">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:6px; font-size:10px; opacity:.7;">C4 — Context</span>
                            </div>
                            <div class="ahw-body" style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; padding:10px;">
                                <div class="ac4b">User</div>
                                <div class="ac4x">↓</div>
                                <div class="ac4l">KPI System</div>
                                <div class="ac4x">↓ ↓</div>
                                <div style="display:flex; gap:6px;">
                                    <div class="ac4a">API</div>
                                    <div class="ac4a">DB</div>
                                </div>
                            </div>
                        </div>

                        <!-- Window 3: ER Diagram -->
                        <div class="ahw ahw-er">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:6px; font-size:10px; opacity:.7;">ER Diagram</span>
                            </div>
                            <div class="ahw-body" style="padding:8px; display:flex; flex-direction:column; gap:7px;">
                                <div class="aerb">
                                    <div class="aerh">INDICATOR</div>
                                    <div class="aerf"><span class="aerpk">PK</span> Id</div>
                                    <div class="aerf">Name</div>
                                    <div class="aerf"><span class="aerfk">FK</span> CategoryId</div>
                                    <div class="aerf">GoalValue</div>
                                </div>
                                <div class="aerb">
                                    <div class="aerh">CATEGORY</div>
                                    <div class="aerf"><span class="aerpk">PK</span> Id</div>
                                    <div class="aerf">Name</div>
                                </div>
                                <div class="aerb">
                                    <div class="aerh">IND_LOG</div>
                                    <div class="aerf"><span class="aerpk">PK</span> Id</div>
                                    <div class="aerf"><span class="aerfk">FK</span> IndicatorId</div>
                                    <div class="aerf">CreatedAt</div>
                                </div>
                            </div>
                        </div>

                        <!-- Window 4: Code -->
                        <div class="ahw ahw-code">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:6px; font-size:10px; opacity:.7;">IndicatorService.cs</span>
                            </div>
                            <div class="ahw-body acodeb">
                                <div><span class="ack">public class</span> <span class="acm">IndicatorService</span></div>
                                <div>{</div>
                                <div>&nbsp;&nbsp;<span class="ack">private readonly</span> <span class="acm">IRepository</span> _repo;</div>
                                <div>&nbsp;</div>
                                <div>&nbsp;&nbsp;<span class="ack">public async</span> <span class="acm">Task</span>&lt;<span class="acm">KpiResult</span>&gt;</div>
                                <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="acc">CalculateAsync</span>(<span class="acm">Guid</span> id)</div>
                                <div>&nbsp;&nbsp;{</div>
                                <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="ack">var</span> kpi = <span class="ack">await</span> _repo</div>
                                <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.<span class="acc">GetByIdAsync</span>(id);</div>
                                <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="acl">// business rule</span></div>
                                <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="ack">return new</span> <span class="acm">KpiResult</span></div>
                                <div>&nbsp;&nbsp;&nbsp;&nbsp;{</div>
                                <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Value = kpi.<span class="acc">Calculate</span>(),</div>
                                <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Status = <span class="acs">KpiStatus</span>.Ok</div>
                                <div>&nbsp;&nbsp;&nbsp;&nbsp;};</div>
                                <div>&nbsp;&nbsp;}</div>
                                <div>}</div>
                            </div>
                        </div>

                        <!-- Window 5: Dashboard -->
                        <div class="ahw ahw-dash">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:6px; font-size:10px; opacity:.7;">KPI Dashboard</span>
                            </div>
                            <div class="ahw-body adashb">
                                <div class="akpim">
                                    <div class="akpic" style="background:rgba(99,102,241,.15); color:#818cf8;">
                                        <div class="akpiv">512k</div>
                                        <div class="akpil">Receita</div>
                                    </div>
                                    <div class="akpic" style="background:rgba(239,68,68,.12); color:#f87171;">
                                        <div class="akpiv">7,2%</div>
                                        <div class="akpil">Churn</div>
                                    </div>
                                    <div class="akpic" style="background:rgba(34,197,94,.12); color:#4ade80;">
                                        <div class="akpiv">74</div>
                                        <div class="akpil">NPS</div>
                                    </div>
                                </div>
                                <div class="achart">
                                    <div class="achtt">Receita Mensal</div>
                                    <div class="adrow">
                                        <span>Jan</span>
                                        <div style="height:5px; width:55%; background:linear-gradient(90deg,#6366f1,#8b5cf6); border-radius:3px;"></div>
                                    </div>
                                    <div class="adrow">
                                        <span>Fev</span>
                                        <div style="height:5px; width:68%; background:linear-gradient(90deg,#6366f1,#8b5cf6); border-radius:3px;"></div>
                                    </div>
                                    <div class="adrow">
                                        <span>Mar</span>
                                        <div style="height:5px; width:82%; background:linear-gradient(90deg,#6366f1,#8b5cf6); border-radius:3px;"></div>
                                    </div>
                                    <div class="adrow">
                                        <span>Abr</span>
                                        <div style="height:5px; width:75%; background:linear-gradient(90deg,#6366f1,#8b5cf6); border-radius:3px;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <h2>
                    Da planilha ao<br />
                    <span class="md-gradient-text">sistema corporativo.</span>
                </h2>
                <p>
                    Aprenda a transformar processos reais em arquiteturas sólidas
                    com .NET, C4 Model e as decisões que definem um arquiteto de software.
                </p>
            </div>

            <div class="auth-social-proof">
                <img src="/images/carlos-freire.jpg" alt="Carlos Freire" style="width:48px;height:48px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                <div>
                    <p class="quote">"Formei mais de 50 profissionais que hoje atuam em empresas de topo. A metodologia funciona."</p>
                    <p class="author">Carlos Freire — MCSD, Arquiteto de Software &amp; Tech Lead</p>
                </div>
            </div>
            } @* end else *@
        </div>

        <!-- Right Form Panel -->
        <div class="auth-panel-right">
            <div class="auth-form-wrapper">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
