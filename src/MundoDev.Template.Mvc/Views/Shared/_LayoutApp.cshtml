<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MundoDev</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mundodev.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body { margin: 0; }

        /* ── App Shell ──────────────────────────────────────── */
        .app-shell { display: flex; min-height: 100vh; }

        /* ── Sidebar ────────────────────────────────────────── */
        .app-sidebar {
            width: 240px;
            background: var(--md-bg-sidebar);
            border-right: 1px solid var(--md-border);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 100;
            overflow-y: auto;
        }
        .sidebar-brand {
            padding: 20px 20px 16px;
            border-bottom: 1px solid var(--md-border);
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }
        .sidebar-brand .brand-icon {
            width: 30px; height: 30px;
            background: var(--md-gradient);
            border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 13px; color: #fff;
        }
        .sidebar-brand .brand-name {
            font-size: 16px; font-weight: 800;
            color: var(--md-text-primary);
        }
        .sidebar-brand .brand-name span { color: var(--md-accent); }

        .sidebar-nav { padding: 16px 12px; flex: 1; }
        .sidebar-section { margin-bottom: 24px; }
        .sidebar-section-title {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--md-text-muted);
            padding: 0 10px;
            margin-bottom: 6px;
        }
        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: var(--md-radius-sm);
            color: var(--md-text-secondary);
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            transition: var(--md-transition);
            margin-bottom: 2px;
        }
        .sidebar-item i { font-size: 16px; flex-shrink: 0; }
        .sidebar-item:hover { background: rgba(255,255,255,0.05); color: var(--md-text-primary); }
        .sidebar-item.active {
            background: rgba(232,80,26,0.12);
            color: var(--md-accent);
        }
        .sidebar-item.active i { color: var(--md-accent); }

        .sidebar-footer {
            padding: 16px 12px;
            border-top: 1px solid var(--md-border);
        }
        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: var(--md-radius-sm);
            cursor: pointer;
            transition: var(--md-transition);
        }
        .sidebar-user:hover { background: rgba(255,255,255,0.04); }
        .sidebar-user-info { flex: 1; min-width: 0; }
        .sidebar-user-name { font-size: 13px; font-weight: 600; color: var(--md-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .sidebar-user-plan { font-size: 11px; color: var(--md-text-muted); }

        /* ── Main ───────────────────────────────────────────── */
        .app-main {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .app-topbar {
            height: 56px;
            background: rgba(13,13,26,0.95);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--md-border);
            display: flex;
            align-items: center;
            padding: 0 28px;
            gap: 16px;
            position: sticky;
            top: 0;
            z-index: 50;
        }
        .app-topbar-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--md-text-primary);
            flex: 1;
        }
        .app-content {
            padding: 32px 28px;
            flex: 1;
        }

        /* ── Breadcrumb ─────────────────────────────────────── */
        .md-breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: var(--md-text-muted);
            margin-bottom: 24px;
        }
        .md-breadcrumb a { color: var(--md-text-muted); text-decoration: none; }
        .md-breadcrumb a:hover { color: var(--md-accent); }
        .md-breadcrumb .separator { color: var(--md-border); }
        .md-breadcrumb .current { color: var(--md-text-secondary); }

        /* ── Responsive ─────────────────────────────────────── */
        @@media (max-width: 768px) {
            .app-sidebar { transform: translateX(-100%); transition: transform 0.3s ease; }
            .app-sidebar.open { transform: translateX(0); }
            .app-main { margin-left: 0; }
        }
    </style>
</head>
<body>
    <div class="app-shell">

        <!-- ── Sidebar ──────────────────────────────────────── -->
        <aside class="app-sidebar" id="appSidebar">
            <a class="sidebar-brand" asp-controller="App" asp-action="Dashboard">
                <div class="brand-icon">&lt;/&gt;</div>
                <span class="brand-name">Mundo<span>Dev</span></span>
            </a>

            <nav class="sidebar-nav">
                <div class="sidebar-section">
                    <p class="sidebar-section-title">Principal</p>
                    <a asp-controller="App" asp-action="Dashboard" class="sidebar-item @(ViewData["ActiveMenu"]?.ToString() == "dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2"></i> Dashboard
                    </a>
                    <a asp-controller="App" asp-action="MyOrders" class="sidebar-item @(ViewData["ActiveMenu"]?.ToString() == "orders" ? "active" : "")">
                        <i class="bi bi-bag-check"></i> Meus Pedidos
                    </a>
                    <a asp-controller="App" asp-action="MyCertificates" class="sidebar-item @(ViewData["ActiveMenu"]?.ToString() == "certificates" ? "active" : "")">
                        <i class="bi bi-award"></i> Meus Certificados
                    </a>
                </div>
                <div class="sidebar-section">
                    <p class="sidebar-section-title">Conta</p>
                    <a asp-controller="App" asp-action="PersonalData" class="sidebar-item @(ViewData["ActiveMenu"]?.ToString() == "profile" ? "active" : "")">
                        <i class="bi bi-person"></i> Dados Pessoais
                    </a>
                    <a asp-controller="App" asp-action="ContactData" class="sidebar-item @(ViewData["ActiveMenu"]?.ToString() == "contacts" ? "active" : "")">
                        <i class="bi bi-telephone"></i> Dados de Contacto
                    </a>
                    <a asp-controller="App" asp-action="Payment" class="sidebar-item @(ViewData["ActiveMenu"]?.ToString() == "payment" ? "active" : "")">
                        <i class="bi bi-credit-card"></i> Pagamento
                    </a>
                    <a asp-controller="App" asp-action="ChangePassword" class="sidebar-item @(ViewData["ActiveMenu"]?.ToString() == "password" ? "active" : "")">
                        <i class="bi bi-lock"></i> Alterar Senha
                    </a>
                </div>
                <div class="sidebar-section">
                    <p class="sidebar-section-title">Explorar</p>
                    <a asp-controller="App" asp-action="Projects" class="sidebar-item @(ViewData["ActiveMenu"]?.ToString() == "projects" ? "active" : "")">
                        <i class="bi bi-code-square"></i> Projectos
                    </a>
                    <a asp-controller="App" asp-action="Areas" class="sidebar-item @(ViewData["ActiveMenu"]?.ToString() == "areas" ? "active" : "")">
                        <i class="bi bi-layers"></i> Áreas
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="md-avatar">JS</div>
                    <div class="sidebar-user-info">
                        <p class="sidebar-user-name">João Silva</p>
                        <p class="sidebar-user-plan">Plano Pro</p>
                    </div>
                    <i class="bi bi-three-dots-vertical text-muted-md"></i>
                </div>
                <a href="#" class="sidebar-item mt-2" style="color: var(--md-danger);">
                    <i class="bi bi-box-arrow-left"></i> Terminar Sessão
                </a>
            </div>
        </aside>

        <!-- ── Main Content ──────────────────────────────────── -->
        <div class="app-main">
            <div class="app-topbar">
                <span class="app-topbar-title">@ViewData["Title"]</span>
                <a asp-controller="Plans" asp-action="Index" class="btn-md-primary" style="font-size:13px; padding:7px 16px;">
                    <i class="bi bi-arrow-up-circle"></i> Upgrade
                </a>
            </div>
            <div class="app-content">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
