@{
    ViewData["Title"] = "Entrar";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<h2 class="auth-form-title">Bem-vindo de volta</h2>
<p class="auth-form-subtitle">
    Ainda não tem conta?
    <a asp-controller="Auth" asp-action="Register">Criar conta grátis</a>
</p>

<form method="post" asp-controller="Auth" asp-action="Login">
    @Html.AntiForgeryToken()

    <div class="md-form-group">
        <label class="md-label">E-mail</label>
        <input type="email" name="email" class="md-input" placeholder="seuemail@exemplo.com" autocomplete="email" required />
    </div>

    <div class="md-form-group">
        <label class="md-label" style="display:flex; justify-content:space-between;">
            <span>Senha</span>
            <a asp-controller="Auth" asp-action="ForgotPassword" style="font-size:12px; font-weight:500; color:var(--md-accent); text-transform:none; letter-spacing:0;">
                Esqueci a senha
            </a>
        </label>
        <div style="position:relative;">
            <input type="password" name="password" id="loginPassword" class="md-input" placeholder="••••••••" autocomplete="current-password" required style="padding-right:44px;" />
            <button type="button" onclick="togglePassword('loginPassword', this)"
                    style="position:absolute; right:14px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--md-text-muted); cursor:pointer; font-size:16px;">
                <i class="bi bi-eye"></i>
            </button>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-4">
        <input type="checkbox" name="rememberMe" id="rememberMe" style="width:16px; height:16px; accent-color:var(--md-accent); cursor:pointer;" />
        <label for="rememberMe" style="font-size:14px; color:var(--md-text-secondary); cursor:pointer; margin:0;">Manter conectado</label>
    </div>

    <button type="submit" class="btn-md-primary w-100" style="justify-content:center; padding:13px;">
        Entrar <i class="bi bi-arrow-right"></i>
    </button>
</form>

@section Scripts {
<script>
    function togglePassword(id, btn) {
        const input = document.getElementById(id);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }
</script>
}
