@{
    ViewData["Title"] = "Alterar Senha";
    ViewData["ActiveMenu"] = "password";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="md-card">
            <div style="display:flex; align-items:center; gap:14px; margin-bottom:28px;">
                <div style="width:44px; height:44px; background:rgba(232,80,26,0.1); border:1px solid rgba(232,80,26,0.2); border-radius:12px; display:flex; align-items:center; justify-content:center; color:var(--md-accent); font-size:20px;">
                    <i class="bi bi-lock"></i>
                </div>
                <div>
                    <h5 style="font-weight:700; margin:0;">Alterar Senha</h5>
                    <p style="font-size:13px; color:var(--md-text-muted); margin:0;">Escolha uma senha forte com pelo menos 6 caracteres</p>
                </div>
            </div>

            <form method="post" asp-controller="App" asp-action="ChangePassword">
                @Html.AntiForgeryToken()

                <div class="md-form-group">
                    <label class="md-label">Senha Actual</label>
                    <div style="position:relative;">
                        <input type="password" name="currentPassword" id="pwdCurrent" class="md-input" placeholder="••••••••" required style="padding-right:44px;" />
                        <button type="button" onclick="togglePwd('pwdCurrent', this)"
                                style="position:absolute; right:14px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--md-text-muted); cursor:pointer; font-size:16px;">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="md-form-group">
                    <label class="md-label">Nova Senha</label>
                    <div style="position:relative;">
                        <input type="password" name="newPassword" id="pwdNew" class="md-input" placeholder="Mínimo 6 caracteres" required style="padding-right:44px;" oninput="checkStrength(this.value)" />
                        <button type="button" onclick="togglePwd('pwdNew', this)"
                                style="position:absolute; right:14px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--md-text-muted); cursor:pointer; font-size:16px;">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <!-- Indicador de força -->
                    <div style="margin-top:8px;">
                        <div style="display:flex; gap:4px; margin-bottom:4px;">
                            <div id="str1" style="height:3px; flex:1; background:var(--md-border); border-radius:2px; transition:background .3s;"></div>
                            <div id="str2" style="height:3px; flex:1; background:var(--md-border); border-radius:2px; transition:background .3s;"></div>
                            <div id="str3" style="height:3px; flex:1; background:var(--md-border); border-radius:2px; transition:background .3s;"></div>
                            <div id="str4" style="height:3px; flex:1; background:var(--md-border); border-radius:2px; transition:background .3s;"></div>
                        </div>
                        <p id="strLabel" style="font-size:12px; color:var(--md-text-muted); margin:0;"></p>
                    </div>
                </div>

                <div class="md-form-group">
                    <label class="md-label">Confirmar Nova Senha</label>
                    <div style="position:relative;">
                        <input type="password" name="confirmPassword" id="pwdConfirm" class="md-input" placeholder="Repita a nova senha" required style="padding-right:44px;" />
                        <button type="button" onclick="togglePwd('pwdConfirm', this)"
                                style="position:absolute; right:14px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--md-text-muted); cursor:pointer; font-size:16px;">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div style="display:flex; gap:12px; margin-top:8px;">
                    <button type="submit" class="btn-md-primary">
                        <i class="bi bi-check-lg"></i> Alterar Senha
                    </button>
                    <a asp-controller="App" asp-action="PersonalData" class="btn-md-ghost" style="border:1px solid var(--md-border);">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePwd(id, btn) {
        const input = document.getElementById(id);
        const icon = btn.querySelector('i');
        input.type = input.type === 'password' ? 'text' : 'password';
        icon.className = input.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
    }

    function checkStrength(pwd) {
        const bars = [document.getElementById('str1'), document.getElementById('str2'), document.getElementById('str3'), document.getElementById('str4')];
        const label = document.getElementById('strLabel');
        let score = 0;
        if (pwd.length >= 6) score++;
        if (pwd.length >= 10) score++;
        if (/[A-Z]/.test(pwd) && /[0-9]/.test(pwd)) score++;
        if (/[^A-Za-z0-9]/.test(pwd)) score++;

        const colors = ['#EF4444', '#F59E0B', '#6366F1', '#22C55E'];
        const labels = ['', 'Fraca', 'Razoável', 'Boa', 'Forte'];
        bars.forEach((b, i) => b.style.background = i < score ? colors[score - 1] : 'var(--md-border)');
        label.textContent = pwd.length > 0 ? labels[score] : '';
        label.style.color = score > 0 ? colors[score - 1] : 'var(--md-text-muted)';
    }
</script>
}
