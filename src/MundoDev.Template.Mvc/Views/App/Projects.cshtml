@{
    ViewData["Title"] = "Projectos";
    ViewData["ActiveMenu"] = "";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<style>
    .filter-btn {
        padding: 7px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid var(--md-border);
        background: transparent;
        color: var(--md-text-secondary);
        cursor: pointer;
        transition: var(--md-transition);
    }
    .filter-btn:hover, .filter-btn.active {
        border-color: var(--md-accent);
        color: var(--md-accent);
        background: rgba(232,80,26,0.08);
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h4 style="font-weight:800; margin-bottom:4px;">Projectos</h4>
        <p style="color:var(--md-text-muted); font-size:14px; margin:0;">Todos os projectos incluídos no seu plano</p>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <button class="filter-btn active">Todos</button>
        <button class="filter-btn">Em Curso</button>
        <button class="filter-btn">Concluídos</button>
        <button class="filter-btn">Por Iniciar</button>
    </div>
</div>

<div class="row g-4">
    @for (int i = 1; i <= 6; i++)
    {
        <div class="col-md-6 col-xl-4">
            <a asp-controller="App" asp-action="ProjectDetail" asp-route-id="@i" class="md-course-card">
                <div class="md-course-card-thumb" style="background:var(--md-bg-secondary); position:relative;">
                    <div style="text-align:center; padding:20px;">
                        <i class="bi bi-code-square" style="font-size:48px; color:var(--md-border);"></i>
                    </div>
                    <!-- Progress overlay -->
                    <div style="position:absolute; bottom:0; left:0; right:0; height:3px; background:var(--md-border);">
                        <div style="height:100%; width:35%; background:var(--md-gradient);"></div>
                    </div>
                </div>
                <div class="md-course-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="md-badge md-badge-accent">Gestão de KPIs</span>
                        <span style="font-size:12px; color:var(--md-accent); font-weight:700;">35%</span>
                    </div>
                    <p class="md-course-card-title">Sistema de Gestão de Indicadores e KPIs</p>
                    <div class="md-course-card-meta">
                        <span><i class="bi bi-play-circle"></i> 47 aulas</span>
                        <span><i class="bi bi-clock"></i> 6h 00min</span>
                    </div>
                    <div style="margin-top:10px;">
                        <div class="md-progress">
                            <div class="md-progress-bar" style="width:35%;"></div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
