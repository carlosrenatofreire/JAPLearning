@{
    ViewData["Title"] = "Sistema de Gestão de Indicadores e KPIs";
    ViewData["ActiveMenu"] = "";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<!-- Breadcrumb -->
<nav class="md-breadcrumb mb-4">
    <a asp-controller="App" asp-action="Dashboard">Dashboard</a>
    <span class="separator">/</span>
    <a asp-controller="App" asp-action="Projects">Projectos</a>
    <span class="separator">/</span>
    <span class="current">Sistema de Gestão de Indicadores e KPIs</span>
</nav>

<div class="row g-4">
    <!-- Main -->
    <div class="col-lg-8">
        <!-- Meta -->
        <div style="display:flex; gap:20px; flex-wrap:wrap; font-size:13px; color:var(--md-text-muted); margin-bottom:16px;">
            <span><i class="bi bi-person"></i> Carlos Freire</span>
            <span><i class="bi bi-bar-chart"></i> ★★☆ Intermediário</span>
            <span><i class="bi bi-tag"></i> Gestão Corporativa</span>
        </div>

        <!-- Video -->
        <div style="position:relative; width:100%; padding-bottom:56.25%; background:#000; border-radius:var(--md-radius-lg); overflow:hidden; margin-bottom:24px;">
            <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ"
                    style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;"
                    allowfullscreen></iframe>
        </div>

        <!-- Progress bar -->
        <div style="margin-bottom:24px;">
            <div style="display:flex; justify-content:space-between; font-size:13px; color:var(--md-text-muted); margin-bottom:6px;">
                <span>Seu progresso</span>
                <span style="color:var(--md-accent); font-weight:700;">35%</span>
            </div>
            <div class="md-progress">
                <div class="md-progress-bar" style="width:35%;"></div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="md-tabs">
            <a href="#" class="md-tab active" onclick="showTab('ementa', this)">Ementa</a>
            <a href="#" class="md-tab" onclick="showTab('apresentacao', this)">Apresentação</a>
            <a href="#" class="md-tab" onclick="showTab('instrutor', this)">Instrutor</a>
        </div>

        <!-- Ementa -->
        <div id="tab-ementa">

            <!-- Introdução -->
            <div class="md-accordion-item">
                <div class="md-accordion-header">
                    <span>Introdução: O Mindset do Arquiteto</span>
                    <span style="font-size:12px; font-weight:500;">4 aulas · 38min</span>
                </div>
                <div class="md-accordion-body">
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="1" class="md-lesson-item active">
                        <i class="bi bi-play-circle-fill" style="color:var(--md-accent);"></i>
                        <span style="flex:1;">Apresentação (4:10)</span>
                        <span class="md-badge md-badge-accent" style="font-size:11px;">Assistindo</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="2" class="md-lesson-item completed">
                        <i class="bi bi-check-circle-fill" style="color:var(--md-success);"></i>
                        <span style="flex:1;">O Papel do Arquiteto no Mundo Real (11:35)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="3" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Ferramentas de Combate (8:50)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="4" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">O Mindset "Pragmático" (14:20)</span>
                    </a>
                </div>
            </div>

            <!-- Módulo 1 -->
            <div class="md-accordion-item">
                <div class="md-accordion-header">
                    <span>Módulo 1: O Legado e a Dor do Negócio</span>
                    <span style="font-size:12px; font-weight:500;">5 aulas · 1h 06min</span>
                </div>
                <div class="md-accordion-body">
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="5" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">O Inimigo: Anatomia de um Excel (12:00)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="6" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Brainstorming com o PO (A Reunião Inicial) (18:45)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="7" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Extração de Regras de Negócio (15:30)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="8" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Definindo os Atributos de Qualidade (13:10)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="9" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Encerramento: O "OK" do Negócio (7:00)</span>
                    </a>
                </div>
            </div>

            <!-- Módulo 2 -->
            <div class="md-accordion-item">
                <div class="md-accordion-header">
                    <span>Módulo 2: O Desenho da Estratégia</span>
                    <span style="font-size:12px; font-weight:500;">4 aulas · 49min</span>
                </div>
                <div class="md-accordion-body">
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="10" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Contexto de Negócio (C4 Nível 1) (12:00)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="11" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Definindo os Containers (C4 Nível 2) (16:20)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="12" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">A Escolha da Infraestrutura (11:40)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="13" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Apresentando a Arquitetura ao PO (9:15)</span>
                    </a>
                </div>
            </div>

            <!-- Módulo 3 -->
            <div class="md-accordion-item">
                <div class="md-accordion-header">
                    <span>Módulo 3: A Base da Verdade</span>
                    <span style="font-size:12px; font-weight:500;">4 aulas · 1h 01min</span>
                </div>
                <div class="md-accordion-body">
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="14" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Normalização Sem Perda de Sentido (14:00)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="15" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Modelagem Dimensional (17:30)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="16" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Integridade e Auditoria (10:50)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="17" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Desenhando o DER (dbdiagram.io) (19:00)</span>
                    </a>
                </div>
            </div>

            <!-- Módulo 4 -->
            <div class="md-accordion-item">
                <div class="md-accordion-header">
                    <span>Módulo 4: Design de Componentes</span>
                    <span style="font-size:12px; font-weight:500;">4 aulas · 1h 08min</span>
                </div>
                <div class="md-accordion-body">
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="18" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Organização em Camadas (16:00)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="19" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">O Motor de Cálculo (Componentes) (22:10)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="20" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Decisões de Bibliotecas (12:30)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="21" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Estratégia de Cache e Performance (18:00)</span>
                    </a>
                </div>
            </div>

            <!-- Módulo 5 -->
            <div class="md-accordion-item">
                <div class="md-accordion-header">
                    <span>Módulo 5: A Realidade no .NET</span>
                    <span style="font-size:12px; font-weight:500;">3 aulas · 1h 02min</span>
                </div>
                <div class="md-accordion-body">
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="22" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Do Diagrama ao Projeto (20:00)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="23" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">O Motor em Ação (24:40)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="24" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">O Resultado Final (UI) (17:55)</span>
                    </a>
                </div>
            </div>

            <!-- Módulo 6 -->
            <div class="md-accordion-item">
                <div class="md-accordion-header">
                    <span>Módulo 6: Evolução e Sustentabilidade</span>
                    <span style="font-size:12px; font-weight:500;">3 aulas · 37min</span>
                </div>
                <div class="md-accordion-body">
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="25" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">O Pedido de Mudança do PO (15:20)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="26" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Logs e Observabilidade (13:45)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="27" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Conclusão e Próximos Passos (8:30)</span>
                    </a>
                </div>
            </div>

            <!-- Encerramento -->
            <div class="md-accordion-item">
                <div class="md-accordion-header">
                    <span>Encerramento</span>
                    <span style="font-size:12px; font-weight:500;">2 aulas · 6min</span>
                </div>
                <div class="md-accordion-body">
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="28" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Testes de Conhecimento (—)</span>
                    </a>
                    <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="29" class="md-lesson-item">
                        <i class="bi bi-play-circle" style="color:var(--md-text-muted);"></i>
                        <span style="flex:1;">Considerações Finais (6:00)</span>
                    </a>
                </div>
            </div>

        </div>

        <!-- Apresentação -->
        <div id="tab-apresentacao" style="display:none;">
            <p style="color:var(--md-text-secondary); line-height:1.8;">
                O Sistema de Gestão de Indicadores e KPIs é o primeiro projecto da MundoDev.
                Partimos de um cenário real: uma empresa que gere os seus indicadores de performance
                em planilhas Excel desorganizadas, e transformamos isso num sistema corporativo completo em .NET.
            </p>
        </div>

        <!-- Instrutor -->
        <div id="tab-instrutor" style="display:none;">
            <div class="d-flex align-items-start gap-3">
                <img src="/images/carlos-freire.jpg" alt="Carlos Freire" style="width:48px;height:48px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                <div>
                    <h5 style="font-weight:700; margin-bottom:4px;">Carlos Freire</h5>
                    <p style="color:var(--md-accent); font-size:13px; margin-bottom:10px;">MCSD — Arquiteto de Software &amp; Tech Lead</p>
                    <p style="color:var(--md-text-secondary); font-size:14px; line-height:1.7; margin:0;">
                        Com mais de 25 anos de experiência, Carlos já formou mais de 50 profissionais
                        no ecossistema Microsoft .NET.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <div class="md-card" style="position:sticky; top:80px;">
            <p style="font-size:14px; font-weight:700; color:var(--md-text-primary); margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid var(--md-border);">Informações Gerais</p>
            <div class="md-info-row">
                <span class="md-info-label"><i class="bi bi-clock"></i> Duração</span>
                <span class="md-info-value">06:00 Horas</span>
            </div>
            <div class="md-info-row">
                <span class="md-info-label"><i class="bi bi-folder"></i> Módulos</span>
                <span class="md-info-value">8</span>
            </div>
            <div class="md-info-row">
                <span class="md-info-label"><i class="bi bi-play-circle"></i> Aulas</span>
                <span class="md-info-value">47</span>
            </div>
            <div class="md-info-row">
                <span class="md-info-label"><i class="bi bi-check-circle"></i> Concluídas</span>
                <span class="md-info-value" style="color:var(--md-success);">1 de 47</span>
            </div>
            <div class="mt-4">
                <a asp-controller="App" asp-action="Player" asp-route-projectId="1" asp-route-lessonId="2"
                   class="btn-md-primary w-100" style="justify-content:center; padding:12px;">
                    <i class="bi bi-play-fill"></i> Continuar Assistindo
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function showTab(name, el) {
        event.preventDefault();
        document.querySelectorAll('[id^="tab-"]').forEach(t => t.style.display = 'none');
        document.querySelectorAll('.md-tab').forEach(t => t.classList.remove('active'));
        document.getElementById('tab-' + name).style.display = 'block';
        el.classList.add('active');
    }
</script>
}
