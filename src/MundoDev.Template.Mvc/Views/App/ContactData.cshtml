@{
    ViewData["Title"] = "Dados de Contato";
    ViewData["ActiveMenu"] = "contacts";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="md-card">
            <div style="display:flex; align-items:center; gap:14px; margin-bottom:28px;">
                <div style="width:44px; height:44px; background:rgba(232,80,26,0.1); border:1px solid rgba(232,80,26,0.2); border-radius:12px; display:flex; align-items:center; justify-content:center; color:var(--md-accent); font-size:20px;">
                    <i class="bi bi-telephone"></i>
                </div>
                <div>
                    <h5 style="font-weight:700; margin:0;">Dados de Contato</h5>
                    <p style="font-size:13px; color:var(--md-text-muted); margin:0;">Mantenha seus dados de contato atualizados</p>
                </div>
            </div>

            <form method="post" asp-controller="App" asp-action="ContactData">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="md-form-group">
                            <label class="md-label">Telefone</label>
                            <input type="tel" name="phone" class="md-input" placeholder="+55 (11) 99999-9999" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="md-form-group">
                            <label class="md-label">WhatsApp</label>
                            <input type="tel" name="whatsapp" class="md-input" placeholder="+55 (11) 99999-9999" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="md-form-group">
                            <label class="md-label">LinkedIn</label>
                            <div style="position:relative;">
                                <span style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--md-text-muted); font-size:14px;">
                                    <i class="bi bi-linkedin"></i>
                                </span>
                                <input type="url" name="linkedin" class="md-input" placeholder="https://linkedin.com/in/seuperfil" style="padding-left:40px;" />
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="md-form-group">
                            <label class="md-label">GitHub</label>
                            <div style="position:relative;">
                                <span style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--md-text-muted); font-size:14px;">
                                    <i class="bi bi-github"></i>
                                </span>
                                <input type="url" name="github" class="md-input" placeholder="https://github.com/seuperfil" style="padding-left:40px;" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="md-form-group">
                            <label class="md-label">País</label>
                            <select name="country" class="md-select">
                                <option value="">Selecione...</option>
                                <option value="BR" selected>Brasil</option>
                                <option value="PT">Portugal</option>
                                <option value="AO">Angola</option>
                                <option value="MZ">Moçambique</option>
                                <option value="outros">Outro</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="md-form-group">
                            <label class="md-label">Estado</label>
                            <select name="state" class="md-select">
                                <option value="">Selecione...</option>
                                <option value="SP">São Paulo</option>
                                <option value="RJ">Rio de Janeiro</option>
                                <option value="MG">Minas Gerais</option>
                                <option value="RS">Rio Grande do Sul</option>
                                <option value="PR">Paraná</option>
                                <option value="SC">Santa Catarina</option>
                                <option value="BA">Bahia</option>
                                <option value="outros">Outro</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="md-form-group">
                            <label class="md-label">Cidade</label>
                            <input type="text" name="city" class="md-input" placeholder="Sua cidade" />
                        </div>
                    </div>
                </div>

                <div style="display:flex; gap:12px; margin-top:8px;">
                    <button type="submit" class="btn-md-primary">
                        <i class="bi bi-check-lg"></i> Salvar Alterações
                    </button>
                    <button type="reset" class="btn-md-ghost" style="border:1px solid var(--md-border);">
                        Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
