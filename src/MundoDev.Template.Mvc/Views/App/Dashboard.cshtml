@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveMenu"] = "dashboard";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<style>
    .welcome-banner {
        background: linear-gradient(135deg, rgba(232,80,26,0.12) 0%, rgba(160,31,58,0.06) 100%);
        border: 1px solid rgba(232,80,26,0.2);
        border-radius: var(--md-radius-lg);
        padding: 24px 28px;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }
    .kpi-card {
        background: var(--md-bg-card);
        border: 1px solid var(--md-border);
        border-radius: var(--md-radius);
        padding: 20px;
    }
    .kpi-value { font-size: 28px; font-weight: 800; color: var(--md-text-primary); }
    .kpi-label { font-size: 13px; color: var(--md-text-muted); margin-top: 4px; }
    .kpi-icon {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px;
        margin-bottom: 12px;
    }
    .continue-card {
        background: var(--md-bg-card);
        border: 1px solid var(--md-border);
        border-radius: var(--md-radius);
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 10px;
        text-decoration: none;
        transition: var(--md-transition);
    }
    .continue-card:hover { border-color: rgba(232,80,26,0.35); }
    .continue-thumb {
        width: 64px; height: 64px;
        background: var(--md-bg-secondary);
        border-radius: var(--md-radius-sm);
        display: flex; align-items: center; justify-content: center;
        font-size: 24px;
        color: var(--md-border);
        flex-shrink: 0;
    }
</style>

<!-- Welcome -->
<div class="welcome-banner">
    <div>
        <h3 style="font-weight:800; margin-bottom:4px;">Olá, João! 👋</h3>
        <p style="color:var(--md-text-secondary); margin:0; font-size:14px;">Continue de onde parou. Você está a 13% do seu objectivo.</p>
    </div>
    <a asp-controller="Projects" asp-action="Index" class="btn-md-primary">
        Explorar Projectos <i class="bi bi-arrow-right"></i>
    </a>
</div>

<!-- KPIs -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(99,102,241,0.12); color:#818CF8;">
                <i class="bi bi-collection-play"></i>
            </div>
            <div class="kpi-value">3</div>
            <div class="kpi-label">Projectos em Curso</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(34,197,94,0.12); color:var(--md-success);">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="kpi-value">1</div>
            <div class="kpi-label">Projectos Concluídos</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(245,158,11,0.12); color:var(--md-warning);">
                <i class="bi bi-award"></i>
            </div>
            <div class="kpi-value">1</div>
            <div class="kpi-label">Certificados</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(232,80,26,0.12); color:var(--md-accent);">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="kpi-value">14h</div>
            <div class="kpi-label">Horas Assistidas</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Continue Watching -->
    <div class="col-lg-7">
        <h5 style="font-weight:700; margin-bottom:16px;">Continuar a Assistir</h5>
        @for (int i = 1; i <= 3; i++)
        {
            <a asp-controller="App" asp-action="Player" asp-route-projectId="@i" asp-route-lessonId="1" class="continue-card">
                <div class="continue-thumb"><i class="bi bi-code-square"></i></div>
                <div style="flex:1; min-width:0;">
                    <p style="font-weight:600; font-size:14px; color:var(--md-text-primary); margin:0 0 4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        Sistema de Gestão de Indicadores e KPIs
                    </p>
                    <p style="font-size:12px; color:var(--md-text-muted); margin:0 0 8px;">Módulo 2 · Aula 3 de 8</p>
                    <div class="md-progress">
                        <div class="md-progress-bar" style="width:35%;"></div>
                    </div>
                </div>
                <span style="font-size:12px; color:var(--md-text-muted); flex-shrink:0;">35%</span>
            </a>
        }
    </div>

    <!-- Plano -->
    <div class="col-lg-5">
        <h5 style="font-weight:700; margin-bottom:16px;">O Teu Plano</h5>
        <div class="md-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <p class="md-badge md-badge-accent mb-2">Plano Anual</p>
                    <p style="font-size:22px; font-weight:800; color:var(--md-text-primary); margin:0;">R$77/mês</p>
                </div>
                <i class="bi bi-patch-check-fill" style="font-size:28px; color:var(--md-accent);"></i>
            </div>
            <div class="md-info-row">
                <span class="md-info-label"><i class="bi bi-calendar"></i> Renovação</span>
                <span class="md-info-value">13/05/2027</span>
            </div>
            <div class="md-info-row">
                <span class="md-info-label"><i class="bi bi-person-video3"></i> Mentorias</span>
                <span class="md-info-value">1 disponível</span>
            </div>
            <div class="mt-4">
                <a asp-controller="App" asp-action="Payment" class="btn-md-ghost w-100" style="justify-content:center; border:1px solid var(--md-border);">
                    Gerir Subscrição
                </a>
            </div>
        </div>
    </div>
</div>
