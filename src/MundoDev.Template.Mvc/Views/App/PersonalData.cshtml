@{
    ViewData["Title"] = "Dados Pessoais";
    ViewData["ActiveMenu"] = "profile";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="md-card">
            <h5 style="font-weight:700; margin-bottom:24px;">Dados Pessoais</h5>
            <form method="post" asp-controller="App" asp-action="PersonalData">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="md-form-group">
                            <label class="md-label">Nome</label>
                            <input type="text" name="firstName" class="md-input" value="João" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="md-form-group">
                            <label class="md-label">Sobrenome</label>
                            <input type="text" name="lastName" class="md-input" value="Silva" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="md-form-group">
                            <label class="md-label">E-mail</label>
                            <input type="email" name="email" class="md-input" value="joao@email.com" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="md-form-group">
                            <label class="md-label">Data de Nascimento</label>
                            <input type="date" name="birthDate" class="md-input" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="md-form-group">
                            <label class="md-label">Bio / Apresentação</label>
                            <textarea name="bio" class="md-input" rows="3" style="resize:vertical;" placeholder="Fale um pouco sobre você..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-3 mt-2">
                    <button type="submit" class="btn-md-primary">
                        Salvar Alterações <i class="bi bi-check-lg"></i>
                    </button>
                    <button type="reset" class="btn-md-ghost">Cancelar</button>
                </div>
            </form>
        </div>

        <!-- Zona de Perigo -->
        <div class="md-card mt-4" style="border-color:rgba(239,68,68,0.2);">
            <h5 style="font-weight:700; margin-bottom:8px; color:var(--md-danger);">Zona de Perigo</h5>
            <p style="font-size:14px; color:var(--md-text-secondary); margin-bottom:16px;">
                A eliminação da conta é permanente e não pode ser revertida. Todos os dados e progressos serão perdidos.
            </p>
            <a asp-controller="App" asp-action="DeleteAccount" class="btn-md-ghost" style="color:var(--md-danger); border:1px solid rgba(239,68,68,0.25);">
                <i class="bi bi-trash"></i> Eliminar Conta
            </a>
        </div>
    </div>

    <!-- Avatar sidebar -->
    <div class="col-lg-4">
        <div class="md-card text-center">
            <div class="md-avatar md-avatar-lg mx-auto mb-3" style="width:80px;height:80px;font-size:28px;">JS</div>
            <p style="font-weight:700; font-size:16px; margin-bottom:4px;">João Silva</p>
            <p style="font-size:13px; color:var(--md-text-muted); margin-bottom:16px;">Membro desde Mai 2026</p>
            <span class="md-badge md-badge-accent">Plano Anual</span>
        </div>
    </div>
</div>
