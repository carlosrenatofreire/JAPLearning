@{
    ViewData["Title"] = "Meus Pedidos";
    ViewData["ActiveMenu"] = "orders";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="md-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 style="font-weight:700; margin:0;">Histórico de Pedidos</h5>
        <span class="md-badge md-badge-info">2 pedidos</span>
    </div>

    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:14px;">
            <thead>
                <tr style="border-bottom:1px solid var(--md-border);">
                    <th style="padding:10px 12px; text-align:left; color:var(--md-text-muted); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:.06em;">Pedido</th>
                    <th style="padding:10px 12px; text-align:left; color:var(--md-text-muted); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:.06em;">Plano</th>
                    <th style="padding:10px 12px; text-align:left; color:var(--md-text-muted); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:.06em;">Data</th>
                    <th style="padding:10px 12px; text-align:left; color:var(--md-text-muted); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:.06em;">Valor</th>
                    <th style="padding:10px 12px; text-align:left; color:var(--md-text-muted); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:.06em;">Estado</th>
                    <th style="padding:10px 12px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 1; i <= 2; i++)
                {
                    <tr style="border-bottom:1px solid var(--md-border-light);">
                        <td style="padding:14px 12px; color:var(--md-text-muted); font-family:monospace;">#MD-000@i</td>
                        <td style="padding:14px 12px; font-weight:600; color:var(--md-text-primary);">Plano Anual</td>
                        <td style="padding:14px 12px; color:var(--md-text-secondary);">13/05/2026</td>
                        <td style="padding:14px 12px; font-weight:700; color:var(--md-text-primary);">R$ 924,00</td>
                        <td style="padding:14px 12px;">
                            <span class="md-badge md-badge-success">Pago</span>
                        </td>
                        <td style="padding:14px 12px; text-align:right;">
                            <a href="#" class="btn-md-ghost" style="font-size:12px; padding:6px 12px; border:1px solid var(--md-border);">
                                <i class="bi bi-download"></i> Recibo
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
