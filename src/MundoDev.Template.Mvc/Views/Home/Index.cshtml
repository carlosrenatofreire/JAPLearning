<style>
    .testimonials-dot { background: var(--md-border); transition: var(--md-transition); }
    .testimonials-dot.active { background: var(--md-accent); transform: scale(1.3); }
    .testimonials-dot:hover { background: var(--md-text-muted); }
    .testimonials-nav:hover { border-color: var(--md-accent) !important; color: var(--md-accent) !important; }
    .testimonials-nav:disabled { opacity: 0.4; cursor: not-allowed; }
    .testimonial-linkedin:hover { color: #0a4d8c !important; transform: translateY(-2px); }
</style>

<script>
    (function () {
        const pages = document.querySelectorAll('.testimonials-page');
        const dots = document.querySelectorAll('.testimonials-dot');
        const navs = document.querySelectorAll('.testimonials-nav');
        let current = 1;
        const total = pages.length;

        function show(n) {
            current = n;
            pages.forEach(p => {
                p.style.display = (p.id === 'testimonials-page-' + n) ? '' : 'none';
            });
            dots.forEach(d => {
                d.classList.toggle('active', parseInt(d.dataset.page, 10) === n);
            });
            navs.forEach(b => {
                if (b.dataset.direction === 'prev') b.disabled = (n === 1);
                if (b.dataset.direction === 'next') b.disabled = (n === total);
            });
        }

        dots.forEach(d => d.addEventListener('click', () => show(parseInt(d.dataset.page, 10))));
        navs.forEach(b => b.addEventListener('click', () => {
            const dir = b.dataset.direction === 'next' ? 1 : -1;
            const next = current + dir;
            if (next >= 1 && next <= total) show(next);
        }));
        show(1);
    })();
</script>

