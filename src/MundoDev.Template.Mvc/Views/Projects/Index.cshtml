<style>
    .page-header {
        padding: 60px 0 40px;
        border-bottom: 1px solid var(--md-border);
        margin-bottom: 48px;
    }
    .filter-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }
    .filter-btn {
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid var(--md-border);
        background: transparent;
        color: var(--md-text-secondary);
        cursor: pointer;
        transition: var(--md-transition);
    }
    .filter-btn:hover, .filter-btn.active {
        border-color: var(--md-accent);
        color: var(--md-accent);
        background: rgba(232,80,26,0.08);
    }
    .level-stars { color: var(--md-warning); font-size: 12px; }

    /* Card */
    .md-course-card { overflow: hidden; position: relative; }
    .md-course-card-thumb {
        position: relative;
        overflow: hidden;
        padding: 0;
        background: var(--md-bg-secondary);
        aspect-ratio: 16/9;
    }
    .md-course-card-thumb img {
        width: 100%; height: 100%;
        object-fit: cover; display: block;
        transition: transform 0.4s ease;
    }
    .md-course-card:hover .md-course-card-thumb img {
        transform: scale(1.05);
    }

    /* Status badge over thumbnail */
    .status-badge {
        position: absolute;
        top: 12px; right: 12px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-radius: 6px;
        z-index: 2;
        backdrop-filter: blur(4px);
    }
    .status-badge.mpv {
        background: rgba(34,197,94,0.92);
        color: #fff;
        box-shadow: 0 2px 8px rgba(34,197,94,0.35);
    }
    .status-badge.breve {
        background: rgba(245,158,11,0.92);
        color: #1a0f00;
        box-shadow: 0 2px 8px rgba(245,158,11,0.35);
    }

    /* Category badge variants */
    .cat-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 5px;
        letter-spacing: 0.03em;
    }
    .cat-arquitetura  { background: rgba(232,80,26,0.12);  color: var(--md-accent);   border: 1px solid rgba(232,80,26,0.3); }
    .cat-fundamentos  { background: rgba(99,102,241,0.12); color: #818cf8;            border: 1px solid rgba(99,102,241,0.3); }
    .cat-desenvolvimento { background: rgba(34,197,94,0.12); color: #4ade80;          border: 1px solid rgba(34,197,94,0.3); }

    /* Non-clickable (Breve) card */
    .project-card-wrap.is-breve .md-course-card { cursor: default; opacity: 0.92; }
    .project-card-wrap.is-breve .md-course-card:hover .md-course-card-thumb img { transform: none; }

    /* Empty state */
    .filter-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--md-text-muted);
        display: none;
    }
    .filter-empty.show { display: block; }
</style>

<div class="container">
    <div class="page-header">
        <p style="color:var(--md-accent); font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; margin-bottom:10px;">Catálogo</p>
        <h1 style="font-size:38px; font-weight:900; margin-bottom:12px;">Projetos de Arquitetura e Desenvolvimento</h1>
        <p style="color:var(--md-text-secondary); font-size:16px; max-width:640px; margin:0;">
            Fundamentos sólidos, projetos reais de arquitetura e técnicas modernas de desenvolvimento — tudo o que precisa para se tornar um arquiteto .NET de referência.
        </p>
    </div>

    <!-- Filters -->
    <div class="filter-bar">
        <span style="font-size:13px; color:var(--md-text-muted); font-weight:600;">Filtrar:</span>
        <button class="filter-btn" data-filter="all">Todos</button>
        <button class="filter-btn" data-filter="arquitetura">Arquitetura</button>
        <button class="filter-btn" data-filter="fundamentos">Fundamentos</button>
        <button class="filter-btn" data-filter="desenvolvimento">Desenvolvimento</button>
    </div>

    <!-- Grid -->
    <div id="project-grid" class="row g-4 mb-5">
        @foreach (var p in projects)
        {
            var isClickable = !string.IsNullOrEmpty(p.DetailRoute);
            var openTag = isClickable
                ? $"<a href=\"{p.DetailRoute}\" class=\"md-course-card\">"
                : "<div class=\"md-course-card\">";
            var closeTag = isClickable ? "</a>" : "</div>";

            <div class="col-md-6 col-lg-4 project-card-wrap @(isClickable ? "" : "is-breve")" data-category="@p.CategoryKey">
                @Html.Raw(openTag)
                    <div class="md-course-card-thumb">
                        <img src="@p.Image" alt="@p.Title" />
                        <span class="status-badge @(p.Status == "MPV" ? "mpv" : "breve")">@p.Status</span>
                    </div>
                    <div class="md-course-card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="cat-badge cat-@p.CategoryKey">@p.Category</span>
                            <span class="level-stars">@p.Level</span>
                        </div>
                        <p class="md-course-card-title">@p.Title</p>
                        <p style="font-size:13px; color:var(--md-text-muted); line-height:1.5; margin:0 0 12px;">@p.Description</p>
                        @if (p.Lessons > 0)
                        {
                            <div class="md-course-card-meta">
                                <span><i class="bi bi-play-circle"></i> @p.Lessons aulas</span>
                                @if (!string.IsNullOrEmpty(p.Duration))
                                {
                                    <span><i class="bi bi-clock"></i> @p.Duration</span>
                                }
                                @if (p.Modules > 0)
                                {
                                    <span><i class="bi bi-folder"></i> @p.Modules módulos</span>
                                }
                            </div>
                        }
                        <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--md-border-light); display:flex; align-items:center; gap:8px;">
                            <img src="/images/carlos-freire.jpg" alt="Carlos Freire" style="width:26px;height:26px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                            <span style="font-size:12px; color:var(--md-text-muted);">Carlos Freire</span>
                            @if (p.IsFree)
                            {
                                <span class="md-badge md-badge-success" style="margin-left:auto;">Grátis</span>
                            }
                        </div>
                    </div>
                @Html.Raw(closeTag)
            </div>
        }
    </div>

    <div id="filter-empty" class="filter-empty">
        <i class="bi bi-search" style="font-size:32px; display:block; margin-bottom:8px;"></i>
        Nenhum projeto encontrado nesta categoria.
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const buttons = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.project-card-wrap');
        const empty = document.getElementById('filter-empty');
        const VALID = ['all', 'arquitetura', 'fundamentos', 'desenvolvimento'];
        const DEFAULT_FILTER = 'arquitetura';

        function applyFilter(filter) {
            let visible = 0;
            cards.forEach(c => {
                const match = filter === 'all' || c.dataset.category === filter;
                c.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            empty.classList.toggle('show', visible === 0);
            buttons.forEach(b => b.classList.toggle('active', b.dataset.filter === filter));
        }

        function resolveFilterFromHash() {
            const h = (location.hash || '').replace('#', '').toLowerCase();
            return VALID.includes(h) ? h : DEFAULT_FILTER;
        }

        buttons.forEach(btn => btn.addEventListener('click', () => {
            const f = btn.dataset.filter;
            // Atualiza o hash sem fazer scroll
            history.replaceState(null, '', f === 'all' ? location.pathname : '#' + f);
            applyFilter(f);
        }));

        // Reage a mudanças manuais do hash (ex.: link colado, botão back)
        window.addEventListener('hashchange', () => applyFilter(resolveFilterFromHash()));

        applyFilter(resolveFilterFromHash());
    })();
</script>
}
