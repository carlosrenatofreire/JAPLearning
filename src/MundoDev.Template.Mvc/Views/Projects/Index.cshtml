@{
    ViewData["Title"] = "Projectos";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<style>
    .page-header {
        padding: 60px 0 40px;
        border-bottom: 1px solid var(--md-border);
        margin-bottom: 48px;
    }
    .filter-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }
    .filter-btn {
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid var(--md-border);
        background: transparent;
        color: var(--md-text-secondary);
        cursor: pointer;
        transition: var(--md-transition);
    }
    .filter-btn:hover, .filter-btn.active {
        border-color: var(--md-accent);
        color: var(--md-accent);
        background: rgba(232,80,26,0.08);
    }
    .level-stars { color: var(--md-warning); font-size: 12px; }

    /* Hover effect on project thumbnail */
    .md-course-card { overflow: hidden; }
    .md-course-card-thumb { overflow: hidden; }
    .md-course-card-thumb img {
        transition: transform 0.4s ease;
    }
    .md-course-card:hover .md-course-card-thumb img {
        transform: scale(1.05);
    }

    /* Coming soon card */
    .coming-soon-card {
        height: 100%;
        min-height: 380px;
        border: 2px dashed var(--md-border);
        border-radius: var(--md-radius-lg);
        background: var(--md-bg-secondary);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 32px 24px;
        transition: var(--md-transition);
    }
    .coming-soon-card:hover {
        border-color: var(--md-accent);
        background: rgba(232,80,26,0.04);
    }
    .coming-soon-icon {
        width: 56px; height: 56px;
        border-radius: 14px;
        background: rgba(232,80,26,0.1);
        border: 1px solid rgba(232,80,26,0.25);
        display: flex; align-items: center; justify-content: center;
        font-size: 24px;
        color: var(--md-accent);
        margin-bottom: 16px;
    }
    .coming-soon-card h5 {
        font-weight: 700;
        margin-bottom: 8px;
        color: var(--md-text-primary);
    }
    .coming-soon-card p {
        font-size: 13px;
        color: var(--md-text-muted);
        margin: 0;
        line-height: 1.5;
    }
</style>

<div class="container">
    <div class="page-header">
        <p style="color:var(--md-accent); font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; margin-bottom:10px;">Catálogo</p>
        <h1 style="font-size:38px; font-weight:900; margin-bottom:12px;">Projectos</h1>
        <p style="color:var(--md-text-secondary); font-size:16px; max-width:560px; margin:0;">
            Cada projeto é um sistema real desenvolvido do zero — da planilha à arquitetura, do C4 ao código.
        </p>
    </div>

    <!-- Filters -->
    <div class="filter-bar">
        <span style="font-size:13px; color:var(--md-text-muted); font-weight:600;">Filtrar:</span>
        <button class="filter-btn active">Todos</button>
        <button class="filter-btn">Iniciante</button>
        <button class="filter-btn">Intermediário</button>
        <button class="filter-btn">Avançado</button>
    </div>

    <!-- Grid -->
    <div class="row g-4 mb-5">
        <!-- Projeto real disponível -->
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Projects" asp-action="Detail" asp-route-id="1" class="md-course-card">
                <div class="md-course-card-thumb" style="background: var(--md-bg-secondary); padding:0;">
                    <img src="/images/sistema-gestao-indicadores-kpi.png" alt="Sistema de Gestão de Indicadores e KPIs"
                         style="width:100%; height:100%; object-fit:cover; display:block;" />
                </div>
                <div class="md-course-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="level-stars">★★☆ Intermediário</span>
                    </div>
                    <p class="md-course-card-title">Sistema de Gestão de Indicadores e KPIs</p>
                    <div class="md-course-card-meta">
                        <span><i class="bi bi-play-circle"></i> 47 aulas</span>
                        <span><i class="bi bi-clock"></i> 6h 00min</span>
                        <span><i class="bi bi-folder"></i> 8 módulos</span>
                    </div>
                    <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--md-border-light); display:flex; align-items:center; gap:8px;">
                        <img src="/images/carlos-freire.jpg" alt="Carlos Freire" style="width:26px;height:26px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                        <span style="font-size:12px; color:var(--md-text-muted);">Carlos Freire</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Próximos projetos (placeholders) -->
        <div class="col-md-6 col-lg-4">
            <div class="coming-soon-card">
                <div class="coming-soon-icon"><i class="bi bi-cart-check"></i></div>
                <h5>Sistema de E-commerce</h5>
                <p>Em breve · Avançado<br/>Carrinho, checkout, integração de pagamentos e gestão de stock.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="coming-soon-card">
                <div class="coming-soon-icon"><i class="bi bi-people"></i></div>
                <h5>Sistema de RH e Folha</h5>
                <p>Em breve · Intermediário<br/>Colaboradores, ponto, férias e cálculo de salários.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="coming-soon-card">
                <div class="coming-soon-icon"><i class="bi bi-kanban"></i></div>
                <h5>Sistema de Gestão de Projetos</h5>
                <p>Em breve · Intermediário<br/>Kanban, sprints, alocação de equipas e relatórios.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="coming-soon-card">
                <div class="coming-soon-icon"><i class="bi bi-bank"></i></div>
                <h5>Sistema Financeiro Corporativo</h5>
                <p>Em breve · Avançado<br/>Contas a pagar/receber, conciliação bancária e DRE.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="coming-soon-card">
                <div class="coming-soon-icon"><i class="bi bi-stars"></i></div>
                <h5>Sugira o Próximo</h5>
                <p>Estamos a ouvir.<br/>Tem uma ideia de projeto real que gostaria de ver? Conte-nos.</p>
            </div>
        </div>
    </div>
</div>
