@{
    ViewData["Title"] = "Projectos";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<style>
    .page-header {
        padding: 60px 0 40px;
        border-bottom: 1px solid var(--md-border);
        margin-bottom: 48px;
    }
    .filter-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }
    .filter-btn {
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid var(--md-border);
        background: transparent;
        color: var(--md-text-secondary);
        cursor: pointer;
        transition: var(--md-transition);
    }
    .filter-btn:hover, .filter-btn.active {
        border-color: var(--md-accent);
        color: var(--md-accent);
        background: rgba(232,80,26,0.08);
    }
    .level-stars { color: var(--md-warning); font-size: 12px; }
</style>

<div class="container">
    <div class="page-header">
        <p style="color:var(--md-accent); font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; margin-bottom:10px;">Catálogo</p>
        <h1 style="font-size:38px; font-weight:900; margin-bottom:12px;">Projectos</h1>
        <p style="color:var(--md-text-secondary); font-size:16px; max-width:560px; margin:0;">
            Cada projecto é um sistema real desenvolvido do zero — da planilha à arquitectura, do C4 ao código.
        </p>
    </div>

    <!-- Filters -->
    <div class="filter-bar">
        <span style="font-size:13px; color:var(--md-text-muted); font-weight:600;">Filtrar:</span>
        <button class="filter-btn active">Todos</button>
        <button class="filter-btn">Iniciante</button>
        <button class="filter-btn">Intermediário</button>
        <button class="filter-btn">Avançado</button>
    </div>

    <!-- Grid -->
    <div class="row g-4 mb-5">
        @for (int i = 1; i <= 6; i++)
        {
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Projects" asp-action="Detail" asp-route-id="@i" class="md-course-card">
                    <div class="md-course-card-thumb" style="background: var(--md-bg-secondary);">
                        <div style="text-align:center; padding:20px;">
                            <i class="bi bi-code-square" style="font-size:48px; color:var(--md-border);"></i>
                        </div>
                    </div>
                    <div class="md-course-card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="md-badge md-badge-accent">Gestão de KPIs</span>
                            <span class="level-stars">★★☆ Intermediário</span>
                        </div>
                        <p class="md-course-card-title">Sistema de Gestão de Indicadores e KPIs</p>
                        <div class="md-course-card-meta">
                            <span><i class="bi bi-play-circle"></i> 47 aulas</span>
                            <span><i class="bi bi-clock"></i> 6h 00min</span>
                            <span><i class="bi bi-folder"></i> 8 módulos</span>
                        </div>
                        <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--md-border-light); display:flex; align-items:center; gap:8px;">
                            <div class="md-avatar" style="width:26px;height:26px;font-size:10px; flex-shrink:0;">CF</div>
                            <span style="font-size:12px; color:var(--md-text-muted);">Carlos Freire</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
