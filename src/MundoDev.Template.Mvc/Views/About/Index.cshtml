@{
    ViewData["Title"] = "Quem Somos";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<style>
    .about-hero { padding: 72px 0 56px; border-bottom: 1px solid var(--md-border); margin-bottom: 64px; }
    .timeline-item {
        display: flex;
        gap: 24px;
        padding-bottom: 32px;
        position: relative;
    }
    .timeline-item::before {
        content: '';
        position: absolute;
        left: 19px;
        top: 40px;
        bottom: 0;
        width: 2px;
        background: var(--md-border);
    }
    .timeline-item:last-child::before { display: none; }
    .timeline-dot {
        width: 40px; height: 40px;
        background: var(--md-gradient);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px;
        color: #fff;
        flex-shrink: 0;
        z-index: 1;
    }
    .value-card {
        background: var(--md-bg-card);
        border: 1px solid var(--md-border);
        border-radius: var(--md-radius);
        padding: 24px;
        text-align: center;
    }
    .value-icon {
        width: 52px; height: 52px;
        background: rgba(232,80,26,0.1);
        border: 1px solid rgba(232,80,26,0.2);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 24px; color: var(--md-accent);
        margin: 0 auto 16px;
    }
</style>

<!-- Hero -->
<section class="about-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="md-badge md-badge-accent mb-3 d-inline-block">Sobre a MundoDev</span>
                <h1 style="font-size:42px; font-weight:900; line-height:1.15; margin-bottom:20px;">
                    A ponte entre o<br />
                    <span class="md-gradient-text">código e o negócio.</span>
                </h1>
                <p style="color:var(--md-text-secondary); font-size:17px; line-height:1.8; margin-bottom:24px;">
                    Nascemos para resolver um problema claro: o mercado está saturado de cursos de sintaxe,
                    mas carece de profissionais que saibam transformar processos reais em sistemas corporativos robustos.
                </p>
                <p style="color:var(--md-text-secondary); font-size:17px; line-height:1.8;">
                    A MundoDev é uma fábrica de arquitetos de software, treinados em cenários reais,
                    com a stack Microsoft .NET e a metodologia C4 Model.
                </p>
            </div>
            <div class="col-lg-5">
                <div class="md-card text-center">
                    <div class="md-avatar md-avatar-lg mx-auto mb-3" style="width:88px;height:88px;font-size:30px;">CF</div>
                    <h4 style="font-weight:800; margin-bottom:4px;">Carlos Freire</h4>
                    <p style="color:var(--md-accent); font-size:14px; font-weight:600; margin-bottom:12px;">Fundador &amp; Instrutor Principal</p>
                    <div class="d-flex justify-content-center gap-3 mb-16">
                        <span class="md-badge md-badge-info">MCSD</span>
                        <span class="md-badge md-badge-accent">Tech Lead</span>
                        <span class="md-badge md-badge-success">25+ anos</span>
                    </div>
                    <p style="color:var(--md-text-secondary); font-size:14px; line-height:1.7; margin-bottom:20px;">
                        Arquiteto de Software e Tech Lead com mais de 25 anos de experiência em projetos
                        corporativos. Formou mais de 50 profissionais em Portugal no ecossistema Microsoft .NET.
                    </p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="https://www.linkedin.com/in/carlos-renato-freire-89349a21/" target="_blank" class="btn-md-ghost" style="border:1px solid var(--md-border);">
                            <i class="bi bi-linkedin"></i> LinkedIn
                        </a>
                        <a href="https://www.youtube.com/@carlosrenatofreire6219" target="_blank" class="btn-md-ghost" style="border:1px solid var(--md-border);">
                            <i class="bi bi-youtube"></i> YouTube
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Missão, Visão, Valores -->
<section style="padding:0 0 64px;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 style="font-size:32px; font-weight:900; margin-bottom:12px;">O que nos move</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="value-card">
                    <div class="value-icon"><i class="bi bi-bullseye"></i></div>
                    <h5 style="font-weight:700; margin-bottom:10px;">Missão</h5>
                    <p style="font-size:14px; color:var(--md-text-secondary); margin:0; line-height:1.7;">
                        Formar profissionais capazes de transformar processos caóticos em sistemas
                        tecnológicos de alto valor, com autonomia para liderar tecnicamente.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div class="value-icon"><i class="bi bi-eye"></i></div>
                    <h5 style="font-weight:700; margin-bottom:10px;">Visão</h5>
                    <p style="font-size:14px; color:var(--md-text-secondary); margin:0; line-height:1.7;">
                        Ser a principal referência em formação de arquitetos de software .NET
                        no Brasil, reconhecida pela qualidade e aplicabilidade do ensino.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div class="value-icon"><i class="bi bi-gem"></i></div>
                    <h5 style="font-weight:700; margin-bottom:10px;">Valores</h5>
                    <p style="font-size:14px; color:var(--md-text-secondary); margin:0; line-height:1.7;">
                        Excelência técnica, cenários reais, decisões justificadas e
                        compromisso com o crescimento profissional genuíno de cada aluno.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Trajectória -->
<section style="padding:0 0 80px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <h2 style="font-size:28px; font-weight:900; margin-bottom:40px;">Trajetória</h2>
                <div class="timeline-item">
                    <div class="timeline-dot"><i class="bi bi-code-slash"></i></div>
                    <div>
                        <p style="font-size:12px; color:var(--md-accent); font-weight:700; margin-bottom:4px;">2000 — Início</p>
                        <p style="font-weight:700; margin-bottom:6px; color:var(--md-text-primary);">Início na Área de Software</p>
                        <p style="font-size:14px; color:var(--md-text-secondary); margin:0;">Começo da carreira em desenvolvimento de software, com foco no ecossistema Microsoft.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-dot"><i class="bi bi-award"></i></div>
                    <div>
                        <p style="font-size:12px; color:var(--md-accent); font-weight:700; margin-bottom:4px;">2010 — Certificação</p>
                        <p style="font-weight:700; margin-bottom:6px; color:var(--md-text-primary);">MCSD — Microsoft Certified Solutions Developer</p>
                        <p style="font-size:14px; color:var(--md-text-secondary); margin:0;">Certificação de elite no ecossistema Microsoft, consolidando a autoridade técnica em .NET.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-dot"><i class="bi bi-people"></i></div>
                    <div>
                        <p style="font-size:12px; color:var(--md-accent); font-weight:700; margin-bottom:4px;">2018 — Formação</p>
                        <p style="font-weight:700; margin-bottom:6px; color:var(--md-text-primary);">Início da Atividade de Formação</p>
                        <p style="font-size:14px; color:var(--md-text-secondary); margin:0;">Primeiras formações internas em empresas portuguesas, com +50 profissionais formados em .NET.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-dot"><i class="bi bi-rocket-takeoff"></i></div>
                    <div>
                        <p style="font-size:12px; color:var(--md-accent); font-weight:700; margin-bottom:4px;">2026 — MundoDev</p>
                        <p style="font-weight:700; margin-bottom:6px; color:var(--md-text-primary);">Lançamento da Plataforma</p>
                        <p style="font-size:14px; color:var(--md-text-secondary); margin:0;">Criação da MundoDev para levar a metodologia corporativa a programadores de todo o Brasil.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section style="background:var(--md-bg-secondary); padding:64px 0; border-top:1px solid var(--md-border);">
    <div class="container text-center">
        <h2 style="font-size:30px; font-weight:900; margin-bottom:12px;">Faça parte da história</h2>
        <p style="color:var(--md-text-secondary); font-size:16px; max-width:460px; margin:0 auto 28px;">
            Junte-se à comunidade de profissionais que escolheram crescer com propósito.
        </p>
        <a asp-controller="Plans" asp-action="Index" class="btn-md-primary" style="font-size:16px; padding:13px 30px;">
            Ver Planos <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</section>
