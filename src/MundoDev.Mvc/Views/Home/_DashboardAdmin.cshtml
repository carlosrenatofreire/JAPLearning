<style>
    .welcome-banner {
        background: linear-gradient(135deg, rgba(232,80,26,0.12) 0%, rgba(160,31,58,0.06) 100%);
        border: 1px solid rgba(232,80,26,0.2);
        border-radius: var(--md-radius-lg);
        padding: 24px 28px;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }
    .kpi-card {
        background: var(--md-bg-card);
        border: 1px solid var(--md-border);
        border-radius: var(--md-radius);
        padding: 20px;
        transition: var(--md-transition);
    }
    .kpi-card:hover { border-color: rgba(232,80,26,0.3); }
    .kpi-value { font-size: 28px; font-weight: 800; color: var(--md-text-primary); }
    .kpi-label { font-size: 13px; color: var(--md-text-muted); margin-top: 4px; }
    .kpi-icon {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px;
        margin-bottom: 12px;
    }
    .activity-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--md-border-light);
        font-size: 14px;
    }
    .activity-row:last-child { border-bottom: none; }
</style>

@{
    var firstName = (User.Identity?.Name ?? "").Split(' ')[0];
}

<!-- Welcome -->
<div class="welcome-banner">
    <div>
        <h3 style="font-weight:800; margin-bottom:4px;">Olá, @firstName! 👋</h3>
        <p style="color:var(--md-text-secondary); margin:0; font-size:14px;">Bem-vindo ao painel de gestão MundoDev.</p>
    </div>
    <a asp-controller="Courses" asp-action="Create" class="btn-md-primary">
        <i class="bi bi-plus-lg"></i> Novo Curso
    </a>
</div>

<!-- KPIs -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(99,102,241,0.12); color:#818CF8;">
                <i class="bi bi-people"></i>
            </div>
            <div class="kpi-value">—</div>
            <div class="kpi-label">Utilizadores</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(34,197,94,0.12); color:var(--md-success);">
                <i class="bi bi-collection-play"></i>
            </div>
            <div class="kpi-value">—</div>
            <div class="kpi-label">Cursos Activos</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(245,158,11,0.12); color:var(--md-warning);">
                <i class="bi bi-bag-check"></i>
            </div>
            <div class="kpi-value">—</div>
            <div class="kpi-label">Pedidos</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(232,80,26,0.12); color:var(--md-accent);">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="kpi-value">—</div>
            <div class="kpi-label">Receita Total</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Quick Actions -->
    <div class="col-lg-6">
        <h5 style="font-weight:700; margin-bottom:16px;">Acesso Rápido</h5>
        <div class="row g-2">
            <div class="col-6">
                <a asp-controller="Users" asp-action="Create" class="md-card-sm d-flex align-items-center gap-3 text-decoration-none" style="color:var(--md-text-primary);">
                    <div class="kpi-icon mb-0" style="background:rgba(99,102,241,0.12); color:#818CF8; flex-shrink:0;">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <span style="font-size:14px; font-weight:600;">Novo Utilizador</span>
                </a>
            </div>
            <div class="col-6">
                <a asp-controller="Courses" asp-action="Create" class="md-card-sm d-flex align-items-center gap-3 text-decoration-none" style="color:var(--md-text-primary);">
                    <div class="kpi-icon mb-0" style="background:rgba(34,197,94,0.12); color:var(--md-success); flex-shrink:0;">
                        <i class="bi bi-collection-play"></i>
                    </div>
                    <span style="font-size:14px; font-weight:600;">Novo Curso</span>
                </a>
            </div>
            <div class="col-6">
                <a asp-controller="Articles" asp-action="Create" class="md-card-sm d-flex align-items-center gap-3 text-decoration-none" style="color:var(--md-text-primary);">
                    <div class="kpi-icon mb-0" style="background:rgba(245,158,11,0.12); color:var(--md-warning); flex-shrink:0;">
                        <i class="bi bi-file-earmark-plus"></i>
                    </div>
                    <span style="font-size:14px; font-weight:600;">Novo Artigo</span>
                </a>
            </div>
            <div class="col-6">
                <a asp-controller="Plans" asp-action="Create" class="md-card-sm d-flex align-items-center gap-3 text-decoration-none" style="color:var(--md-text-primary);">
                    <div class="kpi-icon mb-0" style="background:rgba(232,80,26,0.12); color:var(--md-accent); flex-shrink:0;">
                        <i class="bi bi-patch-check"></i>
                    </div>
                    <span style="font-size:14px; font-weight:600;">Novo Plano</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Modules Summary -->
    <div class="col-lg-6">
        <h5 style="font-weight:700; margin-bottom:16px;">Módulos do Sistema</h5>
        <div class="md-card" style="padding:16px;">
            @{
                var modules = new[] {
                    ("Utilizadores", "bi-people", "users"),
                    ("Cursos", "bi-collection-play", "courses"),
                    ("Artigos", "bi-file-earmark-text", "articles"),
                    ("Planos", "bi-patch-check", "plans"),
                    ("Pedidos", "bi-bag-check", "orders"),
                };
            }
            @foreach (var (name, icon, ctrl) in modules)
            {
                <div class="activity-row">
                    <i class="bi @icon" style="color:var(--md-accent); font-size:16px; flex-shrink:0;"></i>
                    <span style="flex:1; color:var(--md-text-secondary);">@name</span>
                    <a asp-controller="@(char.ToUpper(ctrl[0]) + ctrl.Substring(1))" asp-action="Index" class="btn-md-ghost" style="padding:4px 10px; font-size:12px;">
                        Ver <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
