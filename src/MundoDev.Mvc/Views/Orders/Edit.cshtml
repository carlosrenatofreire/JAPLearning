@model MundoDev.Mvc.ViewModels.Entities.OrderViewModel
@{
    ViewData["Title"] = "Editar Pedido";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Pedido</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Pedidos</a> / Editar</p>
    </div>
</div>

<div class="md-card" style="max-width:700px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="md-label">Utilizador</label>
                <select asp-for="UserId" asp-items="ViewBag.Users" class="md-input"></select>
            </div>
            <div class="col-md-6">
                <label class="md-label">Plano</label>
                <select asp-for="PlanId" asp-items="ViewBag.Plans" class="md-input"></select>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="md-label">Início da Licença</label>
                <input asp-for="StartLicense" type="date" class="md-input" />
            </div>
            <div class="col-md-6">
                <label class="md-label">Fim da Licença</label>
                <input asp-for="EndLicense" type="date" class="md-input" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="md-label">Valor (€)</label>
                <input asp-for="Value" type="number" step="0.01" class="md-input" min="0" />
            </div>
            <div class="col-md-4">
                <label class="md-label">Desconto (€)</label>
                <input asp-for="Discount" type="number" step="0.01" class="md-input" min="0" />
            </div>
            <div class="col-md-4">
                <label class="md-label">Estado</label>
                <select asp-for="StatusId" asp-items="ViewBag.Statuses" class="md-input"></select>
            </div>
        </div>

        <div class="mb-4">
            <label class="md-form-check">
                <input asp-for="IsActived" type="checkbox" />
                <span>Activo</span>
            </label>
        </div>

        <div style="display:flex; gap:12px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-secondary">Cancelar</a>
        </div>
    </form>
</div>
