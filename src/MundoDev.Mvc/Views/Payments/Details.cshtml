@model MundoDev.Mvc.ViewModels.Entities.PaymentViewModel
@{
    ViewData["Title"] = "Detalhes do Pagamento";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Detalhes do Pagamento</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Pagamentos</a> / Detalhes</p>
    </div>
</div>

<div class="md-card" style="max-width:600px;">
    <dl style="display:grid; grid-template-columns:180px 1fr; gap:16px 12px; margin:0;">
        <dt style="color:var(--md-text-muted); font-size:13px;">Utilizador</dt>
        <dd style="color:var(--md-text-primary); font-weight:600; margin:0;">@Model.UserFullName</dd>

        <dt style="color:var(--md-text-muted); font-size:13px;">ID do Pedido</dt>
        <dd style="font-family:monospace; font-size:13px; margin:0;">@Model.OrderId</dd>

        <dt style="color:var(--md-text-muted); font-size:13px;">Tipo de Pagamento</dt>
        <dd style="margin:0;">
            @switch (Model.PaymentType)
            {
                case MundoDev.Business.Models.Enums.PaymentType.CreditCard:
                    <span class="md-badge md-badge-info">Cartão de Crédito</span>
                    break;
                case MundoDev.Business.Models.Enums.PaymentType.BankTransfer:
                    <span class="md-badge md-badge-success">Transferência Bancária</span>
                    break;
                case MundoDev.Business.Models.Enums.PaymentType.MbWay:
                    <span class="md-badge md-badge-warning">MBWay</span>
                    break;
                default:
                    <span class="md-badge">@Model.PaymentType</span>
                    break;
            }
        </dd>

        <dt style="color:var(--md-text-muted); font-size:13px;">Gateway</dt>
        <dd style="margin:0;">@(Model.Gateway ?? "—")</dd>

        <dt style="color:var(--md-text-muted); font-size:13px;">ID de Transacção</dt>
        <dd style="font-family:monospace; font-size:13px; margin:0;">@(Model.TransactionId ?? "—")</dd>

        <dt style="color:var(--md-text-muted); font-size:13px;">Data de Pagamento</dt>
        <dd style="margin:0;">@Model.PaidDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>
    </dl>

    <div style="margin-top:24px; padding-top:20px; border-top:1px solid var(--md-border);">
        <a asp-action="Index" class="btn-md-secondary"><i class="bi bi-arrow-left"></i> Voltar</a>
    </div>
</div>
