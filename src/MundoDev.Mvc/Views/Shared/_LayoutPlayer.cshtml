<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MundoDev</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mundodev.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body { margin: 0; overflow: hidden; height: 100vh; }

        /* ── Player Shell ───────────────────────────────────── */
        .player-shell {
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        /* ── Top bar ────────────────────────────────────────── */
        .player-topbar {
            height: 52px;
            background: var(--md-bg-navbar);
            border-bottom: 1px solid var(--md-border);
            display: flex;
            align-items: center;
            padding: 0 20px;
            gap: 16px;
            flex-shrink: 0;
            z-index: 100;
        }
        .player-topbar-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }
        .player-topbar-brand .brand-icon {
            width: 26px; height: 26px;
            background: var(--md-gradient);
            border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 11px; color: #fff;
        }
        .player-topbar-brand .brand-name {
            font-size: 15px; font-weight: 800;
            color: var(--md-text-primary);
        }
        .player-topbar-brand .brand-name span { color: var(--md-accent); }
        .player-topbar-sep {
            width: 1px; height: 20px;
            background: var(--md-border);
        }
        .player-topbar-course {
            font-size: 13px;
            font-weight: 600;
            color: var(--md-text-secondary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex: 1;
        }
        .player-topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-left: auto;
            flex-shrink: 0;
        }

        /* ── Body ───────────────────────────────────────────── */
        .player-body {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        /* ── Sidebar ────────────────────────────────────────── */
        .player-sidebar {
            width: var(--md-sidebar-width, 280px);
            background: var(--md-bg-sidebar);
            border-right: 1px solid var(--md-border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            flex-shrink: 0;
        }
        .player-sidebar-header {
            padding: 14px 16px;
            border-bottom: 1px solid var(--md-border);
            flex-shrink: 0;
        }
        .player-progress-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--md-text-muted);
            margin-bottom: 8px;
        }
        .player-progress-pct { color: var(--md-success); font-weight: 800; font-size: 13px; }
        .player-sidebar-nav { overflow-y: auto; flex: 1; padding: 8px 0; }

        /* Module group */
        .player-module { margin-bottom: 2px; }
        .player-module-header {
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.09em;
            color: var(--md-text-muted);
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            user-select: none;
            transition: var(--md-transition);
        }
        .player-module-header:hover { color: var(--md-text-secondary); }
        .player-module-header i { font-size: 12px; transition: transform 0.2s; }
        .player-module-header.collapsed i { transform: rotate(-90deg); }

        /* Lesson item */
        .player-lesson {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 9px 16px 9px 20px;
            cursor: pointer;
            transition: var(--md-transition);
            text-decoration: none;
        }
        .player-lesson:hover { background: rgba(255,255,255,0.03); }
        .player-lesson.active { background: rgba(232,80,26,0.08); }
        .player-lesson-icon {
            width: 18px; height: 18px;
            border-radius: 50%;
            border: 2px solid var(--md-border);
            display: flex; align-items: center; justify-content: center;
            font-size: 9px;
            flex-shrink: 0;
            margin-top: 1px;
            transition: var(--md-transition);
        }
        .player-lesson.completed .player-lesson-icon {
            background: var(--md-success);
            border-color: var(--md-success);
            color: #fff;
        }
        .player-lesson.active .player-lesson-icon {
            border-color: var(--md-accent);
            background: rgba(232,80,26,0.15);
            color: var(--md-accent);
        }
        .player-lesson-info { flex: 1; min-width: 0; }
        .player-lesson-title {
            font-size: 13px;
            font-weight: 500;
            color: var(--md-text-secondary);
            line-height: 1.4;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0;
        }
        .player-lesson.active .player-lesson-title { color: var(--md-accent); font-weight: 600; }
        .player-lesson.completed .player-lesson-title { color: var(--md-text-muted); }
        .player-lesson-duration {
            font-size: 11px;
            color: var(--md-text-muted);
            margin: 2px 0 0;
        }

        /* ── Main Content ───────────────────────────────────── */
        .player-main {
            flex: 1;
            overflow-y: auto;
            background: var(--md-bg-primary);
        }
        .player-content { max-width: 900px; margin: 0 auto; padding: 28px 32px; }

        .player-breadcrumb {
            font-size: 12px;
            color: var(--md-text-muted);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }
        .player-breadcrumb a { color: var(--md-text-muted); text-decoration: none; }
        .player-breadcrumb a:hover { color: var(--md-accent); }

        .player-lesson-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            gap: 16px;
            flex-wrap: wrap;
        }

        /* ── Video container ────────────────────────────────── */
        .player-video-wrap {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%;
            background: #000;
            border-radius: var(--md-radius-lg);
            overflow: hidden;
            margin-bottom: 28px;
        }
        .player-video-wrap iframe {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            border: none;
        }
        .player-video-placeholder {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--md-text-muted);
            font-size: 14px;
            gap: 12px;
        }

        /* ── Resources ──────────────────────────────────────── */
        .player-resources { margin-top: 8px; }
        .player-resources-title { font-size: 16px; font-weight: 700; margin-bottom: 6px; }
        .player-resources-desc { font-size: 14px; color: var(--md-text-secondary); margin-bottom: 16px; }

        /* ── Sidebar toggle for mobile ──────────────────────── */
        .player-sidebar-toggle {
            display: none;
            background: none;
            border: 1px solid var(--md-border);
            border-radius: var(--md-radius-sm);
            padding: 5px 10px;
            color: var(--md-text-secondary);
            cursor: pointer;
        }
        @@media (max-width: 768px) {
            .player-sidebar { position: fixed; top: 52px; left: 0; bottom: 0; z-index: 200; transform: translateX(-100%); transition: transform 0.3s; }
            .player-sidebar.open { transform: translateX(0); }
            .player-sidebar-toggle { display: flex; align-items: center; gap: 6px; }
            .player-content { padding: 20px 16px; }
        }
    </style>
</head>
<body>
    <div class="player-shell">

        <!-- ── Top Bar ──────────────────────────────────────── -->
        <div class="player-topbar">
            <button class="player-sidebar-toggle" onclick="togglePlayerSidebar()">
                <i class="bi bi-list"></i> Aulas
            </button>
            <a class="player-topbar-brand" asp-controller="Student" asp-action="Dashboard">
                <div class="brand-icon">&lt;/&gt;</div>
                <span class="brand-name">Mundo<span>Dev</span></span>
            </a>
            <div class="player-topbar-sep"></div>
            <span class="player-topbar-course">@ViewData["CourseName"]</span>
            <div class="player-topbar-right">
                @{
                    var fullName = User.Identity?.Name ?? "";
                    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                        .Take(2).Select(w => w[0].ToString().ToUpper()));
                }
                <a asp-controller="Student" asp-action="Dashboard"
                   style="font-size:12px; color:var(--md-text-muted); text-decoration:none;">
                    <i class="bi bi-arrow-left-circle"></i> Voltar
                </a>
                <div class="md-avatar" style="width:32px;height:32px;font-size:13px;">@initials</div>
            </div>
        </div>

        <!-- ── Body ─────────────────────────────────────────── -->
        <div class="player-body">

            <!-- Sidebar -->
            <aside class="player-sidebar" id="playerSidebar">
                <div class="player-sidebar-header">
                    <div class="player-progress-label">
                        <span>Seu progresso</span>
                        <span class="player-progress-pct">@(ViewData["Progress"] ?? "0")%</span>
                    </div>
                    <div class="md-progress">
                        <div class="md-progress-bar" style="width:@(ViewData["Progress"] ?? "0")%"></div>
                    </div>
                </div>
                <div class="player-sidebar-nav">
                    @await RenderSectionAsync("PlayerNav", required: false)
                </div>
            </aside>

            <!-- Main -->
            <main class="player-main">
                <div class="player-content">
                    @RenderBody()
                </div>
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function togglePlayerSidebar() {
            document.getElementById('playerSidebar').classList.toggle('open');
        }
        // Collapse/expand modules
        document.querySelectorAll('.player-module-header').forEach(h => {
            h.addEventListener('click', () => {
                h.classList.toggle('collapsed');
                const body = h.nextElementSibling;
                if (body) body.style.display = h.classList.contains('collapsed') ? 'none' : 'block';
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
