@model MundoDev.Mvc.ViewModels.Entities.QuestionOptionViewModel
@{
    ViewData["Title"] = "Nova Opção";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Nova Opção de Resposta</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Opções</a> / Criar</p>
    </div>
</div>

<div class="md-card" style="max-width:600px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="mb-3">
            <label class="md-label">Questão <span class="text-danger">*</span></label>
            <select asp-for="QuestionId" asp-items="ViewBag.Questions" class="md-input">
                <option value="">— Seleccionar —</option>
            </select>
            <span asp-validation-for="QuestionId" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label class="md-label">Texto da Opção <span class="text-danger">*</span></label>
            <input asp-for="Name" class="md-input" placeholder="ex: A opção A é..." />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label class="md-label">Descrição / Explicação</label>
            <textarea asp-for="Description" class="md-input" rows="2" placeholder="Explicação (mostrada após resposta)"></textarea>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-auto">
                <label class="md-form-check">
                    <input asp-for="IsCorrect" type="checkbox" />
                    <span style="color:#4caf82;"><i class="bi bi-check-circle"></i> Resposta correcta</span>
                </label>
            </div>
            <div class="col-auto">
                <label class="md-form-check">
                    <input asp-for="IsActived" type="checkbox" />
                    <span>Activa</span>
                </label>
            </div>
        </div>

        <div style="display:flex; gap:12px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-secondary">Cancelar</a>
        </div>
    </form>
</div>
