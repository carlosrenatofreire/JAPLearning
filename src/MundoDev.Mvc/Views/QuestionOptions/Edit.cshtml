@model MundoDev.Mvc.ViewModels.Entities.QuestionOptionViewModel
@{
    ViewData["Title"] = "Editar Opção";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Opção de Resposta</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Opções</a> / Editar</p>
    </div>
</div>

<div class="md-card" style="max-width:600px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="mb-3">
            <label class="md-label">Questão</label>
            <select asp-for="QuestionId" asp-items="ViewBag.Questions" class="md-input"></select>
        </div>

        <div class="mb-3">
            <label class="md-label">Texto da Opção <span class="text-danger">*</span></label>
            <input asp-for="Name" class="md-input" />
        </div>

        <div class="mb-3">
            <label class="md-label">Descrição / Explicação</label>
            <textarea asp-for="Description" class="md-input" rows="2"></textarea>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-auto">
                <label class="md-form-check">
                    <input asp-for="IsCorrect" type="checkbox" />
                    <span style="color:#4caf82;"><i class="bi bi-check-circle"></i> Resposta correcta</span>
                </label>
            </div>
            <div class="col-auto">
                <label class="md-form-check">
                    <input asp-for="IsActived" type="checkbox" />
                    <span>Activa</span>
                </label>
            </div>
        </div>

        <div style="display:flex; gap:12px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-secondary">Cancelar</a>
        </div>
    </form>
</div>
