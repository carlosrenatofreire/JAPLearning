@{
    ViewData["Title"] = "Ranking de Equipas";
    var teams = ViewBag.Teams as List<dynamic> ?? new List<dynamic>();
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Ranking de Equipas</h4>
        <p class="page-header-sub">
            <a asp-controller="Home" asp-action="Index" style="color:var(--md-text-muted);">Dashboard</a>
            <i class="bi bi-chevron-right" style="font-size:10px;"></i> Equipas
        </p>
    </div>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">
    @if (!teams.Any())
    {
        <div style="text-align:center; padding:60px; color:var(--md-text-muted);">
            <i class="bi bi-people-fill" style="font-size:40px; display:block; margin-bottom:12px;"></i>
            <p style="margin:0;">Sem dados ainda.</p>
        </div>
    }
    else
    {
        <table class="crud-table" style="margin:0;">
            <thead>
                <tr>
                    <th style="width:42px; text-align:center;">#</th>
                    <th>Equipa</th>
                    <th style="width:110px; text-align:center;">Membros</th>
                    <th style="width:150px; text-align:center;">Aulas Concluídas</th>
                    <th style="width:130px; text-align:center;">Média / Membro</th>
                    <th style="width:110px; text-align:center;">Certificados</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < teams.Count; i++)
                {
                    var t       = teams[i];
                    var name    = (string)t.Name;
                    var members = (int)t.Members;
                    var lessons = (int)t.Lessons;
                    var avg     = (double)t.Average;
                    var certs   = (int)t.Certs;
                    var abbr    = string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0].ToString().ToUpper()));
                    var medal   = i == 0 ? "#F59E0B" : i == 1 ? "#9CA3AF" : i == 2 ? "#D97706" : "var(--md-text-muted)";
                    <tr>
                        <td style="text-align:center; font-weight:700; font-size:13px; color:@medal;">@(i + 1)</td>
                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#6366F1,#8B5CF6);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0;">@abbr</div>
                                <span style="font-weight:600; font-size:14px;">@name</span>
                            </div>
                        </td>
                        <td style="text-align:center; font-size:13px; color:var(--md-text-secondary);">@members</td>
                        <td style="text-align:center;">
                            @if (lessons > 0)
                            {
                                <span style="font-weight:700; font-size:13px; color:#818CF8;">@lessons</span>
                            }
                            else
                            {
                                <span style="color:var(--md-text-muted); font-size:12px;">—</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            @if (avg > 0)
                            {
                                <span style="font-size:13px; color:var(--md-text-secondary);">@avg.ToString("0.0")</span>
                            }
                            else
                            {
                                <span style="color:var(--md-text-muted); font-size:12px;">—</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            @if (certs > 0)
                            {
                                <span style="font-weight:700; font-size:13px; color:var(--md-warning);">
                                    <i class="bi bi-patch-check-fill" style="margin-right:3px;"></i>@certs
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--md-text-muted); font-size:12px;">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
