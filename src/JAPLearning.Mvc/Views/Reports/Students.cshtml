@{
    ViewData["Title"] = "Ranking de Alunos";
    var students = ViewBag.Students as List<dynamic> ?? new List<dynamic>();
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Ranking de Alunos</h4>
        <p class="page-header-sub">
            <a asp-controller="Home" asp-action="Index" style="color:var(--md-text-muted);">Dashboard</a>
            <i class="bi bi-chevron-right" style="font-size:10px;"></i> Alunos
        </p>
    </div>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">
    @if (!students.Any())
    {
        <div style="text-align:center; padding:60px; color:var(--md-text-muted);">
            <i class="bi bi-people" style="font-size:40px; display:block; margin-bottom:12px;"></i>
            <p style="margin:0;">Sem dados de progresso ainda.</p>
        </div>
    }
    else
    {
        <table class="crud-table" style="margin:0;">
            <thead>
                <tr>
                    <th style="width:42px; text-align:center;">#</th>
                    <th>Aluno</th>
                    <th>Email</th>
                    <th>Equipa</th>
                    <th style="width:130px; text-align:center;">Aulas Concluídas</th>
                    <th style="width:120px; text-align:center;">Horas Assistidas</th>
                    <th style="width:110px; text-align:center;">Certificados</th>
                    <th style="width:60px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < students.Count; i++)
                {
                    var s     = students[i];
                    var name  = (string)s.Name;
                    var email = (string)s.Email;
                    var team  = (string)s.TeamName;
                    var photo = s.Photo as string;
                    var less       = (int)s.Lessons;
                    var certs      = (int)s.Certs;
                    var hoursLabel = (string)s.HoursLabel;
                    var abbr  = string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0].ToString().ToUpper()));
                    var medal = i == 0 ? "#F59E0B" : i == 1 ? "#9CA3AF" : i == 2 ? "#D97706" : "var(--md-text-muted)";
                    <tr>
                        <td style="text-align:center; font-weight:700; font-size:13px; color:@medal;">@(i + 1)</td>
                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                @if (!string.IsNullOrWhiteSpace(photo))
                                {
                                    <img src="@photo" style="width:32px;height:32px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                                }
                                else
                                {
                                    <div style="width:32px;height:32px;border-radius:50%;background:var(--md-gradient);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0;">@abbr</div>
                                }
                                <span style="font-weight:600; font-size:14px;">@name</span>
                            </div>
                        </td>
                        <td style="font-size:13px; color:var(--md-text-muted);">@email</td>
                        <td style="font-size:13px; color:var(--md-text-secondary);">@team</td>
                        <td style="text-align:center;">
                            @if (less > 0)
                            {
                                <span style="font-weight:700; font-size:13px; color:var(--md-accent);">@less</span>
                            }
                            else
                            {
                                <span style="color:var(--md-text-muted); font-size:12px;">—</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            @if (hoursLabel != "—")
                            {
                                <span style="font-weight:600; font-size:13px; color:var(--md-text-secondary);">
                                    <i class="bi bi-clock-history" style="margin-right:3px; font-size:11px;"></i>@hoursLabel
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--md-text-muted); font-size:12px;">—</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            @if (certs > 0)
                            {
                                <span style="font-weight:700; font-size:13px; color:var(--md-warning);">
                                    <i class="bi bi-patch-check-fill" style="margin-right:3px;"></i>@certs
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--md-text-muted); font-size:12px;">—</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <a asp-action="StudentDetail" asp-route-id="@s.Id"
                               class="action-btn" title="Ver detalhes do aluno">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
