@model JAPLearning.Mvc.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Alterar Senha";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<div style="text-align:center; margin-bottom:28px;">
    <div style="width:56px;height:56px;background:linear-gradient(135deg,rgba(232,80,26,0.15),rgba(200,55,42,0.08));border:1px solid rgba(232,80,26,0.3);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
        <i class="bi bi-shield-lock-fill" style="font-size:24px;color:var(--md-accent);"></i>
    </div>
    <h2 class="auth-form-title" style="margin-bottom:6px;">Primeiro Acesso</h2>
    <p class="auth-form-subtitle" style="margin-bottom:0;">
        Por segurança, defina uma nova senha antes de continuar.
    </p>
</div>

<div style="background:rgba(232,80,26,0.06);border:1px solid rgba(232,80,26,0.2);border-radius:var(--md-radius);padding:12px 16px;margin-bottom:24px;display:flex;align-items:flex-start;gap:10px;">
    <i class="bi bi-info-circle-fill" style="color:var(--md-accent);font-size:15px;flex-shrink:0;margin-top:1px;"></i>
    <p style="font-size:13px;color:var(--md-text-secondary);margin:0;line-height:1.6;">
        A sua conta foi criada com uma senha temporária. Introduza a senha recebida e escolha uma nova senha pessoal.
    </p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="md-alert md-alert-danger mb-4" style="display:flex;align-items:flex-start;gap:10px;">
        <i class="bi bi-exclamation-triangle-fill" style="flex-shrink:0;margin-top:2px;"></i>
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<form asp-action="ChangePassword" method="post">
    @Html.AntiForgeryToken()

    <div class="md-form-group">
        <label asp-for="CurrentPassword" class="md-label"></label>
        <div style="position:relative;">
            <input asp-for="CurrentPassword" class="md-input" placeholder="Senha temporária recebida"
                   autocomplete="current-password" id="cp-current" style="padding-right:44px;" />
            <button type="button" onclick="togglePwd('cp-current', this)"
                    style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--md-text-muted);cursor:pointer;font-size:16px;padding:0;">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size:12px;"></span>
    </div>

    <div class="md-form-group">
        <label asp-for="NewPassword" class="md-label"></label>
        <div style="position:relative;">
            <input asp-for="NewPassword" class="md-input" placeholder="Mínimo 6 caracteres"
                   autocomplete="new-password" id="cp-new" style="padding-right:44px;" />
            <button type="button" onclick="togglePwd('cp-new', this)"
                    style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--md-text-muted);cursor:pointer;font-size:16px;padding:0;">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger" style="font-size:12px;"></span>
    </div>

    <div class="md-form-group">
        <label asp-for="ConfirmPassword" class="md-label"></label>
        <div style="position:relative;">
            <input asp-for="ConfirmPassword" class="md-input" placeholder="Repita a nova senha"
                   autocomplete="new-password" id="cp-confirm" style="padding-right:44px;" />
            <button type="button" onclick="togglePwd('cp-confirm', this)"
                    style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--md-text-muted);cursor:pointer;font-size:16px;padding:0;">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
    </div>

    <!-- Indicador de força da senha -->
    <div style="margin-bottom:24px;">
        <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--md-text-muted);margin-bottom:6px;">
            <span>Força da senha</span>
            <span id="pwd-strength-label">—</span>
        </div>
        <div style="background:rgba(255,255,255,0.06);border-radius:4px;height:4px;overflow:hidden;">
            <div id="pwd-strength-bar" style="height:100%;border-radius:4px;width:0%;transition:width .3s,background .3s;"></div>
        </div>
    </div>

    <button type="submit" class="btn-md-primary w-100" style="justify-content:center;padding:13px;">
        <i class="bi bi-shield-check"></i> Definir Nova Senha
    </button>
</form>

@section Scripts {
<script>
    function togglePwd(id, btn) {
        const input = document.getElementById(id);
        const icon  = btn.querySelector('i');
        if (input.type === 'password') { input.type = 'text'; icon.className = 'bi bi-eye-slash'; }
        else                           { input.type = 'password'; icon.className = 'bi bi-eye'; }
    }

    // Indicador de força
    document.getElementById('cp-new').addEventListener('input', function () {
        const val   = this.value;
        const bar   = document.getElementById('pwd-strength-bar');
        const label = document.getElementById('pwd-strength-label');
        let score   = 0;
        if (val.length >= 6)  score++;
        if (val.length >= 10) score++;
        if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
        if (/\d/.test(val))   score++;
        if (/[^a-zA-Z0-9]/.test(val)) score++;

        const levels = [
            { w: '0%',   bg: 'transparent',  lbl: '—' },
            { w: '25%',  bg: '#ef4444',       lbl: 'Fraca' },
            { w: '50%',  bg: '#f59e0b',       lbl: 'Razoável' },
            { w: '75%',  bg: '#60a5fa',       lbl: 'Boa' },
            { w: '100%', bg: '#22c55e',       lbl: 'Forte' },
        ];
        const lvl = val.length === 0 ? levels[0] : levels[Math.min(score, 4)];
        bar.style.width      = lvl.w;
        bar.style.background = lvl.bg;
        label.textContent    = lvl.lbl;
        label.style.color    = lvl.bg === 'transparent' ? 'var(--md-text-muted)' : lvl.bg;
    });
</script>
}
