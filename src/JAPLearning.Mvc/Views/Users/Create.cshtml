@model JAPLearning.Mvc.ViewModels.Entities.UserViewModel
@{
    ViewData["Title"] = "Novo Utilizador";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Novo Utilizador</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-text-muted);">Utilizadores</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> Novo</p>
    </div>
</div>

<div class="md-card" style="max-width:720px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="FirstName" class="md-label"></label>
                    <input asp-for="FirstName" class="md-input" placeholder="Nome" />
                    <span asp-validation-for="FirstName" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="LastName" class="md-label"></label>
                    <input asp-for="LastName" class="md-input" placeholder="Apelido" />
                    <span asp-validation-for="LastName" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-8">
                <div class="md-form-row">
                    <label asp-for="Email" class="md-label"></label>
                    <input asp-for="Email" class="md-input" placeholder="email@exemplo.com" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="md-form-row">
                    <label asp-for="RoleId" class="md-label"></label>
                    <select asp-for="RoleId" asp-items="ViewBag.Roles" class="md-select">
                        <option value="">Seleccionar...</option>
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="Password" class="md-label"></label>
                    <input asp-for="Password" class="md-input" placeholder="Mínimo 6 caracteres" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="ConfirmPassword" class="md-label"></label>
                    <input asp-for="ConfirmPassword" class="md-input" placeholder="Repetir senha" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="PhoneNumber" class="md-label"></label>
                    <input asp-for="PhoneNumber" class="md-input" placeholder="+351 912 345 678" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="City" class="md-label"></label>
                    <input asp-for="City" class="md-input" placeholder="Cidade" />
                </div>
            </div>
            <div class="col-12">
                <div class="md-form-row mb-0">
                    <div class="md-form-check">
                        <input asp-for="IsActived" type="checkbox" />
                        <label asp-for="IsActived">Activo</label>
                    </div>
                </div>
            </div>
        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>
