@model JAPLearning.Mvc.ViewModels.Entities.UserViewModel
@{
    ViewData["Title"] = "Editar Utilizador";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Utilizador</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-text-muted);">Utilizadores</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> Editar</p>
    </div>
</div>

<div class="md-card" style="max-width:720px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="FirstName" class="md-label"></label>
                    <input asp-for="FirstName" class="md-input" />
                    <span asp-validation-for="FirstName" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="LastName" class="md-label"></label>
                    <input asp-for="LastName" class="md-input" />
                    <span asp-validation-for="LastName" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-8">
                <div class="md-form-row">
                    <label asp-for="Email" class="md-label"></label>
                    <input asp-for="Email" class="md-input" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="md-form-row">
                    <label asp-for="RoleId" class="md-label"></label>
                    <select asp-for="RoleId" asp-items="ViewBag.Roles" class="md-select">
                        <option value="">Seleccionar...</option>
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="md-form-row">
                    <label asp-for="TeamId" class="md-label"></label>
                    <select asp-for="TeamId" asp-items="ViewBag.Teams" class="md-select">
                        <option value="">Seleccionar...</option>
                    </select>
                    <span asp-validation-for="TeamId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="Password" class="md-label"></label>
                    <input asp-for="Password" class="md-input" placeholder="Deixar em branco para não alterar" />
                    <p style="font-size:12px; color:var(--md-text-muted); margin-top:4px;">Deixe em branco para manter a senha actual.</p>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="ConfirmPassword" class="md-label"></label>
                    <input asp-for="ConfirmPassword" class="md-input" placeholder="Deixar em branco para não alterar" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="PhoneNumber" class="md-label"></label>
                    <input asp-for="PhoneNumber" class="md-input" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="City" class="md-label"></label>
                    <input asp-for="City" class="md-input" />
                </div>
            </div>
            <div class="col-12">
                <div class="md-form-row">
                    <label class="md-label">Foto de Perfil</label>
                    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
                        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
                        {
                            <img src="@Model.PhotoUrl" alt="Foto actual"
                                 style="width:64px;height:64px;border-radius:50%;object-fit:cover;border:2px solid var(--md-border);flex-shrink:0;" />
                        }
                        else
                        {
                            <div style="width:64px;height:64px;border-radius:50%;background:var(--md-border);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-person" style="font-size:24px;color:var(--md-text-muted);"></i>
                            </div>
                        }
                        <div style="flex:1;">
                            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="md-input" style="padding:6px;" />
                            <small style="color:var(--md-text-muted);font-size:11px;">JPG, PNG ou WebP — envie nova para substituir</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="md-form-row mb-0">
                    <div class="md-form-check">
                        <input asp-for="IsActived" type="checkbox" />
                        <label asp-for="IsActived">Activo</label>
                    </div>
                </div>
            </div>
        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>
