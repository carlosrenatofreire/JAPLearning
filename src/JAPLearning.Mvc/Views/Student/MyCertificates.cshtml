@model List<JAPLearning.Mvc.ViewModels.Entities.CertificateViewModel>
@{
    ViewData["Title"]      = "Meus Certificados";
    ViewData["ActiveMenu"] = "certificates";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<style>
    .cert-card {
        background: var(--md-bg-card);
        border: 1px solid var(--md-border);
        border-radius: var(--md-radius);
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 12px;
    }
    .cert-icon {
        width: 56px; height: 56px;
        background: rgba(245,158,11,0.12);
        border-radius: var(--md-radius-sm);
        display: flex; align-items: center; justify-content: center;
        font-size: 28px; color: var(--md-warning);
        flex-shrink: 0;
    }
    .cert-actions { display: flex; gap: 8px; flex-shrink: 0; }
</style>

<div class="page-header">
    <div>
        <h4 class="page-header-title">Meus Certificados</h4>
        <p class="page-header-sub">Certificados de conclusão de cursos</p>
    </div>
</div>

@if (Model.Any())
{
    foreach (var cert in Model)
    {
        <div class="cert-card">
            <div class="cert-icon"><i class="bi bi-award-fill"></i></div>
            <div style="flex:1; min-width:0;">
                <p style="font-weight:700; font-size:15px; color:var(--md-text-primary); margin:0 0 4px;">
                    @cert.CourseTitle
                </p>
                <p style="font-size:13px; color:var(--md-text-muted); margin:0 0 2px;">
                    Concluído em @cert.CompletedDate.ToString("dd/MM/yyyy")
                </p>
                @if (!string.IsNullOrEmpty(cert.ValidationCode))
                {
                    <p style="font-size:12px; color:var(--md-text-muted); margin:0;">
                        Código: <code style="color:var(--md-accent);">@cert.ValidationCode</code>
                    </p>
                }
            </div>
            <div class="cert-actions">
                @if (!string.IsNullOrEmpty(cert.CertifiedFile))
                {
                    <a href="@cert.CertifiedFile" target="_blank" class="btn-md-ghost" style="font-size:12px; padding:7px 14px;">
                        <i class="bi bi-file-earmark-pdf"></i> PDF
                    </a>
                }
                <a href="https://www.linkedin.com/profile/add?startTask=CERTIFICATION_NAME&name=@Uri.EscapeDataString(cert.CourseTitle)&organizationName=JAPLearning&issueYear=@cert.CompletedDate.Year&issueMonth=@cert.CompletedDate.Month"
                   target="_blank" class="btn-md-ghost" style="font-size:12px; padding:7px 14px; color:#0077B5; border-color:#0077B5;">
                    <i class="bi bi-linkedin"></i> LinkedIn
                </a>
            </div>
        </div>
    }
}
else
{
    <div style="text-align:center; padding:60px; color:var(--md-text-muted);">
        <i class="bi bi-award" style="font-size:48px; display:block; margin-bottom:16px;"></i>
        <p style="font-size:16px; font-weight:600; margin:0 0 8px;">Nenhum certificado ainda</p>
        <p style="font-size:14px; margin:0;">Conclua um curso para obter o seu certificado.</p>
    </div>
}
