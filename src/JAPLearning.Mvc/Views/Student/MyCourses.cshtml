@model List<JAPLearning.Mvc.ViewModels.Student.CourseProgressViewModel>
@{
    ViewData["Title"]      = "Minhas Formações";
    ViewData["ActiveMenu"] = "my-courses";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<style>
    .course-card {
        background: var(--md-bg-card);
        border: 1px solid var(--md-border);
        border-radius: var(--md-radius);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        text-decoration: none;
        transition: var(--md-transition);
        margin-bottom: 12px;
    }
    .course-card:hover { border-color: rgba(232,80,26,0.35); transform: translateY(-1px); }
    .course-thumb {
        width: 80px; height: 80px;
        background: var(--md-bg-secondary);
        border-radius: var(--md-radius-sm);
        display: flex; align-items: center; justify-content: center;
        font-size: 28px; color: var(--md-border);
        flex-shrink: 0;
        overflow: hidden;
    }
    .course-thumb img {
        width: 100%; height: 100%;
        object-fit: cover;
        border-radius: var(--md-radius-sm);
    }
</style>

<div class="page-header">
    <div>
        <h4 class="page-header-title">Minhas Formações</h4>
        <p class="page-header-sub">Formações em que tem progresso</p>
    </div>
</div>

@if (Model.Any())
{
    foreach (var item in Model.OrderByDescending(x => x.ProgressPercent))
    {
        <a asp-action="CourseDetail" asp-route-id="@item.Course.Id"
           class="course-card">
            <div class="course-thumb">
                @if (!string.IsNullOrWhiteSpace(item.Course.Thumbnail))
                {
                    <img src="@item.Course.Thumbnail" alt="@item.Course.Title" />
                }
                else
                {
                    <i class="bi bi-code-square"></i>
                }
            </div>
            <div style="flex:1; min-width:0;">
                <p style="font-weight:700; font-size:15px; color:var(--md-text-primary); margin:0 0 4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                    @item.Course.Title
                </p>
                <p style="font-size:12px; color:var(--md-text-muted); margin:0 0 2px;">
                    @item.Course.TeacherName &nbsp;·&nbsp; @item.Course.LevelName
                </p>
                <p style="font-size:12px; color:var(--md-text-muted); margin:0 0 10px;">
                    @item.CompletedLessons de @item.TotalLessons aulas concluídas
                </p>
                <div class="md-progress">
                    <div class="md-progress-bar" style="width:@item.ProgressPercent%;"></div>
                </div>
            </div>
            <div style="text-align:right; flex-shrink:0;">
                <span style="font-size:20px; font-weight:800; color:var(--md-text-primary);">@item.ProgressPercent%</span>
                @if (item.IsCompleted)
                {
                    <br /><span class="badge-active" style="font-size:10px;"><i class="bi bi-check-circle-fill"></i> Concluído</span>
                }
                else
                {
                    <br /><span style="font-size:11px; color:var(--md-accent);">Em progresso</span>
                }
            </div>
        </a>
    }
}
else
{
    <div style="text-align:center; padding:60px; color:var(--md-text-muted);">
        <i class="bi bi-collection-play" style="font-size:48px; display:block; margin-bottom:16px;"></i>
        <p style="font-size:16px; font-weight:600; margin:0 0 8px;">Nenhuma formação iniciada</p>
        <p style="font-size:14px; margin:0;">Comece uma aula para ver o seu progresso aqui.</p>
    </div>
}
