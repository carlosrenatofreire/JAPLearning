@{
    ViewData["Title"]      = "Categorias";
    ViewData["ActiveMenu"] = "categories";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";

    var items = ViewBag.CategoryItems as IEnumerable<dynamic>;
}

<style>
    .cat-card {
        background: var(--md-bg-card);
        border: 1px solid var(--md-border);
        border-radius: var(--md-radius);
        padding: 24px;
        text-decoration: none;
        display: block;
        transition: var(--md-transition);
    }
    .cat-card:hover {
        border-color: rgba(232,80,26,0.4);
        transform: translateY(-2px);
        box-shadow: var(--md-shadow);
    }
    .cat-icon {
        width: 48px; height: 48px;
        background: rgba(232,80,26,0.1);
        border-radius: var(--md-radius-sm);
        display: flex; align-items: center; justify-content: center;
        font-size: 22px; color: var(--md-accent);
        margin-bottom: 14px;
    }
</style>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h4 style="font-weight:800; margin-bottom:4px;">Categorias</h4>
        <p style="color:var(--md-text-muted); font-size:14px; margin:0;">Explore formações por área de conhecimento.</p>
    </div>
</div>

<div class="row g-4">
    @if (items != null)
    {
        foreach (var item in items)
        {
            <div class="col-sm-6 col-lg-4">
                <a asp-action="Courses" asp-fragment="@(item.Category.Name.ToLower().Replace(" ", "-"))" class="cat-card">
                    <div class="cat-icon"><i class="bi bi-layers"></i></div>
                    <p style="font-weight:700; font-size:16px; color:var(--md-text-primary); margin:0 0 4px;">
                        @item.Category.Name
                    </p>
                    @if (!string.IsNullOrWhiteSpace(item.Category.Subtitle))
                    {
                        <p style="font-size:13px; color:var(--md-text-muted); margin:0 0 8px;">@item.Category.Subtitle</p>
                    }
                    <p style="font-size:12px; color:var(--md-text-muted); margin:0;">
                        <i class="bi bi-collection-play"></i> @item.CourseCount formação(ões)
                    </p>
                </a>
            </div>
        }
    }
</div>

@if (items == null || !((IEnumerable<dynamic>)items).Any())
{
    <div style="text-align:center; padding:60px; color:var(--md-text-muted);">
        <i class="bi bi-layers" style="font-size:48px; display:block; margin-bottom:16px;"></i>
        <p style="font-size:16px; font-weight:600; margin:0;">Nenhuma categoria disponível.</p>
    </div>
}
