@model JAPLearning.Mvc.ViewModels.Student.CourseCatalogViewModel
@{
    ViewData["Title"]      = "Formações";
    ViewData["ActiveMenu"] = "courses";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<style>
    .filter-btn {
        padding: 7px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid var(--md-border);
        background: transparent;
        color: var(--md-text-secondary);
        cursor: pointer;
        transition: var(--md-transition);
    }
    .filter-btn:hover, .filter-btn.active {
        border-color: var(--md-accent);
        color: var(--md-accent);
        background: rgba(232,80,26,0.08);
    }

    .md-course-card { overflow: hidden; position: relative; }

    /* Badge BREVE */
    .status-badge-breve {
        position: absolute; top: 10px; right: 10px; z-index: 2;
        padding: 4px 10px; font-size: 11px; font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.06em; border-radius: 6px;
        background: rgba(245,158,11,0.92); color: #1a0f00;
        box-shadow: 0 2px 8px rgba(245,158,11,0.35);
        backdrop-filter: blur(4px);
    }
    /* Card BREVE — sem hover, cursor default */
    .course-card-wrap.is-breve .md-course-card { pointer-events: none; cursor: default; opacity: 0.88; }
    .course-card-wrap.is-breve .md-course-card:hover .md-course-card-thumb img { transform: none; }

    .md-course-card-thumb {
        position: relative; overflow: hidden; padding: 0;
        background: var(--md-bg-secondary); aspect-ratio: 16/9;
        display: flex; align-items: center; justify-content: center;
    }
    .md-course-card-thumb img {
        width: 100%; height: 100%;
        object-fit: cover; display: block;
        transition: transform 0.4s ease;
    }
    .md-course-card-thumb .thumb-placeholder {
        font-size: 48px; color: var(--md-border);
    }
    .md-course-card:hover .md-course-card-thumb img { transform: scale(1.04); }

    .cat-badge {
        display: inline-block; font-size: 11px; font-weight: 700;
        padding: 3px 10px; border-radius: 5px; letter-spacing: 0.03em;
    }

    .progress-status-dot {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 11px; font-weight: 600;
    }
    .dot { width:7px; height:7px; border-radius:50%; display:inline-block; }

    .filter-empty {
        text-align: center; padding: 60px 20px;
        color: var(--md-text-muted); display: none;
    }
    .filter-empty.show { display: block; }

    .course-description {
        font-size: 12px;
        color: var(--md-text-muted);
        line-height: 1.5;
        margin: 0 0 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .course-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid var(--md-border);
        font-size: 12px;
        color: var(--md-text-muted);
    }
    .course-card-footer .instructor {
        display: flex;
        align-items: center;
        gap: 7px;
        font-weight: 500;
    }
    .course-card-footer .instructor-avatar {
        width: 26px; height: 26px;
        border-radius: 50%;
        background: var(--md-border);
        display: flex; align-items: center; justify-content: center;
        font-size: 11px; color: var(--md-text-muted);
        flex-shrink: 0;
    }
    .course-card-footer .duration {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        color: var(--md-text-muted);
    }
</style>

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <h4 style="font-weight:800; margin-bottom:4px;">Formações</h4>
        <p style="color:var(--md-text-muted); font-size:14px; margin:0;">
            Todas as formações disponíveis na plataforma.
        </p>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap;" id="filter-bar">
        <button class="filter-btn" data-filter="all">Todos</button>
        @foreach (var cat in Model.Categories)
        {
            <button class="filter-btn" data-filter="@cat.Name.ToLower().Replace(" ", "-")">@cat.Name</button>
        }
    </div>
</div>

<div id="course-grid" class="row g-4">
    @foreach (var item in Model.Courses)
    {
        var catKey    = item.Course.CategoryName.ToLower().Replace(" ", "-");
        var playerUrl = item.LastLessonId.HasValue
            ? Url.Action("Player", "Student", new { courseId = item.Course.Id, lessonId = item.LastLessonId })
            : Url.Action("Player", "Student", new { courseId = item.Course.Id });

        <div class="col-md-6 col-xl-4 course-card-wrap @(item.Course.IsBrief ? "is-breve" : "")" data-category="@catKey">
            <a href="@(item.Course.IsBrief ? "javascript:void(0)" : playerUrl)" class="md-course-card"
               style="@(item.Course.IsBrief ? "pointer-events:none;" : "")">
                <div class="md-course-card-thumb">
                    @if (!string.IsNullOrEmpty(item.Course.Thumbnail))
                    {
                        <img src="@item.Course.Thumbnail" alt="@item.Course.Title" />
                    }
                    else
                    {
                        <span class="thumb-placeholder"><i class="bi bi-code-square"></i></span>
                    }
                    @if (item.Course.IsBrief)
                    {
                        <span class="status-badge-breve">Breve</span>
                    }
                </div>
                <div class="md-course-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="cat-badge"
                              style="background:rgba(232,80,26,0.1); color:var(--md-accent); border:1px solid rgba(232,80,26,0.25);">
                            @item.Course.CategoryName
                        </span>
                        @if (item.ProgressPercent > 0)
                        {
                            <span style="font-size:12px; color:var(--md-accent); font-weight:700;">@item.ProgressPercent%</span>
                        }
                        else
                        {
                            <span style="font-size:12px; color:var(--md-text-muted);">@item.Course.LevelName</span>
                        }
                    </div>
                    <p class="md-course-card-title">@item.Course.Title</p>
                    @if (!string.IsNullOrWhiteSpace(item.Course.Subtitle))
                    {
                        <p style="font-size:13px; color:var(--md-text-secondary); line-height:1.5; margin:0 0 6px; font-weight:500;">@item.Course.Subtitle</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Course.Description))
                    {
                        <p class="course-description">@item.Course.Description</p>
                    }
                    @if (item.TotalLessons > 0)
                    {
                        <div class="md-course-card-meta mb-2">
                            <span><i class="bi bi-play-circle"></i> @item.TotalLessons aulas</span>
                            @if (item.TotalDuration > TimeSpan.Zero)
                            {
                                <span><i class="bi bi-clock"></i> @item.DurationDisplay</span>
                            }
                            @if (item.TotalTopics > 0)
                            {
                                <span><i class="bi bi-folder"></i> @item.TotalTopics módulos</span>
                            }
                        </div>
                    }
                    <div>
                        <div class="md-progress">
                            <div class="md-progress-bar" style="width:@item.ProgressPercent%;"></div>
                        </div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px; font-size:11px;">
                            @switch (item.ProgressStatus)
                            {
                                case "completed":
                                    <span class="progress-status-dot" style="color:var(--md-success);">
                                        <span class="dot" style="background:var(--md-success);"></span> Concluído
                                    </span>
                                    break;
                                case "in-progress":
                                    <span class="progress-status-dot" style="color:var(--md-accent);">
                                        <span class="dot" style="background:var(--md-accent);"></span> Em progresso
                                    </span>
                                    break;
                                default:
                                    <span class="progress-status-dot" style="color:var(--md-text-muted);">
                                        <span class="dot" style="background:var(--md-border);"></span> Não iniciado
                                    </span>
                                    break;
                            }
                            @if (item.Course.IsFree)
                            {
                                <span class="md-badge md-badge-success">Grátis</span>
                            }
                        </div>
                    </div>

                    <!-- Footer: instrutor + duração total -->
                    <div class="course-card-footer">
                        <div class="instructor">
                            <div class="instructor-avatar">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <span>@item.Course.TeacherName</span>
                        </div>
                        @if (item.TotalDuration > TimeSpan.Zero)
                        {
                            <div class="duration">
                                <i class="bi bi-clock"></i>
                                <span>@item.DurationDisplay</span>
                            </div>
                        }
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div id="filter-empty" class="filter-empty">
    <i class="bi bi-search" style="font-size:32px; display:block; margin-bottom:8px;"></i>
    Nenhuma formação encontrada nesta categoria.
</div>

@if (!Model.Courses.Any())
{
    <div style="text-align:center; padding:60px; color:var(--md-text-muted);">
        <i class="bi bi-collection-play" style="font-size:48px; display:block; margin-bottom:16px;"></i>
        <p style="font-size:16px; font-weight:600; margin:0;">Nenhuma formação disponível ainda.</p>
    </div>
}

@section Scripts {
<script>
    (function () {
        const buttons = document.querySelectorAll('.filter-btn');
        const cards   = document.querySelectorAll('.course-card-wrap');
        const empty   = document.getElementById('filter-empty');

        function applyFilter(filter) {
            let visible = 0;
            cards.forEach(c => {
                const match = filter === 'all' || c.dataset.category === filter;
                c.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            empty.classList.toggle('show', visible === 0 && cards.length > 0);
            buttons.forEach(b => b.classList.toggle('active', b.dataset.filter === filter));
        }

        buttons.forEach(btn => btn.addEventListener('click', () => {
            const f = btn.dataset.filter;
            history.replaceState(null, '', f === 'all' ? location.pathname : '#' + f);
            applyFilter(f);
        }));

        window.addEventListener('hashchange', () => {
            const h = (location.hash || '').replace('#', '').toLowerCase();
            applyFilter(h || 'all');
        });

        const initHash = (location.hash || '').replace('#', '').toLowerCase();
        applyFilter(initHash || 'all');
    })();
</script>
}
