@model JAPLearning.Mvc.ViewModels.Student.PersonalDataViewModel
@{
    ViewData["Title"]      = "Dados Pessoais";
    ViewData["ActiveMenu"] = "profile";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}
@await Html.PartialAsync("_CrudStyles")

@if (TempData["Success"] != null)
{
    <div class="alert-success-md"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="page-header">
    <div>
        <h4 class="page-header-title">Dados Pessoais</h4>
        <p class="page-header-sub">Actualize as suas informações de perfil</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="md-card">
            <h6 style="font-weight:700; margin-bottom:20px;">Informações Pessoais</h6>
            <form asp-action="PersonalData" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert-danger-md" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="md-label"></label>
                        <input asp-for="FirstName" class="md-input" />
                        <span asp-validation-for="FirstName" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="md-label"></label>
                        <input asp-for="LastName" class="md-input" />
                        <span asp-validation-for="LastName" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Email" class="md-label"></label>
                        <input asp-for="Email" class="md-input" type="email" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Phone" class="md-label"></label>
                        <input asp-for="Phone" class="md-input" />
                    </div>
                </div>

                <div class="md-form-row">
                    <label class="md-label">Foto de Perfil</label>
                    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentPhotoUrl))
                        {
                            <img src="@Model.CurrentPhotoUrl" alt="Foto actual" style="width:72px; height:72px; border-radius:50%; object-fit:cover; border:2px solid var(--md-border);" />
                        }
                        else
                        {
                            <div style="width:72px; height:72px; border-radius:50%; background:var(--md-border); display:flex; align-items:center; justify-content:center;">
                                <i class="bi bi-person" style="font-size:28px; color:var(--md-text-muted);"></i>
                            </div>
                        }
                        <div style="flex:1;">
                            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="md-input" style="padding:6px;" />
                            <small style="color:var(--md-text-muted); font-size:11px;">JPG, PNG ou WebP — máx. 5 MB</small>
                        </div>
                    </div>
                </div>

                <div style="margin-top:24px; display:flex; gap:12px;">
                    <button type="submit" class="btn-md-primary">
                        <i class="bi bi-check-lg"></i> Guardar Alterações
                    </button>
                    <a asp-action="ChangePassword" class="btn-md-ghost">
                        <i class="bi bi-lock"></i> Alterar Senha
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="md-card">
            <h6 style="font-weight:700; margin-bottom:16px;">Zona de Segurança</h6>
            <p style="font-size:13px; color:var(--md-text-muted); margin-bottom:16px;">
                Altere a sua senha de acesso à plataforma.
            </p>
            <a asp-action="ChangePassword" class="btn-md-ghost" style="width:100%; justify-content:center;">
                <i class="bi bi-shield-lock"></i> Alterar Senha
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
