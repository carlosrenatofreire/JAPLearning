@model JAPLearning.Mvc.ViewModels.Entities.OrderViewModel
@{
    ViewData["Title"] = "Novo Pedido";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Novo Pedido</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Pedidos</a> / Criar</p>
    </div>
</div>

<div class="md-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="md-label">Utilizador <span class="text-danger">*</span></label>
                <select asp-for="UserId" asp-items="ViewBag.Users" class="md-input">
                    <option value="">— Seleccionar —</option>
                </select>
                <span asp-validation-for="UserId" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label class="md-label">Plano <span class="text-danger">*</span></label>
                <select asp-for="PlanId" asp-items="ViewBag.Plans" class="md-input">
                    <option value="">— Seleccionar —</option>
                </select>
                <span asp-validation-for="PlanId" class="field-error"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="md-label">Início da Licença</label>
                <input asp-for="StartLicense" type="date" class="md-input" />
            </div>
            <div class="col-md-6">
                <label class="md-label">Fim da Licença</label>
                <input asp-for="EndLicense" type="date" class="md-input" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="md-label">Valor (€)</label>
                <input asp-for="Value" type="number" step="0.01" class="md-input" min="0" />
            </div>
            <div class="col-md-4">
                <label class="md-label">Desconto (€)</label>
                <input asp-for="Discount" type="number" step="0.01" class="md-input" min="0" />
            </div>
            <div class="col-md-4">
                <label class="md-label">Estado <span class="text-danger">*</span></label>
                <select asp-for="StatusId" asp-items="ViewBag.Statuses" class="md-input">
                    <option value="">— Seleccionar —</option>
                </select>
            </div>
        </div>

        <div class="mb-4">
            <label class="md-form-check">
                <input asp-for="IsActived" type="checkbox" />
                <span>Activo</span>
            </label>
        </div>

        <div style="display:flex; gap:12px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-secondary">Cancelar</a>
        </div>
    </form>
</div>
