@model JAPLearning.Mvc.ViewModels.Parameters.OrderStatusViewModel
@{
    ViewData["Title"] = "Editar Estado de Pedido";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Estado de Pedido</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-text-muted);">Estados de Pedido</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> Editar</p>
    </div>
</div>

<div class="md-card form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="md-form-row">
            <label asp-for="Name" class="md-label"></label>
            <input asp-for="Name" class="md-input" />
            <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="md-form-row">
            <label asp-for="Description" class="md-label"></label>
            <textarea asp-for="Description" class="md-input" rows="3"></textarea>
        </div>

        <div class="md-form-row">
            <div class="md-form-check">
                <input asp-for="IsActived" type="checkbox" />
                <label asp-for="IsActived">Activo</label>
            </div>
        </div>

        <div style="display:flex; gap:12px; margin-top:8px;">
            <button type="submit" class="btn-md-primary">
                <i class="bi bi-check-lg"></i> Guardar
            </button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>
