@model List<JAPLearning.Mvc.ViewModels.Entities.PlanViewModel>
@{
    ViewData["Title"] = "Planos";
}
@await Html.PartialAsync("_CrudStyles")

@if (TempData["Success"] != null)
{
    <div class="alert-success-md"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="page-header">
    <div>
        <h4 class="page-header-title">Planos</h4>
        <p class="page-header-sub">Gestão de planos de subscrição</p>
    </div>
    <a asp-action="Create" class="btn-md-primary"><i class="bi bi-plus-lg"></i> Novo Plano</a>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">
    <table class="crud-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Meses</th>
                <th>Preço</th>
                <th>Promoção</th>
                <th>Estado</th>
                <th style="width:100px; text-align:center;">Acções</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:var(--md-text-primary); font-weight:600;">@item.Name</td>
                    <td>
                        @switch (item.PlanType)
                        {
                            case JAPLearning.Business.Models.Enums.PlanType.SemiAnnual:
                                <span class="md-badge md-badge-info">Semestral</span>
                                break;
                            case JAPLearning.Business.Models.Enums.PlanType.Annual:
                                <span class="md-badge md-badge-success">Anual</span>
                                break;
                            default:
                                <span class="md-badge md-badge-warning">A Pedido</span>
                                break;
                        }
                    </td>
                    <td>@(item.Months.HasValue ? $"{item.Months} meses" : "—")</td>
                    <td style="color:var(--md-accent); font-weight:600;">
                        @(item.Price.HasValue ? item.Price.Value.ToString("C", new System.Globalization.CultureInfo("pt-PT")) : "—")
                    </td>
                    <td>
                        @if (item.Promotion == true)
                        {
                            <span class="badge-active"><i class="bi bi-tag-fill"></i> @item.DiscountPercent%</span>
                        }
                        else { <span style="color:var(--md-text-muted); font-size:13px;">—</span> }
                    </td>
                    <td>
                        @if (item.IsActived) { <span class="badge-active"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Activo</span> }
                        else { <span class="badge-inactive"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Inactivo</span> }
                    </td>
                    <td style="text-align:center;">
                        <div style="display:flex; gap:6px; justify-content:center;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="margin:0;"
                                  onsubmit="return confirm('Eliminar este plano?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-btn danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" style="text-align:center; padding:40px; color:var(--md-text-muted);">
                    <i class="bi bi-credit-card-2-front" style="font-size:32px; display:block; margin-bottom:8px;"></i>
                    Nenhum plano encontrado.
                </td></tr>
            }
        </tbody>
    </table>
</div>
