@model JAPLearning.Mvc.ViewModels.Entities.PlanViewModel
@{
    ViewData["Title"] = "Novo Plano";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Novo Plano</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Planos</a> / Criar</p>
    </div>
</div>

<div class="md-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="md-label">Nome <span class="text-danger">*</span></label>
                <input asp-for="Name" class="md-input" placeholder="Nome do plano" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label class="md-label">Tipo <span class="text-danger">*</span></label>
                <select asp-for="PlanType" asp-items="ViewBag.PlanTypes" class="md-input"></select>
            </div>
        </div>

        <div class="mb-3">
            <label class="md-label">Descrição</label>
            <textarea asp-for="Description" class="md-input" rows="2" placeholder="Descrição do plano"></textarea>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="md-label">Meses</label>
                <input asp-for="Months" type="number" class="md-input" placeholder="ex: 12" min="1" />
            </div>
            <div class="col-md-4">
                <label class="md-label">Preço (€)</label>
                <input asp-for="Price" type="number" step="0.01" class="md-input" placeholder="0.00" min="0" />
            </div>
            <div class="col-md-4">
                <label class="md-label">Desconto (%)</label>
                <input asp-for="DiscountPercent" type="number" class="md-input" placeholder="ex: 10" min="0" max="100" />
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-auto">
                <label class="md-form-check">
                    <input asp-for="Promotion" type="checkbox" />
                    <span>Em promoção</span>
                </label>
            </div>
            <div class="col-auto">
                <label class="md-form-check">
                    <input asp-for="IsActived" type="checkbox" />
                    <span>Activo</span>
                </label>
            </div>
        </div>

        <div style="display:flex; gap:12px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-secondary">Cancelar</a>
        </div>
    </form>
</div>
