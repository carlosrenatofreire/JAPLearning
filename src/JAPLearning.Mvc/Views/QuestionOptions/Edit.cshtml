@model JAPLearning.Mvc.ViewModels.Entities.QuestionOptionViewModel
@{
    ViewData["Title"] = "Editar Opção";
    var selectedTeamId   = ViewBag.SelectedTeamId   as Guid?;
    var selectedCourseId = ViewBag.SelectedCourseId as Guid?;
    var selectedTopicId  = ViewBag.SelectedTopicId  as Guid?;
    var selectedLessonId = ViewBag.SelectedLessonId as Guid?;
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Opção de Resposta</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Opções</a> / Editar</p>
    </div>
</div>

<div class="md-card form-card" style="max-width:100%;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="row g-3">

            <!-- Equipa (3) + Formação (3) + Tópico (3) + Lição (3) -->
            <div class="col-md-3">
                <div class="md-form-row">
                    <label class="md-label">Equipa</label>
                    <select id="teamSelect" asp-items="ViewBag.Teams" class="md-select">
                        <option value="">Seleccionar...</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="md-form-row">
                    <label class="md-label">Formação</label>
                    <select id="courseSelect" class="md-select" disabled="@(!selectedTeamId.HasValue)">
                        <option value="">— Equipa primeiro —</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="md-form-row">
                    <label class="md-label">Tópico</label>
                    <select id="topicSelect" class="md-select" disabled="@(!selectedCourseId.HasValue)">
                        <option value="">— Formação primeiro —</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="md-form-row">
                    <label class="md-label">Lição</label>
                    <select id="lessonSelect" class="md-select" disabled="@(!selectedTopicId.HasValue)">
                        <option value="">— Tópico primeiro —</option>
                    </select>
                </div>
            </div>

            <!-- Questão (12) -->
            <div class="col-12">
                <div class="md-form-row">
                    <label asp-for="QuestionId" class="md-label">Questão <span class="text-danger">*</span></label>
                    <select asp-for="QuestionId" id="questionSelect" class="md-select" disabled="@(!selectedLessonId.HasValue)">
                        <option value="">— Lição primeiro —</option>
                    </select>
                    <span asp-validation-for="QuestionId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>

            <!-- Texto da Opção (9) + Correcta + Activa (3) -->
            <div class="col-md-9">
                <div class="md-form-row">
                    <label asp-for="Name" class="md-label">Texto da Opção <span class="text-danger">*</span></label>
                    <textarea asp-for="Name" class="md-input" rows="3" placeholder="ex: A opção A é..."></textarea>
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-3" style="display:flex; align-items:flex-end; flex-direction:column; gap:10px; padding-bottom:6px;">
                <div class="md-form-check">
                    <input asp-for="IsCorrect" type="checkbox" />
                    <label asp-for="IsCorrect" style="color:#4caf82;"><i class="bi bi-check-circle"></i> Correcta</label>
                </div>
                <div class="md-form-check">
                    <input asp-for="IsActived" type="checkbox" />
                    <label asp-for="IsActived">Activa</label>
                </div>
            </div>

            <!-- Descrição (12) -->
            <div class="col-12">
                <div class="md-form-row">
                    <label asp-for="Description" class="md-label">Descrição / Explicação</label>
                    <textarea asp-for="Description" class="md-input" rows="3"></textarea>
                </div>
            </div>

        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    const teamSel     = document.getElementById('teamSelect');
    const courseSel   = document.getElementById('courseSelect');
    const topicSel    = document.getElementById('topicSelect');
    const lessonSel   = document.getElementById('lessonSelect');
    const questionSel = document.getElementById('questionSelect');

    const initTeamId     = '@(selectedTeamId?.ToString() ?? "")';
    const initCourseId   = '@(selectedCourseId?.ToString() ?? "")';
    const initTopicId    = '@(selectedTopicId?.ToString() ?? "")';
    const initLessonId   = '@(selectedLessonId?.ToString() ?? "")';
    const initQuestionId = '@Model.QuestionId';

    function resetSelect(sel, placeholder) {
        sel.innerHTML = `<option value="">${placeholder}</option>`;
        sel.disabled = true;
    }

    function populate(sel, data, selectVal) {
        sel.innerHTML = '<option value="">Seleccionar...</option>';
        data.forEach(item => {
            const opt = document.createElement('option');
            opt.value = item.value; opt.text = item.text;
            if (item.value === selectVal) opt.selected = true;
            sel.appendChild(opt);
        });
        sel.disabled = data.length === 0;
    }

    function loadCourses(teamId, sel)     { return fetch(`/QuestionOptions/GetCoursesByTeam?teamId=${teamId}`).then(r => r.json()).then(d => populate(courseSel, d, sel)); }
    function loadTopics(courseId, sel)    { return fetch(`/QuestionOptions/GetTopicsByCourse?courseId=${courseId}`).then(r => r.json()).then(d => populate(topicSel, d, sel)); }
    function loadLessons(topicId, sel)    { return fetch(`/QuestionOptions/GetLessonsByTopic?topicId=${topicId}`).then(r => r.json()).then(d => populate(lessonSel, d, sel)); }
    function loadQuestions(lessonId, sel) { return fetch(`/QuestionOptions/GetQuestionsByLesson?lessonId=${lessonId}`).then(r => r.json()).then(d => populate(questionSel, d, sel)); }

    // Pré-selecção em cascata no load
    if (initTeamId) {
        teamSel.value = initTeamId;
        loadCourses(initTeamId, initCourseId).then(() => {
            if (initCourseId) loadTopics(initCourseId, initTopicId).then(() => {
                if (initTopicId) loadLessons(initTopicId, initLessonId).then(() => {
                    if (initLessonId) loadQuestions(initLessonId, initQuestionId);
                });
            });
        });
    }

    // Eventos de mudança
    teamSel.addEventListener('change', function () {
        resetSelect(courseSel,   '— Equipa primeiro —');
        resetSelect(topicSel,    '— Formação primeiro —');
        resetSelect(lessonSel,   '— Tópico primeiro —');
        resetSelect(questionSel, '— Lição primeiro —');
        if (this.value) loadCourses(this.value, '');
    });
    courseSel.addEventListener('change', function () {
        resetSelect(topicSel,    '— Formação primeiro —');
        resetSelect(lessonSel,   '— Tópico primeiro —');
        resetSelect(questionSel, '— Lição primeiro —');
        if (this.value) loadTopics(this.value, '');
    });
    topicSel.addEventListener('change', function () {
        resetSelect(lessonSel,   '— Tópico primeiro —');
        resetSelect(questionSel, '— Lição primeiro —');
        if (this.value) loadLessons(this.value, '');
    });
    lessonSel.addEventListener('change', function () {
        resetSelect(questionSel, '— Lição primeiro —');
        if (this.value) loadQuestions(this.value, '');
    });
})();
</script>
}
