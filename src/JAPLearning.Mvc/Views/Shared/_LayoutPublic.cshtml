<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>JL | @(ViewData["Title"] ?? "JAPLearning")</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon.svg" />
    <meta name="description" content="@(ViewData["Description"] ?? "A plataforma de aprendizagem interna do Grupo JAP")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mundodev.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        /* ── Navbar Public ──────────────────────────────────── */
        .md-navbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: var(--md-navbar-height);
            background: rgba(10,10,22,0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--md-border);
            z-index: 1000;
            display: flex;
            align-items: center;
        }
        .md-navbar .container-fluid { display: flex; align-items: center; gap: 32px; }
        .md-navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }
        .md-navbar-brand .brand-icon {
            width: 32px; height: 32px;
            background: var(--md-gradient);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 14px; color: #fff;
        }
        .md-navbar-brand .brand-name {
            font-size: 18px; font-weight: 800;
            color: var(--md-text-primary);
            letter-spacing: -0.02em;
        }
        .md-navbar-brand .brand-name span { color: var(--md-accent); }
        .md-nav-links {
            display: flex; align-items: center; gap: 4px;
            list-style: none; margin: 0; padding: 0; flex: 1;
        }
        .md-nav-links a {
            padding: 8px 14px;
            color: var(--md-text-secondary);
            font-size: 14px; font-weight: 500;
            border-radius: var(--md-radius-sm);
            transition: var(--md-transition);
            text-decoration: none;
        }
        .md-nav-links a:hover,
        .md-nav-links a.active { color: var(--md-text-primary); background: rgba(255,255,255,0.05); }
        .md-navbar-actions { display: flex; align-items: center; gap: 12px; margin-left: auto; }

        /* ── Page wrapper ───────────────────────────────────── */
        .md-page { padding-top: var(--md-navbar-height); min-height: 100vh; }

        /* ── Footer ─────────────────────────────────────────── */
        .md-footer {
            background: var(--md-bg-navbar);
            border-top: 1px solid var(--md-border);
            padding: 48px 0 24px;
            margin-top: 80px;
        }
        .md-footer-logo { margin-bottom: 12px; }
        .md-footer-desc { color: var(--md-text-muted); font-size: 14px; max-width: 280px; line-height: 1.7; }
        .md-footer-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--md-text-secondary); margin-bottom: 16px; }
        .md-footer-links { list-style: none; padding: 0; margin: 0; }
        .md-footer-links li { margin-bottom: 10px; }
        .md-footer-links a { color: var(--md-text-muted); font-size: 14px; transition: var(--md-transition); text-decoration: none; }
        .md-footer-links a:hover { color: var(--md-accent); }
        .md-footer-bottom { border-top: 1px solid var(--md-border); margin-top: 40px; padding-top: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
        .md-footer-copy { color: var(--md-text-muted); font-size: 13px; }

        /* ── Hamburger mobile ───────────────────────────────── */
        .md-menu-toggle { display: none; background: none; border: 1px solid var(--md-border); border-radius: var(--md-radius-sm); padding: 6px 10px; color: var(--md-text-primary); cursor: pointer; }
        @@media (max-width: 991px) {
            .md-nav-links { display: none; flex-direction: column; gap: 4px; }
            .md-nav-links.open {
                display: flex;
                position: fixed;
                top: var(--md-navbar-height);
                left: 0; right: 0;
                background: rgba(10,10,22,0.98);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--md-border);
                padding: 16px 20px;
                z-index: 999;
            }
            .md-nav-links.open li { width: 100%; }
            .md-nav-links.open a { display: block; padding: 12px 16px; font-size: 15px; border-radius: var(--md-radius-sm); }
            .md-navbar-actions { display: none; }
            .md-menu-toggle { display: block; }
        }
    </style>
</head>
<body>

    <!-- ── Navbar ─────────────────────────────────────────── -->
    <nav class="md-navbar">
        <div class="container-fluid px-4">
            <a class="md-navbar-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
                <span class="brand-name">JAP<span> Learning</span></span>
            </a>

            <ul class="md-nav-links">
                <li><a asp-controller="Home" asp-action="Courses">Formações</a></li>
                <li><a asp-controller="Home" asp-action="Blog">Artigos</a></li>
                <li><a asp-controller="Home" asp-action="PorqueFormacao">Porquê Formar?</a></li>
                <li><a asp-controller="Home" asp-action="About">Quem Somos</a></li>
            </ul>

            <div class="md-navbar-actions">
                <a asp-controller="Account" asp-action="Login" class="btn-md-primary">Entrar</a>
            </div>
            <button class="md-menu-toggle ms-auto" id="navToggle" onclick="toggleNav()">
                <i class="bi bi-list" id="navToggleIcon"></i>
            </button>
        </div>
    </nav>

    <!-- ── Page Content ───────────────────────────────────── -->
    <div class="md-page">
        @RenderBody()
    </div>

    <!-- ── Footer ─────────────────────────────────────────── -->
    <footer class="md-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="md-footer-logo">
                        <a class="md-navbar-brand" asp-controller="Home" asp-action="Index">
                            <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
                            <span class="brand-name">JAP<span> Learning</span></span>
                        </a>
                    </div>
                    <p class="md-footer-desc">
                        A plataforma de aprendizagem interna do Grupo JAP, onde as equipas
                        desenvolvem competências práticas ao seu próprio ritmo.
                    </p>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="md-footer-title">Plataforma</p>
                    <ul class="md-footer-links">
                        <li><a asp-controller="Home" asp-action="Courses">Formações</a></li>
                        <li><a asp-controller="Home" asp-action="Blog">Artigos</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <p class="md-footer-title">Empresa</p>
                    <ul class="md-footer-links">
                        <li><a asp-controller="Home" asp-action="About">Quem Somos</a></li>
                        <li><a asp-controller="Home" asp-action="Faq">Perguntas Frequentes</a></li>
                        <li><a asp-controller="Home" asp-action="Terms">Termos de Uso</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacidade</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <p class="md-footer-title">Redes Sociais</p>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn-md-ghost px-3 py-2" style="border:1px solid var(--md-border); border-radius:var(--md-radius-sm);">
                            <i class="bi bi-youtube"></i>
                        </a>
                        <a href="#" class="btn-md-ghost px-3 py-2" style="border:1px solid var(--md-border); border-radius:var(--md-radius-sm);">
                            <i class="bi bi-linkedin"></i>
                        </a>
                        <a href="#" class="btn-md-ghost px-3 py-2" style="border:1px solid var(--md-border); border-radius:var(--md-radius-sm);">
                            <i class="bi bi-instagram"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="md-footer-bottom">
                <span class="md-footer-copy">&copy; @DateTime.Now.Year JAPLearning. Todos os direitos reservados.</span>
                <span class="md-footer-copy">Desenvolvido com <i class="bi bi-heart-fill" style="color:var(--md-accent);"></i> em .NET</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleNav() {
            const nav  = document.querySelector('.md-nav-links');
            const icon = document.getElementById('navToggleIcon');
            const isOpen = nav.classList.toggle('open');
            icon.className = isOpen ? 'bi bi-x-lg' : 'bi bi-list';
        }
        document.addEventListener('click', function (e) {
            const nav = document.querySelector('.md-nav-links');
            const btn = document.getElementById('navToggle');
            if (nav && nav.classList.contains('open') && !nav.contains(e.target) && !btn.contains(e.target)) {
                nav.classList.remove('open');
                document.getElementById('navToggleIcon').className = 'bi bi-list';
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
