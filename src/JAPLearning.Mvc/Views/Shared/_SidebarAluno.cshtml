@{
    var active = ViewData["ActiveMenu"]?.ToString() ?? "";
}

<div class="sidebar-section">
    <p class="sidebar-section-title">Principal</p>
    <a asp-controller="Student" asp-action="Dashboard" class="sidebar-item @(active == "dashboard" ? "active" : "")">
        <i class="bi bi-grid-1x2"></i> Dashboard
    </a>
<a asp-controller="Student" asp-action="MyCertificates" class="sidebar-item @(active == "certificates" ? "active" : "")">
        <i class="bi bi-award"></i> Meus Certificados
    </a>
</div>

<div class="sidebar-section">
    <p class="sidebar-section-title">Conta</p>
    <a asp-controller="Student" asp-action="PersonalData" class="sidebar-item @(active == "profile" ? "active" : "")">
        <i class="bi bi-person"></i> Dados Pessoais
    </a>
    <a asp-controller="Student" asp-action="ChangePassword" class="sidebar-item @(active == "password" ? "active" : "")">
        <i class="bi bi-lock"></i> Alterar Senha
    </a>
</div>

<div class="sidebar-section">
    <p class="sidebar-section-title">Explorar</p>
    <a asp-controller="Student" asp-action="Courses" class="sidebar-item @(active == "courses" ? "active" : "")">
        <i class="bi bi-code-square"></i> Cursos
    </a>
    <a asp-controller="Student" asp-action="Categories" class="sidebar-item @(active == "categories" ? "active" : "")">
        <i class="bi bi-layers"></i> Categorias
    </a>
</div>
