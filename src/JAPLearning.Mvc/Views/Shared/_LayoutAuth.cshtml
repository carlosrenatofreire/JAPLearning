<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — JAPLearning</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mundodev.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body { margin: 0; }

        .auth-wrapper {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── Left panel (branding) ──────────────────────────── */
        .auth-panel-left {
            background: var(--md-bg-secondary);
            border-right: 1px solid var(--md-border);
            display: flex; flex-direction: column;
            justify-content: space-between;
            padding: 40px;
            position: relative; overflow: hidden;
        }
        .auth-panel-left::before {
            content: '';
            position: absolute; top: -100px; right: -100px;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(232,80,26,0.15) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-panel-left::after {
            content: '';
            position: absolute; bottom: -80px; left: -80px;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(200,55,42,0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-brand {
            display: flex; align-items: center; gap: 10px; text-decoration: none;
        }
        .auth-brand .brand-icon {
            width: 36px; height: 36px;
            background: var(--md-gradient);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 15px; color: #fff;
        }
        .auth-brand .brand-name {
            font-size: 20px; font-weight: 800;
            color: var(--md-text-primary); letter-spacing: -0.02em;
        }
        .auth-brand .brand-name span { color: var(--md-accent); }

        /* ── 5-window cascade ───────────────────────────────── */
        .auth-panel-tagline {
            flex: 1; display: flex; flex-direction: column;
            justify-content: center;
            position: relative; z-index: 1;
        }
        .auth-panel-tagline h2 { font-size: 26px; font-weight: 800; line-height: 1.25; margin-bottom: 10px; }
        .auth-panel-tagline p  { font-size: 14px; color: var(--md-text-secondary); line-height: 1.7; margin: 0; }
        .auth-cascade-wrap { display: flex; justify-content: center; margin-bottom: 22px; }
        .auth-cascade { position: relative; width: 424px; height: 348px; flex-shrink: 0; }

        /* Base de cada janela */
        .ahw { position: absolute; width: 236px; height: 280px; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; }
        .ahw-bar { display: flex; align-items: center; gap: 6px; padding: 6px 10px; font-size: 9px; color: #94a3b8; flex-shrink: 0; }
        .ahw-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
        .ahw-body { flex: 1; overflow: hidden; }

        .ahw-excel { top:0;   right:188px; z-index:1; background:#141e2e; border:1px solid rgba(99,102,241,0.45); box-shadow:0 6px 28px rgba(0,0,0,0.55); }
        .ahw-excel .ahw-bar  { background:#1a2640; border-bottom:2px solid rgba(99,102,241,0.35); }
        .ahw-c4    { top:17px; right:141px; z-index:2; background:#0c1322; border:1px solid rgba(232,80,26,0.3);  box-shadow:0 6px 28px rgba(0,0,0,0.5);  }
        .ahw-c4    .ahw-bar  { background:#111827; border-bottom:1px solid rgba(232,80,26,0.25); }
        .ahw-er    { top:34px; right:94px;  z-index:3; background:#0d1a14; border:1px solid rgba(34,197,94,0.35); box-shadow:0 6px 28px rgba(0,0,0,0.48); }
        .ahw-er    .ahw-bar  { background:#0a1510; border-bottom:1px solid rgba(34,197,94,0.25); }
        .ahw-code  { top:51px; right:47px;  z-index:4; background:#1e1e2e; border:1px solid rgba(255,255,255,0.12); box-shadow:0 6px 28px rgba(0,0,0,0.45); }
        .ahw-code  .ahw-bar  { background:#252535; border-bottom:1px solid rgba(255,255,255,0.1); }
        .ahw-dash  { top:68px; right:0;     z-index:5; background:#0f1824; border:1px solid rgba(232,80,26,0.38); box-shadow:0 6px 28px rgba(0,0,0,0.4); }
        .ahw-dash  .ahw-bar  { background:#141e2e; border-bottom:1px solid rgba(232,80,26,0.3); }

        /* Conteúdo: Planilha */
        .sheet-grid { font-family: 'Courier New', monospace; font-size: 10px; }
        .sheet-header-row { display: flex; background: #1a2640; border-bottom: 2px solid rgba(99,102,241,0.3); }
        .sheet-row { display: flex; border-top: 1px solid rgba(255,255,255,0.07); }
        .sheet-row:nth-child(even) { background: rgba(255,255,255,0.025); }
        .sheet-cell-num { width: 20px; min-width: 20px; padding: 4px 4px; color: #64748b; border-right: 2px solid rgba(99,102,241,0.25); text-align: center; background: #1a2640; font-weight: 600; }
        .sheet-cell { flex: 1; padding: 4px 7px; border-right: 1px solid rgba(255,255,255,0.07); color: #94a3b8; white-space: nowrap; overflow: hidden; }
        .sheet-cell.col-hdr { color: #cbd5e1; background: #1a2640; text-align: center; font-weight: 700; border-right: 1px solid rgba(99,102,241,0.2); }
        .sheet-cell.accent { color: #fb923c; font-weight: 600; }
        .sheet-cell.green  { color: #4ade80; font-weight: 600; }
        .sheet-cell.red    { color: #f87171; font-weight: 600; }
        .sheet-cell.bold   { color: #e2e8f0; font-weight: 700; }

        /* Conteúdo: ER */
        .er-body { padding: 10px; font-size: 9px; }
        .er-entity { background: rgba(34,197,94,0.07); border: 1px solid rgba(34,197,94,0.35); border-radius: 5px; overflow: hidden; margin-bottom: 6px; }
        .er-entity-header { background: rgba(34,197,94,0.15); padding: 4px 8px; font-size: 9px; font-weight: 700; color: #4ade80; text-align: center; letter-spacing: .04em; }
        .er-field { display: flex; align-items: center; gap: 5px; padding: 3px 8px; border-top: 1px solid rgba(34,197,94,0.1); color: #94a3b8; font-size: 9px; }
        .er-pk  { color: #fbbf24; font-size: 8px; font-weight: 700; width: 16px; flex-shrink: 0; }
        .er-fk  { color: #818cf8; font-size: 8px; font-weight: 700; width: 16px; flex-shrink: 0; }

        /* Conteúdo: C4 */
        .c4-body { padding: 10px 10px 0; }
        .c4-box { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 5px; padding: 5px 7px; text-align: center; color: #cbd5e1; font-size: 9px; line-height: 1.3; }
        .c4-box.hi { border-color: rgba(232,80,26,0.55); background: rgba(232,80,26,0.08); }
        .c4-lbl { font-size: 8px; color: #475569; margin-top: 2px; }
        .c4-arrow { text-align: center; color: #475569; font-size: 13px; line-height: 1.4; }

        /* Conteúdo: Code */
        .hw-code-body { padding: 12px 14px; font-family: 'Courier New', monospace; font-size: 11px; line-height: 1.7; }
        .cc  { color: #546e7a; font-style: italic; }
        .ck  { color: #c792ea; }
        .ccl { color: #82aaff; }
        .cm  { color: #82aaff; }
        .cs  { color: #c3e88d; }

        /* Conteúdo: Dashboard */
        .hw-dash-body { padding: 10px; }
        .kpi-mini { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 5px; margin-bottom: 8px; }
        .kpi-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 5px; padding: 5px 6px; text-align: center; }
        .kpi-val  { font-size: 13px; font-weight: 800; color: #e2e8f0; display: block; }
        .kpi-lbl  { font-size: 8px; color: #64748b; }
        .dash-chart { background: rgba(255,255,255,0.03); border-radius: 5px; padding: 7px 8px; border: 1px solid rgba(255,255,255,0.06); margin-bottom: 8px; }
        .dash-chart-title { font-size: 8px; color: #64748b; margin-bottom: 5px; }
        .dash-row { display: flex; justify-content: space-between; font-size: 9px; color: #64748b; padding: 3px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }

        .auth-social-proof {
            display: flex; align-items: center; gap: 16px;
            background: var(--md-bg-card); border: 1px solid var(--md-border);
            border-radius: var(--md-radius-lg); padding: 16px 20px;
            position: relative; z-index: 1;
        }
        .auth-social-proof .quote { font-size: 13px; color: var(--md-text-secondary); line-height: 1.6; font-style: italic; }
        .auth-social-proof .author { font-size: 12px; color: var(--md-text-muted); margin-top: 4px; }

        /* Free course cards (used on register panel) */
        .auth-free-intro { flex: 1; display: flex; flex-direction: column; position: relative; z-index: 1; }
        .auth-free-main  { flex: 1; display: flex; flex-direction: column; justify-content: center; }
        .auth-free-intro h2 { font-size: 28px; font-weight: 800; line-height: 1.25; margin-bottom: 8px; }
        .auth-free-intro p  { font-size: 14px; color: var(--md-text-secondary); line-height: 1.6; margin-bottom: 24px; }
        .free-course-card {
            background: var(--md-bg-card); border: 1px solid var(--md-border);
            border-radius: var(--md-radius-lg); padding: 16px 18px; margin-bottom: 12px;
            display: flex; align-items: center; gap: 14px;
            text-decoration: none; transition: var(--md-transition);
            position: relative; overflow: hidden;
        }
        .free-course-card:hover { border-color: var(--md-accent); transform: translateY(-1px); }
        .free-course-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--md-gradient); }
        .free-course-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 900; flex-shrink: 0; }
        .free-course-info { flex: 1; min-width: 0; }
        .free-course-title { font-size: 13px; font-weight: 700; color: var(--md-text-primary); margin: 0 0 4px; line-height: 1.3; }
        .free-course-meta { font-size: 11px; color: var(--md-text-muted); display: flex; align-items: center; gap: 10px; }

        /* ── Right panel (form) ─────────────────────────────── */
        .auth-panel-right {
            display: flex; align-items: center; justify-content: center;
            padding: 40px 24px;
            background: var(--md-bg-primary);
        }
        .auth-form-wrapper { width: 100%; max-width: 420px; }
        .auth-form-title   { font-size: 26px; font-weight: 800; margin-bottom: 6px; }
        .auth-form-subtitle { color: var(--md-text-secondary); font-size: 14px; margin-bottom: 32px; }
        .auth-form-subtitle a { color: var(--md-accent); font-weight: 600; }

        @@media (max-width: 768px) {
            .auth-wrapper { grid-template-columns: 1fr; }
            .auth-panel-left { display: none; }
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">

        <!-- Left Branding Panel -->
        <div class="auth-panel-left">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">&lt;/&gt;</div>
                <span class="brand-name">Mundo<span>Dev</span></span>
            </a>

            @if (IsSectionDefined("AuthLeft"))
            {
                @RenderSection("AuthLeft")
            }
            else
            {
            <div class="auth-panel-tagline">

                <!-- 5-window cascade -->
                <div class="auth-cascade-wrap">
                    <div class="auth-cascade">

                        <!-- Janela 1: Excel -->
                        <div class="ahw ahw-excel">
                            <div class="ahw-bar">
                                <i class="bi bi-file-earmark-excel-fill" style="color:#4ade80;font-size:10px;"></i>
                                <span>KPIs_2024_Q4.xlsx</span>
                            </div>
                            <div class="ahw-body">
                                <div class="sheet-grid">
                                    <div class="sheet-header-row">
                                        <div class="sheet-cell-num"></div>
                                        <div class="sheet-cell col-hdr">A</div>
                                        <div class="sheet-cell col-hdr">B</div>
                                        <div class="sheet-cell col-hdr">C</div>
                                    </div>
                                    <div class="sheet-row"><div class="sheet-cell-num">1</div><div class="sheet-cell bold">Indicador</div><div class="sheet-cell bold">Meta</div><div class="sheet-cell bold">Real</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">2</div><div class="sheet-cell">Vendas</div><div class="sheet-cell">R$ 50k</div><div class="sheet-cell green">R$ 62k</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">3</div><div class="sheet-cell">Churn</div><div class="sheet-cell">3%</div><div class="sheet-cell red">7,2%</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">4</div><div class="sheet-cell">NPS</div><div class="sheet-cell">70</div><div class="sheet-cell accent">68</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">5</div><div class="sheet-cell">Conversão</div><div class="sheet-cell">12%</div><div class="sheet-cell green">14,8%</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">6</div><div class="sheet-cell">CAC</div><div class="sheet-cell">R$ 120</div><div class="sheet-cell red">R$ 189</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">7</div><div class="sheet-cell">LTV</div><div class="sheet-cell">R$ 800</div><div class="sheet-cell green">R$ 1.040</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">8</div><div class="sheet-cell">Ticket Médio</div><div class="sheet-cell">R$ 97</div><div class="sheet-cell accent">R$ 91</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">9</div><div class="sheet-cell">Retenção</div><div class="sheet-cell">90%</div><div class="sheet-cell green">93%</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">10</div><div class="sheet-cell">MRR</div><div class="sheet-cell">R$ 20k</div><div class="sheet-cell red">R$ 16k</div></div>
                                    <div class="sheet-row"><div class="sheet-cell-num">11</div><div class="sheet-cell accent">TOTAL</div><div class="sheet-cell"></div><div class="sheet-cell bold">R$ 79k</div></div>
                                </div>
                            </div>
                        </div>

                        <!-- Janela 2: C4 -->
                        <div class="ahw ahw-c4">
                            <div class="ahw-bar">
                                <i class="bi bi-diagram-3" style="color:var(--md-accent);font-size:10px;"></i>
                                <span>C4 Container Diagram</span>
                            </div>
                            <div class="ahw-body">
                                <div class="c4-body">
                                    <div style="text-align:center; margin-bottom:4px;">
                                        <div class="c4-box" style="display:inline-block; min-width:68px;">
                                            <i class="bi bi-person-fill" style="font-size:14px; color:#94a3b8; display:block;"></i>
                                            <span style="font-size:9px; font-weight:700; color:#cbd5e1;">Usuário</span>
                                            <div class="c4-lbl">[Person]</div>
                                        </div>
                                    </div>
                                    <div class="c4-arrow">↓</div>
                                    <div style="border:1px dashed rgba(232,80,26,0.45); border-radius:7px; padding:6px; margin-bottom:4px;">
                                        <div style="font-size:8px; font-weight:700; color:var(--md-accent); text-align:center; margin-bottom:5px; letter-spacing:.04em;">API APPLICATION</div>
                                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:5px; margin-bottom:5px;">
                                            <div class="c4-box hi">Interface<br/>Web<div class="c4-lbl">[MVC]</div></div>
                                            <div class="c4-box hi">API<br/>.NET Core<div class="c4-lbl">[REST]</div></div>
                                        </div>
                                        <div class="c4-arrow" style="font-size:11px; margin-bottom:4px;">↓</div>
                                        <div class="c4-box" style="font-size:9px; text-align:center;">
                                            <i class="bi bi-database" style="font-size:11px; margin-right:3px;"></i>Banco de Dados
                                            <div class="c4-lbl">[SQL Server]</div>
                                        </div>
                                    </div>
                                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:5px;">
                                        <div class="c4-box" style="font-size:9px;">Database<br/>Service<div class="c4-lbl">[EF Core]</div></div>
                                        <div class="c4-box" style="font-size:9px;">Serviço de<br/>Notificação<div class="c4-lbl">[Events]</div></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Janela 3: ER Diagram -->
                        <div class="ahw ahw-er">
                            <div class="ahw-bar">
                                <i class="bi bi-diagram-2" style="color:#4ade80;font-size:10px;"></i>
                                <span>KpiSystem.dbdiagram</span>
                            </div>
                            <div class="ahw-body">
                                <div class="er-body">
                                    <div class="er-entity">
                                        <div class="er-entity-header">INDICATOR</div>
                                        <div class="er-field"><span class="er-pk">PK</span><span>Id</span><span style="margin-left:auto;color:#475569;">uuid</span></div>
                                        <div class="er-field"><span class="er-pk" style="color:transparent;">·</span><span>Name</span><span style="margin-left:auto;color:#475569;">varchar</span></div>
                                        <div class="er-field"><span class="er-fk">FK</span><span>CategoryId</span><span style="margin-left:auto;color:#475569;">uuid</span></div>
                                        <div class="er-field"><span class="er-pk" style="color:transparent;">·</span><span>GoalValue</span><span style="margin-left:auto;color:#475569;">decimal</span></div>
                                        <div class="er-field"><span class="er-pk" style="color:transparent;">·</span><span>CreatedAt</span><span style="margin-left:auto;color:#475569;">datetime</span></div>
                                    </div>
                                    <div style="display:grid; grid-template-columns:1fr 14px 1fr; align-items:start; gap:4px;">
                                        <div class="er-entity">
                                            <div class="er-entity-header">CATEGORY</div>
                                            <div class="er-field"><span class="er-pk">PK</span><span>Id</span></div>
                                            <div class="er-field"><span class="er-pk" style="color:transparent;">·</span><span>Name</span></div>
                                            <div class="er-field"><span class="er-pk" style="color:transparent;">·</span><span>Color</span></div>
                                        </div>
                                        <div style="display:flex; flex-direction:column; align-items:center; padding-top:20px; gap:18px;">
                                            <span style="color:#34d399; font-size:11px;">⟷</span>
                                            <span style="color:#34d399; font-size:11px;">⟷</span>
                                        </div>
                                        <div class="er-entity">
                                            <div class="er-entity-header">IND_LOG</div>
                                            <div class="er-field"><span class="er-pk">PK</span><span>Id</span></div>
                                            <div class="er-field"><span class="er-fk">FK</span><span>IndId</span></div>
                                            <div class="er-field"><span class="er-pk" style="color:transparent;">·</span><span>Value</span></div>
                                            <div class="er-field"><span class="er-pk" style="color:transparent;">·</span><span>Date</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Janela 4: Code Editor -->
                        <div class="ahw ahw-code">
                            <div class="ahw-bar">
                                <svg width="12" height="12" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
                                    <path fill="#68217A" d="M17 2L7 11 3 7 1 8v8l2 1 4-4 10 9 6-3V5l-6-3zM3 14.5l-1-.5v-4l1-.5v5zm14 1L10 12l7-3.5v7z"/>
                                </svg>
                                <span>IndicatorService.cs</span>
                            </div>
                            <div class="ahw-body">
                                <div class="hw-code-body">
                                    <div><span class="cc">// Negócio → Arquitetura → Código</span></div>
                                    <div><span class="ck">public class</span> <span class="ccl">IndicatorService</span></div>
                                    <div>&nbsp;&nbsp;: <span class="ccl">IIndicatorService</span></div>
                                    <div>{</div>
                                    <div>&nbsp;&nbsp;<span class="ck">private readonly</span> <span class="ccl">IUnitOfWork</span> _uow;</div>
                                    <div>&nbsp;&nbsp;<span class="ck">private readonly</span> <span class="ccl">INotifierService</span> _notifier;</div>
                                    <div>&nbsp;</div>
                                    <div>&nbsp;&nbsp;<span class="ck">public async</span> <span class="ccl">Task</span> <span class="cm">AddAsync</span>(<span class="ccl">IndicatorDto</span> dto)</div>
                                    <div>&nbsp;&nbsp;{</div>
                                    <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="ck">if</span> (!dto.<span class="cm">IsValid</span>()) {</div>
                                    <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;_notifier.<span class="cm">Handle</span>(<span class="cs">"Dados inválidos"</span>);</div>
                                    <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="ck">return</span>;</div>
                                    <div>&nbsp;&nbsp;&nbsp;&nbsp;}</div>
                                    <div>&nbsp;&nbsp;&nbsp;&nbsp;<span class="ck">await</span> _uow.<span class="cm">Commit</span>();</div>
                                    <div>&nbsp;&nbsp;}</div>
                                    <div>}</div>
                                </div>
                            </div>
                        </div>

                        <!-- Janela 5: KPI Dashboard -->
                        <div class="ahw ahw-dash">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:4px;">Painel de Gestão</span>
                            </div>
                            <div class="ahw-body">
                                <div class="hw-dash-body">
                                    <div class="kpi-mini">
                                        <div class="kpi-card"><span class="kpi-val" style="color:#4ade80;">74</span><span class="kpi-lbl">NPS</span></div>
                                        <div class="kpi-card"><span class="kpi-val">83k</span><span class="kpi-lbl">MRR</span></div>
                                        <div class="kpi-card"><span class="kpi-val" style="color:#f87171;">7.2%</span><span class="kpi-lbl">Churn</span></div>
                                    </div>
                                    <div class="dash-chart">
