                            </div>

                            <!-- Slide 5: Dashboard Admin -->
                            <div class="ahc-slide" data-title="Dashboard — Administração — JAP Learning">
                                <div style="padding:10px;height:100%;display:flex;flex-direction:column;gap:7px;overflow:hidden;">
                                    <div style="background:linear-gradient(135deg,rgba(139,92,246,0.1),rgba(232,80,26,0.06));border:1px solid rgba(139,92,246,0.2);border-radius:7px;padding:8px 12px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
                                        <div><div style="font-size:10px;font-weight:800;color:#e2e8f0;margin-bottom:1px;">Olá, Jesus! 👋</div><div style="font-size:7px;color:#64748b;">Painel de gestão JAP Learning.</div></div>
                                        <div style="background:rgba(232,80,26,0.8);border-radius:4px;padding:3px 7px;font-size:6.5px;color:#fff;font-weight:700;">+ Nova Formação</div>
                                    </div>
                                    <div class="kpi-mini" style="grid-template-columns:repeat(5,1fr);">
                                        <div class="kpi-card"><div class="kpi-ico" style="background:rgba(34,197,94,0.1);"><i class="bi bi-people" style="color:#4ade80;font-size:8px;"></i></div><span class="kpi-val" style="font-size:11px;">12</span><span class="kpi-lbl">Alunos</span></div>
                                        <div class="kpi-card"><div class="kpi-ico" style="background:rgba(96,165,250,0.1);"><i class="bi bi-collection-play" style="color:#60a5fa;font-size:8px;"></i></div><span class="kpi-val" style="font-size:11px;">7</span><span class="kpi-lbl">Dispon.</span></div>
                                        <div class="kpi-card"><div class="kpi-ico" style="background:rgba(245,158,11,0.1);"><i class="bi bi-hourglass-split" style="color:#f59e0b;font-size:8px;"></i></div><span class="kpi-val" style="font-size:11px;">5</span><span class="kpi-lbl">Prep.</span></div>
                                        <div class="kpi-card"><div class="kpi-ico" style="background:rgba(232,80,26,0.1);"><i class="bi bi-award" style="color:#fb923c;font-size:8px;"></i></div><span class="kpi-val" style="font-size:11px;">0</span><span class="kpi-lbl">Certif.</span></div>
                                        <div class="kpi-card"><div class="kpi-ico" style="background:rgba(167,139,250,0.1);"><i class="bi bi-diagram-3" style="color:#a78bfa;font-size:8px;"></i></div><span class="kpi-val" style="font-size:11px;">5</span><span class="kpi-lbl">Equip.</span></div>
                                    </div>
                                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;flex:1;overflow:hidden;">
                                        @foreach (var (icon, color, label, rows) in new[]{
                                            ("bi-trophy","#f59e0b","TOP ALUNOS", new[]{("1","Carlos Freire","26"),("2","Vítor Leal","4"),("3","Jesus","2")}),
                                            ("bi-people-fill","#818cf8","TOP EQUIPAS", new[]{("1","DMC Devs","30"),("2","Admins","2"),("","",""),}),
                                            ("bi-collection-play","#60a5fa","TOP FORMAÇÕES", new[]{("1","MVC Avançado","3"),("2","Fund. .NET","2"),("","",""),}),
                                        })
                                        {
                                            <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:5px;overflow:hidden;display:flex;flex-direction:column;">
