<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>JL | @(ViewData["Title"] ?? "JAPLearning")</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mundodev.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body { margin: 0; }

        .auth-wrapper {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── Left panel (branding) ──────────────────────────── */
        .auth-panel-left {
            background: var(--md-bg-secondary);
            border-right: 1px solid var(--md-border);
            display: flex; flex-direction: column;
            justify-content: space-between;
            padding: 40px;
            position: relative; overflow: hidden;
        }
        .auth-panel-left::before {
            content: '';
            position: absolute; top: -100px; right: -100px;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(232,80,26,0.15) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-panel-left::after {
            content: '';
            position: absolute; bottom: -80px; left: -80px;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(200,55,42,0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-brand {
            display: flex; align-items: center; gap: 10px; text-decoration: none;
        }
        .auth-brand .brand-icon {
            width: 36px; height: 36px;
            background: var(--md-gradient);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 15px; color: #fff;
        }
        .auth-brand .brand-name {
            font-size: 20px; font-weight: 800;
            color: var(--md-text-primary); letter-spacing: -0.02em;
        }
        .auth-brand .brand-name span { color: var(--md-accent); }

        /* ── Carrossel auth ── */
        .auth-panel-tagline {
            flex: 1; display: flex; flex-direction: column;
            justify-content: center;
            position: relative; z-index: 1;
            padding: 24px 0 0;
            gap: 28px;
        }
        .auth-panel-tagline h2 { font-size: 26px; font-weight: 800; line-height: 1.25; margin-bottom: 10px; }
        .auth-panel-tagline p  { font-size: 14px; color: var(--md-text-secondary); line-height: 1.7; margin: 0; }

        .auth-carousel-wrap { display: flex; flex-direction: column; align-items: center; gap: 14px; }
        .auth-window {
            width: 100%; max-width: 506px;
            height: 380px;
            border-radius: 10px; overflow: hidden;
            display: flex; flex-direction: column;
            background: #0c1220;
            border: 1px solid rgba(232,80,26,0.3);
            box-shadow: 0 12px 48px rgba(0,0,0,0.6);
        }
        .ahw-bar { display: flex; align-items: center; gap: 6px; padding: 7px 12px; font-size: 9px; color: #94a3b8; background:#101828; border-bottom:1px solid rgba(255,255,255,0.07); flex-shrink:0; }
        .ahw-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

        /* Slides */
        .ahc-slides { position: relative; flex: 1; overflow: hidden; }
        .ahc-slide {
            position: absolute; inset: 0;
            opacity: 0; transform: translateX(24px);
            transition: opacity .4s ease, transform .4s ease;
            pointer-events: none; overflow: hidden;
        }
        .ahc-slide.active  { opacity: 1; transform: translateX(0); pointer-events: auto; }
        .ahc-slide.exit    { opacity: 0; transform: translateX(-24px); }

        /* Paginação */
        .ahc-nav { display: flex; align-items: center; justify-content: center; gap: 12px; }
        .ahc-nav-btn {
            width: 32px; height: 32px; border-radius: 50%;
            background: transparent; border: 1px solid rgba(255,255,255,0.1);
            color: #64748b; cursor: pointer; font-size: 12px;
            display: flex; align-items: center; justify-content: center;
            transition: border-color .2s, color .2s;
        }
        .ahc-nav-btn:hover { border-color: var(--md-accent); color: var(--md-accent); }
        .ahc-nav-btn:disabled { opacity: .3; cursor: not-allowed; }
        .ahc-dots { display: flex; gap: 7px; align-items: center; }
        .ahc-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: rgba(255,255,255,0.15); border: none; padding: 0; cursor: pointer;
            transition: background .2s, transform .2s;
        }
        .ahc-dot.active { background: var(--md-accent); transform: scale(1.3); }

        /* Mini components */
        .kpi-mini { display: grid; gap: 4px; margin-bottom: 7px; }
        .kpi-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 5px; padding: 5px 4px; }
        .kpi-val  { font-size: 12px; font-weight: 900; color: #e2e8f0; display: block; margin-bottom: 1px; }
        .kpi-lbl  { font-size: 6.5px; color: #64748b; line-height: 1.2; }
        .kpi-ico  { width: 18px; height: 18px; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 9px; margin-bottom: 4px; }
        .mod-row  { display: flex; align-items: center; gap: 5px; padding: 3px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
        .course-card-a { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 5px; overflow: hidden; margin-bottom: 5px; }

        /* Free course cards (used on register panel) */
        .auth-free-intro { flex: 1; display: flex; flex-direction: column; position: relative; z-index: 1; }
        .auth-free-main  { flex: 1; display: flex; flex-direction: column; justify-content: center; }
        .auth-free-intro h2 { font-size: 28px; font-weight: 800; line-height: 1.25; margin-bottom: 8px; }
        .auth-free-intro p  { font-size: 14px; color: var(--md-text-secondary); line-height: 1.6; margin-bottom: 24px; }
        .free-course-card {
            background: var(--md-bg-card); border: 1px solid var(--md-border);
            border-radius: var(--md-radius-lg); padding: 16px 18px; margin-bottom: 12px;
            display: flex; align-items: center; gap: 14px;
            text-decoration: none; transition: var(--md-transition);
            position: relative; overflow: hidden;
        }
        .free-course-card:hover { border-color: var(--md-accent); transform: translateY(-1px); }
        .free-course-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--md-gradient); }
        .free-course-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 900; flex-shrink: 0; }
        .free-course-info { flex: 1; min-width: 0; }
        .free-course-title { font-size: 13px; font-weight: 700; color: var(--md-text-primary); margin: 0 0 4px; line-height: 1.3; }
        .free-course-meta { font-size: 11px; color: var(--md-text-muted); display: flex; align-items: center; gap: 10px; }

        /* ── Right panel (form) ─────────────────────────────── */
        .auth-panel-right {
            display: flex; align-items: center; justify-content: center;
            padding: 40px 24px;
            background: var(--md-bg-primary);
        }
        .auth-form-wrapper { width: 100%; max-width: 420px; }
        .auth-form-title   { font-size: 26px; font-weight: 800; margin-bottom: 6px; }
        .auth-form-subtitle { color: var(--md-text-secondary); font-size: 14px; margin-bottom: 32px; }
        .auth-form-subtitle a { color: var(--md-accent); font-weight: 600; }

        @@media (max-width: 768px) {
            .auth-wrapper { grid-template-columns: 1fr; }
            .auth-panel-left { display: none; }
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">

        <!-- Left Branding Panel -->
        <div class="auth-panel-left">
            @if (ViewContext.RouteData.Values["action"]?.ToString() == "ChangePassword")
            {
                <!-- Logo sem link na página de primeiro acesso -->
                <div class="auth-brand" style="cursor:default;">
                    <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
                    <span class="brand-name">JAP<span> Learning</span></span>
                </div>
            }
            else
            {
                <a class="auth-brand" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
                    <span class="brand-name">JAP<span> Learning</span></span>
                </a>
            }

            @if (IsSectionDefined("AuthLeft"))
            {
                @RenderSection("AuthLeft")
            }
            else
            {
            <div class="auth-panel-tagline">

                <!-- Carrossel -->
                <div class="auth-carousel-wrap">
                    <div class="auth-window">
                        <div class="ahw-bar">
                            <span class="ahw-dot" style="background:#ff5f57;"></span>
                            <span class="ahw-dot" style="background:#ffbd2e;"></span>
                            <span class="ahw-dot" style="background:#28ca41;"></span>
                            <span id="ahc-title" style="margin-left:6px;">Catálogo de Formações — JAP Learning</span>
                        </div>
                        <div class="ahc-slides">

                            <!-- Slide 1: Catálogo -->
                            <div class="ahc-slide active" data-title="Catálogo de Formações — JAP Learning">
                                <div style="padding:10px;height:100%;display:flex;flex-direction:column;gap:7px;overflow:hidden;">
                                    <div style="display:flex;gap:4px;flex-wrap:wrap;">
                                        <span style="font-size:7.5px;background:rgba(232,80,26,0.15);border:1px solid rgba(232,80,26,0.4);color:#fb923c;padding:2px 8px;border-radius:10px;font-weight:600;">Todas</span>
                                        <span style="font-size:7.5px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:2px 8px;border-radius:10px;">Onboarding</span>
                                        <span style="font-size:7.5px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:2px 8px;border-radius:10px;">Arquitectura</span>
                                        <span style="font-size:7.5px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:2px 8px;border-radius:10px;">Dev</span>
                                    </div>
                                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;flex:1;overflow:hidden;">
                                        @foreach (var (icon, color, bg, cat, title, meta) in new[]{
                                            ("bi-code-slash","#818cf8","rgba(99,102,241,0.18)","Onboarding","1 - Fundamentos em .NET","16 aulas · 1h 17m"),
                                            ("bi-grid-1x2-fill","#fb923c","rgba(232,80,26,0.18)","Onboarding","2 - ASP.NET Core MVC","22 aulas · 1h 50m"),
                                            ("bi-diagram-3-fill","#60a5fa","rgba(96,165,250,0.12)","Onboarding","3 - ASP.NET WebAPI","34 aulas · 2h 50m"),
                                            ("bi-layers-fill","#a78bfa","rgba(167,139,250,0.12)","Onboarding","4 - MVC Avançado","31 aulas · 6h 8m"),
                                            ("bi-award-fill","#4ade80","rgba(34,197,94,0.1)","Onboarding","5 - POO + SOLID","26 aulas · 4h"),
                                            ("bi-boxes","#f59e0b","rgba(245,158,11,0.1)","Arquitectura","6 - Arq. em Camadas","8 aulas · 2h"),
                                        })
                                        {
                                            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:6px;overflow:hidden;">
                                                <div style="height:26px;background:@bg;display:flex;align-items:center;justify-content:center;">
                                                    <i class="bi @icon" style="color:@color;font-size:12px;"></i>
                                                </div>
                                                <div style="padding:4px 5px;">
                                                    <div style="font-size:6px;background:rgba(232,80,26,0.12);color:#fb923c;padding:1px 4px;border-radius:3px;display:inline-block;margin-bottom:2px;">@cat</div>
                                                    <div style="font-size:7.5px;font-weight:700;color:#e2e8f0;line-height:1.2;margin-bottom:1px;">@title</div>
                                                    <div style="font-size:6.5px;color:#475569;">@meta</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 2: Detalhe da Formação -->
                            <div class="ahc-slide" data-title="4 - ASP.NET Core MVC Avançado — JAP Learning">
                                <div style="display:flex;height:100%;overflow:hidden;">
                                    <div style="flex:1;padding:10px;overflow:hidden;display:flex;flex-direction:column;gap:6px;border-right:1px solid rgba(255,255,255,0.05);">
                                        <div style="height:44px;background:linear-gradient(135deg,rgba(232,80,26,0.18),rgba(167,139,250,0.08));border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <i class="bi bi-grid-1x2-fill" style="color:#fb923c;font-size:18px;"></i>
                                        </div>
                                        <div><div style="font-size:9px;font-weight:800;color:#e2e8f0;margin-bottom:1px;">ASP.NET Core MVC Avançado</div><div style="font-size:7px;color:#64748b;">Carlos Freire · Intermédio</div></div>
                                        <div style="display:flex;gap:6px;border-bottom:1px solid rgba(255,255,255,0.06);padding-bottom:4px;">
                                            <span style="font-size:7.5px;color:#fb923c;border-bottom:1.5px solid #fb923c;padding-bottom:3px;font-weight:700;">Ementa</span>
                                            <span style="font-size:7.5px;color:#475569;">Apresentação</span>
                                            <span style="font-size:7.5px;color:#475569;">Instrutor</span>
                                        </div>
                                        <div style="overflow:hidden;flex:1;">
                                            <div style="font-size:6.5px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px;">INTRODUÇÃO</div>
                                            <div class="mod-row"><i class="bi bi-play-circle-fill" style="color:#fb923c;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#94a3b8;flex:1;">Apresentação e pré-requisitos</span><span style="font-size:6px;color:#475569;">7m</span></div>
                                            <div style="font-size:6.5px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin:4px 0 3px;">MÓDULO 1</div>
                                            <div class="mod-row"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#475569;flex:1;">Pipeline do ASP.NET</span><span style="font-size:6px;color:#334155;">43m</span></div>
                                            <div class="mod-row"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#475569;flex:1;">Ferramentas de Front-end</span><span style="font-size:6px;color:#334155;">26m</span></div>
                                            <div class="mod-row" style="border:none;"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#475569;flex:1;">Bundling e Minication</span><span style="font-size:6px;color:#334155;">26m</span></div>
                                        </div>
                                    </div>
                                    <div style="width:110px;padding:8px;display:flex;flex-direction:column;gap:6px;">
                                        <div style="background:rgba(232,80,26,0.1);border:1px solid rgba(232,80,26,0.3);border-radius:5px;padding:5px 7px;">
                                            <div style="font-size:6.5px;font-weight:700;color:#fb923c;margin-bottom:2px;">FORMAÇÃO</div>
                                            <div style="font-size:7px;color:#e2e8f0;font-weight:600;line-height:1.3;margin-bottom:4px;">ASP.NET Core MVC Avançado</div>
                                            <div style="background:rgba(232,80,26,0.8);border-radius:3px;padding:3px;text-align:center;font-size:6.5px;color:#fff;font-weight:700;">▶ Continuar</div>
                                        </div>
                                        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:5px;padding:5px 7px;">
                                            <div style="font-size:6.5px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">Info</div>
                                            <div style="display:flex;align-items:center;gap:3px;margin-bottom:2px;"><i class="bi bi-clock" style="color:#64748b;font-size:7px;"></i><span style="font-size:7px;color:#64748b;">6h 8m</span></div>
                                            <div style="display:flex;align-items:center;gap:3px;margin-bottom:2px;"><i class="bi bi-collection-play" style="color:#64748b;font-size:7px;"></i><span style="font-size:7px;color:#64748b;">8 módulos</span></div>
                                            <div style="display:flex;align-items:center;gap:3px;"><i class="bi bi-play-btn" style="color:#64748b;font-size:7px;"></i><span style="font-size:7px;color:#64748b;">31 aulas</span></div>
                                        </div>
                                        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:5px;padding:5px 7px;">
                                            <div style="font-size:6.5px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">Pré-Requisitos</div>
                                            <div style="display:flex;align-items:center;gap:3px;margin-bottom:3px;"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:7px;"></i><span style="font-size:6.5px;color:#64748b;">Fundamentos .NET</span></div>
                                            <div style="display:flex;align-items:center;gap:3px;"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:7px;"></i><span style="font-size:6.5px;color:#64748b;">ASP.NET Core MVC</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 3: Player -->
                            <div class="ahc-slide" data-title="Protecção contra CSRF — JAP Learning">
                                <div style="display:flex;height:100%;overflow:hidden;">
                                    <div style="width:120px;border-right:1px solid rgba(255,255,255,0.06);padding:7px;overflow:hidden;display:flex;flex-direction:column;gap:4px;">
                                        <div style="margin-bottom:2px;">
                                            <div style="display:flex;justify-content:space-between;font-size:6px;color:#64748b;margin-bottom:2px;"><span>PROGRESSO</span><span style="color:#fb923c;font-weight:700;">81%</span></div>
                                            <div style="background:rgba(255,255,255,0.06);border-radius:2px;height:3px;"><div style="background:linear-gradient(90deg,#e8501a,#fb923c);width:81%;height:100%;border-radius:2px;"></div></div>
                                        </div>
                                        <div style="font-size:6px;color:#64748b;font-weight:700;text-transform:uppercase;">INTRODUÇÃO</div>
                                        <div class="mod-row" style="border:none;"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:8px;flex-shrink:0;"></i><span style="font-size:7px;color:#64748b;flex:1;">Apresentação</span></div>
                                        <div style="font-size:6px;color:#64748b;font-weight:700;text-transform:uppercase;margin-top:2px;">MÓDULO 1</div>
                                        @foreach (var n in new[]{"Pipeline","Front-end","Bundling","Layouts","Tag Helper","View Component","Roteamento"})
                                        {
                                            <div class="mod-row" style="border:none;"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:8px;flex-shrink:0;"></i><span style="font-size:6.5px;color:#64748b;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@n</span></div>
                                        }
                                    </div>
                                    <div style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
                                        <div style="padding:5px 8px;font-size:6px;color:#475569;border-bottom:1px solid rgba(255,255,255,0.05);">MVC Avançado / <span style="color:#94a3b8;">Protecção CSRF</span></div>
                                        <div style="background:#000;height:110px;position:relative;flex-shrink:0;">
                                            <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(232,80,26,0.1),rgba(0,0,0,0.85));"></div>
                                            <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px;">
                                                <div style="width:28px;height:28px;background:rgba(232,80,26,0.9);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i class="bi bi-play-fill" style="color:#fff;font-size:12px;margin-left:2px;"></i></div>
                                                <span style="font-size:7px;color:rgba(255,255,255,0.6);">Protecção CSRF · 9:14</span>
                                            </div>
                                            <div style="position:absolute;bottom:0;left:0;right:0;padding:3px 7px;background:linear-gradient(transparent,rgba(0,0,0,0.85));">
                                                <div style="background:rgba(255,255,255,0.15);border-radius:2px;height:3px;"><div style="background:#e8501a;width:55%;height:100%;border-radius:2px;"></div></div>
                                                <div style="display:flex;justify-content:space-between;font-size:5.5px;color:rgba(255,255,255,0.4);margin-top:1px;"><span>5:02</span><span>9:14</span></div>
                                            </div>
                                        </div>
                                        <div style="padding:5px 8px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.05);">
                                            <span style="font-size:8px;font-weight:800;color:#e2e8f0;">Protecção contra CSRF</span>
                                            <span style="font-size:6px;background:rgba(34,197,94,0.1);color:#4ade80;padding:2px 5px;border-radius:3px;">✓ Concluída</span>
                                        </div>
                                        <div style="padding:5px 8px;display:flex;gap:5px;">
                                            <div style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.25);border-radius:4px;padding:3px 6px;display:flex;align-items:center;gap:3px;"><i class="bi bi-file-zip" style="color:#818cf8;font-size:8px;"></i><span style="font-size:6.5px;color:#818cf8;">Snapshot</span></div>
                                            <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);border-radius:4px;padding:3px 6px;display:flex;align-items:center;gap:3px;"><i class="bi bi-file-pdf" style="color:#f87171;font-size:8px;"></i><span style="font-size:6.5px;color:#f87171;">PDF</span></div>
                                        </div>
