<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — JAPLearning</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/mundodev.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body { margin: 0; }

        .auth-wrapper {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ── Left panel (branding) ──────────────────────────── */
        .auth-panel-left {
            background: var(--md-bg-secondary);
            border-right: 1px solid var(--md-border);
            display: flex; flex-direction: column;
            justify-content: space-between;
            padding: 40px;
            position: relative; overflow: hidden;
        }
        .auth-panel-left::before {
            content: '';
            position: absolute; top: -100px; right: -100px;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(232,80,26,0.15) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-panel-left::after {
            content: '';
            position: absolute; bottom: -80px; left: -80px;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(200,55,42,0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        .auth-brand {
            display: flex; align-items: center; gap: 10px; text-decoration: none;
        }
        .auth-brand .brand-icon {
            width: 36px; height: 36px;
            background: var(--md-gradient);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 15px; color: #fff;
        }
        .auth-brand .brand-name {
            font-size: 20px; font-weight: 800;
            color: var(--md-text-primary); letter-spacing: -0.02em;
        }
        .auth-brand .brand-name span { color: var(--md-accent); }

        /* ── 4-window cascade ───────────────────────────────── */
        .auth-panel-tagline {
            flex: 1; display: flex; flex-direction: column;
            justify-content: center;
            position: relative; z-index: 1;
        }
        .auth-panel-tagline h2 { font-size: 26px; font-weight: 800; line-height: 1.25; margin-bottom: 10px; }
        .auth-panel-tagline p  { font-size: 14px; color: var(--md-text-secondary); line-height: 1.7; margin: 0; }
        .auth-cascade-wrap { display: flex; justify-content: center; margin-bottom: 22px; }
        .auth-cascade { position: relative; width: 513px; height: 421px; flex-shrink: 0; }

        /* Base de cada janela */
        .ahw { position: absolute; width: 286px; height: 339px; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; }
        .ahw-bar { display: flex; align-items: center; gap: 6px; padding: 6px 10px; font-size: 9px; color: #94a3b8; flex-shrink: 0; }
        .ahw-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
        .ahw-body { flex: 1; overflow: hidden; }

        /* 4 janelas em cascata */
        .ahw-admin   { top:0;    right:171px; z-index:1; background:#0f1824; border:1px solid rgba(232,80,26,0.38); box-shadow:0 6px 28px rgba(0,0,0,0.6); }
        .ahw-admin   .ahw-bar { background:#141e2e; border-bottom:1px solid rgba(232,80,26,0.3); }
        .ahw-catalog { top:28px; right:113px; z-index:2; background:#0c1220; border:1px solid rgba(99,102,241,0.4);  box-shadow:0 6px 28px rgba(0,0,0,0.52); }
        .ahw-catalog .ahw-bar { background:#111827; border-bottom:1px solid rgba(99,102,241,0.3); }
        .ahw-detail  { top:56px; right:57px;  z-index:3; background:#0d1520; border:1px solid rgba(232,80,26,0.32); box-shadow:0 6px 28px rgba(0,0,0,0.48); }
        .ahw-detail  .ahw-bar { background:#121a2a; border-bottom:1px solid rgba(232,80,26,0.25); }
        .ahw-player  { top:84px; right:0;     z-index:4; background:#080e18; border:1px solid rgba(255,255,255,0.12); box-shadow:0 6px 28px rgba(0,0,0,0.45); }
        .ahw-player  .ahw-bar { background:#0d1320; border-bottom:1px solid rgba(255,255,255,0.1); }

        /* Mini components */
        .kpi-mini { display: grid; grid-template-columns: repeat(4,1fr); gap: 4px; margin-bottom: 8px; }
        .kpi-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 4px; padding: 4px 3px; text-align: center; }
        .kpi-val  { font-size: 11px; font-weight: 800; color: #e2e8f0; display: block; }
        .kpi-lbl  { font-size: 6px; color: #64748b; line-height: 1.2; }
        .dash-row { display: flex; justify-content: space-between; font-size: 8px; color: #64748b; padding: 3px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
        .mod-row  { display: flex; align-items: center; gap: 5px; padding: 3px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
        .course-card-a { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 5px; overflow: hidden; margin-bottom: 5px; }

        /* Free course cards (used on register panel) */
        .auth-free-intro { flex: 1; display: flex; flex-direction: column; position: relative; z-index: 1; }
        .auth-free-main  { flex: 1; display: flex; flex-direction: column; justify-content: center; }
        .auth-free-intro h2 { font-size: 28px; font-weight: 800; line-height: 1.25; margin-bottom: 8px; }
        .auth-free-intro p  { font-size: 14px; color: var(--md-text-secondary); line-height: 1.6; margin-bottom: 24px; }
        .free-course-card {
            background: var(--md-bg-card); border: 1px solid var(--md-border);
            border-radius: var(--md-radius-lg); padding: 16px 18px; margin-bottom: 12px;
            display: flex; align-items: center; gap: 14px;
            text-decoration: none; transition: var(--md-transition);
            position: relative; overflow: hidden;
        }
        .free-course-card:hover { border-color: var(--md-accent); transform: translateY(-1px); }
        .free-course-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--md-gradient); }
        .free-course-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 900; flex-shrink: 0; }
        .free-course-info { flex: 1; min-width: 0; }
        .free-course-title { font-size: 13px; font-weight: 700; color: var(--md-text-primary); margin: 0 0 4px; line-height: 1.3; }
        .free-course-meta { font-size: 11px; color: var(--md-text-muted); display: flex; align-items: center; gap: 10px; }

        /* ── Right panel (form) ─────────────────────────────── */
        .auth-panel-right {
            display: flex; align-items: center; justify-content: center;
            padding: 40px 24px;
            background: var(--md-bg-primary);
        }
        .auth-form-wrapper { width: 100%; max-width: 420px; }
        .auth-form-title   { font-size: 26px; font-weight: 800; margin-bottom: 6px; }
        .auth-form-subtitle { color: var(--md-text-secondary); font-size: 14px; margin-bottom: 32px; }
        .auth-form-subtitle a { color: var(--md-accent); font-weight: 600; }

        @@media (max-width: 768px) {
            .auth-wrapper { grid-template-columns: 1fr; }
            .auth-panel-left { display: none; }
        }
    </style>
</head>
<body>
    <div class="auth-wrapper">

        <!-- Left Branding Panel -->
        <div class="auth-panel-left">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
                <span class="brand-name">JAP<span> Learning</span></span>
            </a>

            @if (IsSectionDefined("AuthLeft"))
            {
                @RenderSection("AuthLeft")
            }
            else
            {
            <div class="auth-panel-tagline">

                <!-- 4-window cascade -->
                <div class="auth-cascade-wrap">
                    <div class="auth-cascade">

                        <!-- Janela 1 (fundo): Dashboard Admin -->
                        <div class="ahw ahw-admin">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:4px;">Dashboard — Administração</span>
                            </div>
                            <div class="ahw-body" style="padding:8px;">
                                <div class="kpi-mini">
                                    <div class="kpi-card"><span class="kpi-val" style="color:#4ade80;">48</span><span class="kpi-lbl">Colaboradores</span></div>
                                    <div class="kpi-card"><span class="kpi-val" style="color:#60a5fa;">12</span><span class="kpi-lbl">Formações</span></div>
                                    <div class="kpi-card"><span class="kpi-val" style="color:#f59e0b;">27</span><span class="kpi-lbl">Certificados</span></div>
                                    <div class="kpi-card"><span class="kpi-val" style="color:#a78bfa;">4</span><span class="kpi-lbl">Equipas</span></div>
                                </div>
                                <div style="display:flex;gap:3px;margin-bottom:7px;">
                                    <div style="flex:1;background:rgba(232,80,26,0.1);border:1px solid rgba(232,80,26,0.25);border-radius:4px;padding:4px 3px;text-align:center;">
                                        <i class="bi bi-person-plus" style="color:#e8501a;font-size:10px;display:block;margin-bottom:1px;"></i>
                                        <span style="font-size:6px;color:#94a3b8;">Colaborador</span>
                                    </div>
                                    <div style="flex:1;background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.2);border-radius:4px;padding:4px 3px;text-align:center;">
                                        <i class="bi bi-collection-play" style="color:#818cf8;font-size:10px;display:block;margin-bottom:1px;"></i>
                                        <span style="font-size:6px;color:#94a3b8;">Formação</span>
                                    </div>
                                    <div style="flex:1;background:rgba(34,197,94,0.07);border:1px solid rgba(34,197,94,0.2);border-radius:4px;padding:4px 3px;text-align:center;">
                                        <i class="bi bi-newspaper" style="color:#4ade80;font-size:10px;display:block;margin-bottom:1px;"></i>
                                        <span style="font-size:6px;color:#94a3b8;">Artigo</span>
                                    </div>
                                    <div style="flex:1;background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.2);border-radius:4px;padding:4px 3px;text-align:center;">
                                        <i class="bi bi-people" style="color:#f59e0b;font-size:10px;display:block;margin-bottom:1px;"></i>
                                        <span style="font-size:6px;color:#94a3b8;">Equipa</span>
                                    </div>
                                </div>
                                <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:4px;overflow:hidden;margin-bottom:7px;">
                                    <div class="dash-row" style="padding:3px 7px;background:rgba(255,255,255,0.03);"><span style="font-weight:700;color:#cbd5e1;">Módulo</span><span style="font-weight:700;color:#cbd5e1;">Total</span></div>
                                    <div class="dash-row" style="padding:3px 7px;"><span>Colaboradores</span><span style="color:#4ade80;">48</span></div>
                                    <div class="dash-row" style="padding:3px 7px;"><span>Formações</span><span style="color:#60a5fa;">12</span></div>
                                    <div class="dash-row" style="padding:3px 7px;"><span>Categorias</span><span style="color:#a78bfa;">9</span></div>
                                    <div class="dash-row" style="padding:3px 7px;border:none;"><span>Certificados</span><span style="color:#f59e0b;">27</span></div>
                                </div>
                                <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.05);border-radius:4px;padding:5px 7px;">
                                    <div style="font-size:7px;color:#64748b;margin-bottom:3px;">Progresso por equipa — Mai 2026</div>
                                    <svg viewBox="0 0 200 30" style="width:100%;height:26px;display:block;">
                                        <defs><linearGradient id="lag1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#e8501a" stop-opacity="0.3"/><stop offset="100%" stop-color="#e8501a" stop-opacity="0"/></linearGradient></defs>
                                        <polygon points="0,30 0,24 33,20 66,15 100,10 133,6 166,3 200,1 200,30" fill="url(#lag1)"/>
                                        <polyline points="0,24 33,20 66,15 100,10 133,6 166,3 200,1" fill="none" stroke="#e8501a" stroke-width="1.5" stroke-linejoin="round"/>
                                        <circle cx="200" cy="1" r="2" fill="#4ade80"/>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- Janela 2: Lista de Formações -->
                        <div class="ahw ahw-catalog">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:4px;">Formações — JAP Learning</span>
                            </div>
                            <div class="ahw-body" style="padding:8px;">
                                <div style="display:flex;gap:3px;margin-bottom:7px;flex-wrap:wrap;">
                                    <span style="font-size:7px;background:rgba(232,80,26,0.15);border:1px solid rgba(232,80,26,0.4);color:#fb923c;padding:2px 6px;border-radius:8px;">Todas</span>
                                    <span style="font-size:7px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:2px 6px;border-radius:8px;">DevOps</span>
                                    <span style="font-size:7px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:2px 6px;border-radius:8px;">BI & Dados</span>
                                    <span style="font-size:7px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:2px 6px;border-radius:8px;">RH</span>
                                </div>
                                <div class="course-card-a">
                                    <div style="height:30px;background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(139,92,246,0.1));display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-bar-chart-fill" style="color:#818cf8;font-size:13px;"></i>
                                    </div>
                                    <div style="padding:5px 6px;">
                                        <div style="display:flex;gap:3px;margin-bottom:2px;">
                                            <span style="font-size:6px;background:rgba(99,102,241,0.15);color:#818cf8;padding:1px 4px;border-radius:3px;">BI & Dados</span>
                                            <span style="font-size:6px;background:rgba(245,158,11,0.12);color:#f59e0b;padding:1px 4px;border-radius:3px;">Intermédio</span>
                                        </div>
                                        <div style="font-size:8px;font-weight:700;color:#e2e8f0;">Power BI Essencial</div>
                                        <div style="font-size:7px;color:#64748b;">João Silva · 8 aulas</div>
                                    </div>
                                </div>
                                <div class="course-card-a">
                                    <div style="height:30px;background:linear-gradient(135deg,rgba(232,80,26,0.18),rgba(160,31,58,0.1));display:flex;align-items:center;justify-content:center;">
                                        <i class="bi bi-gear-fill" style="color:#fb923c;font-size:13px;"></i>
                                    </div>
                                    <div style="padding:5px 6px;">
                                        <div style="display:flex;gap:3px;margin-bottom:2px;">
                                            <span style="font-size:6px;background:rgba(232,80,26,0.15);color:#fb923c;padding:1px 4px;border-radius:3px;">DevOps</span>
                                            <span style="font-size:6px;background:rgba(34,197,94,0.1);color:#4ade80;padding:1px 4px;border-radius:3px;">Avançado</span>
                                        </div>
                                        <div style="font-size:8px;font-weight:700;color:#e2e8f0;">CI/CD com GitHub Actions</div>
                                        <div style="font-size:7px;color:#64748b;">Ana Pereira · 12 aulas</div>
                                    </div>
                                </div>
                                <div class="course-card-a" style="opacity:.55;">
                                    <div style="padding:5px 6px;">
                                        <div style="font-size:8px;font-weight:700;color:#94a3b8;">Gestão de Projectos Ágeis</div>
                                        <div style="font-size:7px;color:#475569;">RH · 6 aulas</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Janela 3: Detalhe da Formação -->
                        <div class="ahw ahw-detail">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:4px;">Power BI Essencial — JAP Learning</span>
                            </div>
                            <div class="ahw-body" style="padding:8px;">
                                <div style="height:38px;background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(139,92,246,0.1));border-radius:4px;display:flex;align-items:center;justify-content:center;margin-bottom:6px;">
                                    <i class="bi bi-bar-chart-fill" style="color:#818cf8;font-size:18px;"></i>
                                </div>
                                <div style="font-size:10px;font-weight:800;color:#e2e8f0;margin-bottom:2px;">Power BI Essencial</div>
                                <div style="display:flex;gap:3px;margin-bottom:5px;">
                                    <span style="font-size:6px;background:rgba(99,102,241,0.15);color:#818cf8;padding:1px 4px;border-radius:3px;">BI & Dados</span>
                                    <span style="font-size:6px;background:rgba(245,158,11,0.12);color:#f59e0b;padding:1px 4px;border-radius:3px;">Intermédio</span>
                                </div>
                                <div style="margin-bottom:6px;">
                                    <div style="display:flex;justify-content:space-between;font-size:7px;color:#64748b;margin-bottom:2px;"><span>Progresso</span><span style="color:#60a5fa;">3 / 8 aulas</span></div>
                                    <div style="background:rgba(255,255,255,0.06);border-radius:3px;height:4px;overflow:hidden;">
                                        <div style="background:linear-gradient(90deg,#e8501a,#fb923c);width:37%;height:100%;border-radius:3px;"></div>
                                    </div>
                                </div>
                                <div style="font-size:6px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;">Módulo 1 — Introdução</div>
                                <div class="mod-row"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#94a3b8;flex:1;">O que é o Power BI</span><span style="font-size:6px;color:#475569;">18m</span></div>
                                <div class="mod-row"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#94a3b8;flex:1;">Interface e navegação</span><span style="font-size:6px;color:#475569;">22m</span></div>
                                <div class="mod-row" style="background:rgba(232,80,26,0.06);border-radius:3px;padding:3px 4px;border:none;">
                                    <i class="bi bi-play-circle-fill" style="color:#fb923c;font-size:9px;flex-shrink:0;"></i>
                                    <span style="font-size:7px;color:#e2e8f0;font-weight:700;flex:1;">Importar dados</span>
                                    <span style="font-size:6px;color:#fb923c;">▶ A ver</span>
                                </div>
                                <div style="font-size:6px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin:5px 0 3px;">Módulo 2 — Visualizações</div>
                                <div class="mod-row"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#475569;flex:1;">Gráficos e tabelas</span><span style="font-size:6px;color:#334155;">35m</span></div>
                                <div class="mod-row" style="border:none;"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#475569;flex:1;">Filtros e segmentação</span><span style="font-size:6px;color:#334155;">28m</span></div>
                            </div>
                        </div>

                        <!-- Janela 4 (frente): Player de Aula -->
                        <div class="ahw ahw-player">
                            <div class="ahw-bar">
                                <span class="ahw-dot" style="background:#ff5f57;"></span>
                                <span class="ahw-dot" style="background:#ffbd2e;"></span>
                                <span class="ahw-dot" style="background:#28ca41;"></span>
                                <span style="margin-left:4px;">Aula: Importar dados — JAP Learning</span>
                            </div>
                            <div class="ahw-body" style="display:flex;flex-direction:column;">
                                <div style="background:#000;height:90px;display:flex;align-items:center;justify-content:center;position:relative;flex-shrink:0;">
                                    <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(99,102,241,0.15),rgba(0,0,0,0.8));"></div>
                                    <div style="position:relative;z-index:1;text-align:center;">
                                        <div style="width:26px;height:26px;background:rgba(232,80,26,0.9);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 4px;">
                                            <i class="bi bi-play-fill" style="color:#fff;font-size:11px;margin-left:2px;"></i>
                                        </div>
                                        <span style="font-size:7px;color:rgba(255,255,255,0.6);">Importar dados · 25m</span>
                                    </div>
                                    <div style="position:absolute;bottom:0;left:0;right:0;padding:3px 7px;background:linear-gradient(transparent,rgba(0,0,0,0.8));">
                                        <div style="background:rgba(255,255,255,0.15);border-radius:2px;height:3px;">
                                            <div style="background:#e8501a;width:42%;height:100%;border-radius:2px;"></div>
                                        </div>
                                        <div style="display:flex;justify-content:space-between;font-size:6px;color:rgba(255,255,255,0.4);margin-top:1px;"><span>10:30</span><span>25:00</span></div>
                                    </div>
                                </div>
                                <div style="flex:1;overflow:hidden;padding:7px;">
                                    <div style="font-size:6px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">Conteúdo da Formação</div>
                                    <div style="background:rgba(232,80,26,0.1);border:1px solid rgba(232,80,26,0.25);border-radius:3px;padding:4px 5px;margin-bottom:3px;display:flex;align-items:center;gap:4px;">
                                        <i class="bi bi-play-circle-fill" style="color:#fb923c;font-size:9px;flex-shrink:0;"></i>
                                        <span style="font-size:7px;font-weight:600;color:#e2e8f0;flex:1;">Importar dados</span>
                                        <span style="font-size:6px;color:#fb923c;">▶</span>
                                    </div>
                                    <div class="mod-row"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#64748b;flex:1;">O que é o Power BI</span><i class="bi bi-check" style="color:#4ade80;font-size:8px;"></i></div>
                                    <div class="mod-row"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#64748b;flex:1;">Interface e navegação</span><i class="bi bi-check" style="color:#4ade80;font-size:8px;"></i></div>
                                    <div class="mod-row"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#475569;flex:1;">Gráficos e tabelas</span><span style="font-size:6px;color:#334155;">35m</span></div>
                                    <div class="mod-row" style="border:none;"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7px;color:#475569;flex:1;">Filtros e segmentação</span><span style="font-size:6px;color:#334155;">28m</span></div>
                                    <div style="margin-top:6px;background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.2);border-radius:3px;padding:4px 5px;display:flex;align-items:center;gap:4px;">
                                        <i class="bi bi-trophy" style="color:#f59e0b;font-size:9px;flex-shrink:0;"></i>
                                        <span style="font-size:6px;color:#94a3b8;">Nota de aprovação: <strong style="color:#f59e0b;">70%</strong></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <h2>
                    Desenvolve as competências<br />
                    <span class="md-gradient-text">da tua equipa.</span>
                </h2>
                <p>
                    Formações práticas organizadas por equipa, acompanhamento
                    de progresso e certificados digitais — tudo numa só plataforma.
                </p>
            </div>
            }
        </div>

        <!-- Right Form Panel -->
        <div class="auth-panel-right">
            <div class="auth-form-wrapper">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
