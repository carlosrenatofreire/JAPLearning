                                                @foreach (var (n, name, count) in rows.Where(r => r.Item2 != ""))
                                                {
                                                    <div style="padding:3px 7px;border-bottom:1px solid rgba(255,255,255,0.03);display:flex;align-items:center;gap:4px;">
                                                        <span style="font-size:6.5px;color:#475569;width:7px;">@n</span>
                                                        <span style="font-size:7px;color:#94a3b8;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@name</span>
                                                        <span style="font-size:7px;color:@color;font-weight:700;">@count</span>
                                                    </div>
                                                }
                                                <div style="padding:3px 7px;text-align:right;margin-top:auto;"><span style="font-size:6.5px;color:#334155;">Ver todos →</span></div>
                                            </div>
