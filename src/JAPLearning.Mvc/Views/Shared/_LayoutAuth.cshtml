                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Paginação -->
                    <div class="ahc-nav">
                        <button class="ahc-nav-btn" id="ahc-prev" onclick="ahcNav(-1)" disabled><i class="bi bi-chevron-left"></i></button>
                        <div class="ahc-dots">
                            <button class="ahc-dot active" onclick="ahcGo(0)"></button>
                            <button class="ahc-dot" onclick="ahcGo(1)"></button>
                            <button class="ahc-dot" onclick="ahcGo(2)"></button>
                            <button class="ahc-dot" onclick="ahcGo(3)"></button>
                            <button class="ahc-dot" onclick="ahcGo(4)"></button>
                        </div>
                        <button class="ahc-nav-btn" id="ahc-next" onclick="ahcNav(1)"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>

                <!-- Texto (logo > carrossel > texto) -->
                <div style="padding-top:24px;">
