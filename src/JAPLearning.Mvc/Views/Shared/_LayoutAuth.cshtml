                                                <div style="font-size:6.5px;color:#475569;margin-bottom:4px;">25 de 31 aulas</div>
                                                <div style="background:rgba(255,255,255,0.06);border-radius:2px;height:3px;overflow:hidden;"><div style="background:linear-gradient(90deg,#e8501a,#fb923c);width:81%;height:100%;border-radius:2px;"></div></div>
                                                <div style="text-align:right;font-size:6px;color:#fb923c;margin-top:1px;font-weight:700;">81%</div>
