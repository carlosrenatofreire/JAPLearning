        <!-- Right Form Panel -->
        <div class="auth-panel-right">
            <div class="auth-form-wrapper">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    (function () {
        var slides  = Array.from(document.querySelectorAll('.ahc-slide'));
        var dots    = Array.from(document.querySelectorAll('.ahc-dot'));
        var titleEl = document.getElementById('ahc-title');
        var btnPrev = document.getElementById('ahc-prev');
        var btnNext = document.getElementById('ahc-next');
        if (!slides.length) return;
        var current = 0, total = slides.length, timer;

        function goTo(idx) {
            slides[current].classList.remove('active');
            slides[current].classList.add('exit');
            dots[current].classList.remove('active');
            var prev = current;
            current = (idx + total) % total;
            slides[current].classList.add('active');
            dots[current].classList.add('active');
            if (titleEl) titleEl.textContent = slides[current].dataset.title;
            btnPrev.disabled = current === 0;
            btnNext.disabled = current === total - 1;
            setTimeout(function () { slides[prev].classList.remove('exit'); }, 420);
        }
        function startAuto() { timer = setInterval(function () { goTo(current < total - 1 ? current + 1 : 0); }, 4000); }
        function stopAuto()  { clearInterval(timer); }

        window.ahcNav = function (d) { stopAuto(); goTo(current + d); };
        window.ahcGo  = function (i) { stopAuto(); goTo(i); };

        startAuto();
        var wrap = document.querySelector('.auth-carousel-wrap');
        if (wrap) {
            wrap.addEventListener('mouseenter', stopAuto);
            wrap.addEventListener('mouseleave', startAuto);
        }
    })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
