@model JAPLearning.Mvc.ViewModels.Parameters.CategoryViewModel
@{
    ViewData["Title"] = "Nova Categoria";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Nova Categoria</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-text-muted);">Categorias</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> Nova</p>
    </div>
</div>

<div class="md-card form-card" style="max-width:100%;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="row g-3">

            <!-- Linha 1: Equipa + Nome + Activo -->
            <div class="col-md-4">
                <div class="md-form-row">
                    <label asp-for="TeamId" class="md-label">Equipa</label>
                    <select asp-for="TeamId" asp-items="ViewBag.Teams" class="md-select">
                        <option value="">Seleccionar equipa...</option>
                    </select>
                    <span asp-validation-for="TeamId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="Name" class="md-label"></label>
                    <input asp-for="Name" class="md-input" placeholder="Nome da categoria" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-2" style="display:flex; align-items:flex-end; padding-bottom:4px;">
                <div class="md-form-check">
                    <input asp-for="IsActived" type="checkbox" />
                    <label asp-for="IsActived">Activo</label>
                </div>
            </div>

            <!-- Linha 2: Subtítulo + Descrição -->
            <div class="col-md-5">
                <div class="md-form-row">
                    <label asp-for="Subtitle" class="md-label"></label>
                    <input asp-for="Subtitle" class="md-input" placeholder="ex: A base que todo arquiteto precisa" />
                </div>
            </div>
            <div class="col-md-7">
                <div class="md-form-row">
                    <label asp-for="Description" class="md-label"></label>
                    <textarea asp-for="Description" class="md-input" rows="4" placeholder="Descrição opcional"></textarea>
                </div>
            </div>

        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>
