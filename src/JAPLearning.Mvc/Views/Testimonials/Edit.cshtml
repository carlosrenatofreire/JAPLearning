@model JAPLearning.Mvc.ViewModels.Entities.TestimonialViewModel
@{
    ViewData["Title"] = "Editar Testemunho";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Testemunho</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Testemunhos</a> / Editar</p>
    </div>
</div>

<div class="md-card" style="max-width:760px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="md-label">Nome do Autor <span class="text-danger">*</span></label>
                <input asp-for="AuthorName" class="md-input" />
            </div>
            <div class="col-md-6">
                <label class="md-label">Cargo / Papel</label>
                <input asp-for="Role" class="md-input" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="md-label">Cidade</label>
                <input asp-for="City" class="md-input" />
            </div>
            <div class="col-md-4">
                <label class="md-label">País</label>
                <input asp-for="Country" class="md-input" />
            </div>
            <div class="col-md-4">
                <label class="md-label">Avaliação (1-5)</label>
                <input asp-for="Rating" type="number" class="md-input" min="1" max="5" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <div class="md-form-row">
                    <label class="md-label">Foto do Autor</label>
                    <div id="photoPreviewWrap" style="margin-bottom:8px;">
                        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
                        {
                            <img id="photoPreview" src="@Model.PhotoUrl" alt="Foto actual"
                                 style="width:64px; height:64px; border-radius:50%; object-fit:cover; border:2px solid var(--md-border);" />
                            <small id="photoLabel" style="display:block; color:var(--md-text-muted); font-size:11px; margin-top:4px;">Foto actual — seleccione nova para substituir</small>
                        }
                        else
                        {
                            <img id="photoPreview" src="" alt="Preview"
                                 style="width:64px; height:64px; border-radius:50%; object-fit:cover; border:2px solid var(--md-border); display:none;" />
                            <small id="photoLabel" style="display:none; color:var(--md-text-muted); font-size:11px; margin-top:4px;">Pré-visualização</small>
                        }
                    </div>
                    <input type="hidden" asp-for="PhotoUrl" />
                    <input type="file" id="photoInput" name="photo" accept="image/jpeg,image/png,image/webp" class="md-input" style="padding:6px;" />
                    <small style="color:var(--md-text-muted); font-size:11px;">Formatos aceites: JPG, PNG, WebP — deixe em branco para manter a actual</small>
                </div>
            </div>
            <div class="col-md-6">
                <label class="md-label">LinkedIn URL</label>
                <input asp-for="LinkedinUrl" class="md-input" />
            </div>
        </div>

        <div class="mb-3">
            <label class="md-label">Depoimento</label>
            <textarea asp-for="Quote" class="md-input" rows="3"></textarea>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-auto">
                <label class="md-form-check">
                    <input asp-for="Featured" type="checkbox" />
                    <span><i class="bi bi-bookmark-star"></i> Em destaque</span>
                </label>
            </div>
            <div class="col-auto">
                <label class="md-form-check">
                    <input asp-for="IsActived" type="checkbox" />
                    <span>Activo</span>
                </label>
            </div>
        </div>

        <div style="display:flex; gap:12px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    document.getElementById('photoInput').addEventListener('change', function () {
        const file  = this.files[0];
        if (!file) return;
        const img   = document.getElementById('photoPreview');
        const label = document.getElementById('photoLabel');
        img.src = URL.createObjectURL(file);
        img.style.display   = 'block';
        label.style.display = 'block';
        label.textContent   = 'Nova foto seleccionada';
    });
</script>
}
