@model JAPLearning.Mvc.ViewModels.Entities.TestimonialViewModel
@{
    ViewData["Title"] = "Novo Testemunho";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Novo Testemunho</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Testemunhos</a> / Criar</p>
    </div>
</div>

<div class="md-card form-card" style="max-width:100%;">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="row g-3">

            <!-- ── Linha 1: Nome + Cargo + Cidade + País ────────── -->
            <div class="col-md-4">
                <label class="md-label">Nome do Autor <span class="text-danger">*</span></label>
                <input asp-for="AuthorName" class="md-input" placeholder="Nome completo" />
                <span asp-validation-for="AuthorName" class="text-danger" style="font-size:12px;"></span>
            </div>
            <div class="col-md-4">
                <label class="md-label">Cargo / Papel</label>
                <input asp-for="Role" class="md-input" placeholder="ex: Developer Full-Stack" />
            </div>
            <div class="col-md-2">
                <label class="md-label">Cidade</label>
                <input asp-for="City" class="md-input" placeholder="Lisboa" />
            </div>
            <div class="col-md-2">
                <label class="md-label">País</label>
                <input asp-for="Country" class="md-input" placeholder="Portugal" />
            </div>

            <!-- ── Linha 2: Avaliação + LinkedIn + Checkboxes ───── -->
            <div class="col-md-2">
                <label class="md-label">Avaliação (1-5)</label>
                <input asp-for="Rating" type="number" class="md-input" min="1" max="5" />
            </div>
            <div class="col-md-6">
                <label class="md-label">LinkedIn URL</label>
                <input asp-for="LinkedinUrl" class="md-input" placeholder="https://linkedin.com/in/..." />
            </div>
            <div class="col-md-4" style="display:flex; align-items:flex-end; gap:12px; padding-bottom:4px;">
                <label class="md-form-check" style="flex:1;">
                    <input asp-for="Featured" type="checkbox" />
                    <span><i class="bi bi-bookmark-star"></i> Em destaque</span>
                </label>
                <label class="md-form-check" style="flex:1;">
                    <input asp-for="IsActived" type="checkbox" />
                    <span>Activo</span>
                </label>
            </div>

            <!-- ── Linha 3: Foto + Depoimento ───────────────────── -->
            <div class="col-md-3">
                <label class="md-label">Foto do Autor</label>
                <div id="photoPreviewWrap" style="display:none; margin-bottom:10px; text-align:center;">
                    <img id="photoPreview" src="" alt="Preview"
                         style="width:72px; height:72px; border-radius:50%; object-fit:cover; border:2px solid var(--md-border);" />
                    <small style="display:block; color:var(--md-text-muted); font-size:11px; margin-top:4px;">Pré-visualização</small>
                </div>
                <input type="file" id="photoInput" name="photo" accept="image/jpeg,image/png,image/webp"
                       class="md-input" style="padding:6px;" />
                <small style="color:var(--md-text-muted); font-size:11px;">JPG, PNG ou WebP</small>
            </div>
            <div class="col-md-9">
                <label class="md-label">Depoimento <span class="text-danger">*</span></label>
                <textarea asp-for="Quote" class="md-input" rows="5"
                          placeholder="Texto do testemunho..."></textarea>
                <span asp-validation-for="Quote" class="text-danger" style="font-size:12px;"></span>
            </div>

        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    document.getElementById('photoInput').addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const wrap = document.getElementById('photoPreviewWrap');
        const img  = document.getElementById('photoPreview');
        img.src = URL.createObjectURL(file);
        wrap.style.display = 'block';
    });
</script>
}
