@model JAPLearning.Mvc.ViewModels.Entities.CourseViewModel
@using JAPLearning.Business.Models.Domains.Relationships
@using JAPLearning.Business.Models.Domains.Parameters
@{
    ViewData["Title"] = "Editar Formação";
    var requirements     = ViewBag.Requirements     as List<CourseRequirement> ?? new();
    var availableCourses = ViewBag.AvailableCourses as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var categoriesFull   = ViewBag.CategoriesFull   as List<Category> ?? new();
    var selectedTeamId   = ViewBag.SelectedTeamId   as Guid?;
}
@await Html.PartialAsync("_CrudStyles")

<style>
    .tab-bar {
        display: flex;
        gap: 0;
        border-bottom: 2px solid var(--md-border);
        margin-bottom: 28px;
    }
    .tab-btn {
        padding: 11px 22px;
        font-size: 13px;
        font-weight: 600;
        color: var(--md-text-muted);
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 7px;
        transition: color .15s, border-color .15s;
    }
    .tab-btn:hover { color: var(--md-text-primary); }
    .tab-btn.active {
        color: var(--md-accent);
        border-bottom-color: var(--md-accent);
    }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }
</style>

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Formação</h4>
        <p class="page-header-sub">
            <a asp-action="Index" style="color:var(--md-text-muted);">Formações</a>
            <i class="bi bi-chevron-right" style="font-size:10px;"></i> Editar
        </p>
    </div>
</div>

<div class="md-card">

    <!-- ── Tabs ──────────────────────────────────────────────────────── -->
    <div class="tab-bar">
        <button type="button" class="tab-btn active" onclick="switchTab('dados', this)">
            <i class="bi bi-card-text"></i> Dados
        </button>
        <button type="button" class="tab-btn" onclick="switchTab('uploads', this)">
            <i class="bi bi-cloud-upload"></i> Uploads
            @if (!string.IsNullOrWhiteSpace(Model.SnapshotUrl) || !string.IsNullOrWhiteSpace(Model.PdfFileUrl))
            {
                <span style="width:7px;height:7px;border-radius:50%;background:var(--md-success);display:inline-block;"></span>
            }
        </button>
        <button type="button" class="tab-btn" onclick="switchTab('prereqs', this)">
            <i class="bi bi-diagram-3"></i> Pré-Requisitos
            @if (requirements.Any())
            {
                <span style="background:var(--md-accent);color:#fff;font-size:10px;font-weight:800;
                             padding:1px 6px;border-radius:10px;line-height:1.6;">@requirements.Count</span>
            }
        </button>
    </div>

    <!-- ── Form (Dados + Uploads partilham o mesmo form) ─────────────── -->
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="courseForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Thumbnail" />
        <input type="hidden" asp-for="SnapshotUrl" />
        <input type="hidden" asp-for="PdfFileUrl" />
        <input type="hidden" asp-for="CreatedDate" />
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <!-- ══ TAB: DADOS ══════════════════════════════════════════════ -->
        <div id="tab-dados" class="tab-pane active">
            <div class="row g-3">

                <!-- Título + Nota de Aprovação -->
                <div class="col-md-8">
                    <div class="md-form-row">
                        <label asp-for="Title" class="md-label">Título</label>
                        <input asp-for="Title" class="md-input" placeholder="Título da formação" />
                        <span asp-validation-for="Title" class="text-danger" style="font-size:12px;"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="md-form-row">
                        <label asp-for="PassingScore" class="md-label">Nota de Aprovação (%)</label>
                        <input asp-for="PassingScore" class="md-input" type="number" min="0" max="100" />
                    </div>
                </div>

                <!-- Subtítulo + Nível -->
                <div class="col-md-8">
                    <div class="md-form-row">
                        <label asp-for="Subtitle" class="md-label">Subtítulo</label>
                        <input asp-for="Subtitle" class="md-input" placeholder="Subtítulo opcional" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="md-form-row">
                        <label asp-for="LevelId" class="md-label">Nível</label>
                        <select asp-for="LevelId" asp-items="ViewBag.Levels" class="md-select">
                            <option value="">Seleccionar...</option>
                        </select>
                        <span asp-validation-for="LevelId" class="text-danger" style="font-size:12px;"></span>
                    </div>
                </div>

                <!-- Descrição -->
                <div class="col-12">
                    <div class="md-form-row">
                        <label asp-for="Description" class="md-label">Descrição</label>
                        <textarea asp-for="Description" class="md-input" rows="3" placeholder="Descrição da formação"></textarea>
                    </div>
                </div>

                <!-- Equipa | Categoria | Professor -->
                <div class="col-md-4">
                    <div class="md-form-row">
                        <label class="md-label">Equipa</label>
                        <select id="teamFilter" asp-items="ViewBag.Teams" class="md-select">
                            <option value="">Seleccionar equipa...</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="md-form-row">
                        <label asp-for="CategoryId" class="md-label">Categoria</label>
                        <select asp-for="CategoryId" id="categorySelect" class="md-select">
                            <option value="">Seleccionar categoria...</option>
                            @foreach (var cat in categoriesFull)
                            {
                                if (cat.Id == Model.CategoryId)
                                {
                                    <option value="@cat.Id" data-team="@cat.TeamId" selected="selected">@cat.Name</option>
                                }
                                else
                                {
                                    <option value="@cat.Id" data-team="@cat.TeamId">@cat.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger" style="font-size:12px;"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="md-form-row">
                        <label asp-for="TeacherId" class="md-label">Professor</label>
                        <select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="md-select">
                            <option value="">Seleccionar...</option>
                        </select>
                        <span asp-validation-for="TeacherId" class="text-danger" style="font-size:12px;"></span>
                    </div>
                </div>

                <!-- Estado -->
                <div class="col-12" style="display:flex; align-items:center; gap:28px; padding-top:4px;">
                    <div class="md-form-check">
                        <input asp-for="IsActived" type="checkbox" />
                        <label asp-for="IsActived">Activo</label>
                    </div>
                    <div class="md-form-check">
                        <input asp-for="IsBrief" type="checkbox" />
                        <label asp-for="IsBrief" title="Mostra a formação como 'Em breve'">Em breve</label>
                    </div>
                </div>

            </div>
        </div>
        <!-- ══ /TAB: DADOS ═════════════════════════════════════════════ -->

        <!-- ══ TAB: UPLOADS ════════════════════════════════════════════ -->
        <div id="tab-uploads" class="tab-pane">
            <div class="row g-4">

                <!-- Thumbnail -->
                <div class="col-12">
                    <p class="md-label" style="font-size:11px; text-transform:uppercase; letter-spacing:.05em;
                                               color:var(--md-text-muted); margin-bottom:12px;">
                        Imagem
                    </p>
                    <div style="display:flex; align-items:flex-start; gap:20px; flex-wrap:wrap;">
                        <div style="flex-shrink:0;">
                            @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
                            {
                                <img id="thumbPreview" src="@Model.Thumbnail" alt="Thumbnail"
                                     style="width:140px; height:96px; object-fit:cover; border-radius:8px;
                                            border:2px solid var(--md-border);" />
                            }
                            else
                            {
                                <div id="thumbPreviewEmpty"
                                     style="width:140px; height:96px; border-radius:8px; border:2px dashed var(--md-border);
                                            display:flex; align-items:center; justify-content:center;
                                            color:var(--md-text-muted); font-size:28px;">
                                    <i class="bi bi-image"></i>
                                </div>
                                <img id="thumbPreview" src="" alt="Preview"
                                     style="width:140px; height:96px; object-fit:cover; border-radius:8px;
                                            border:2px solid var(--md-border); display:none;" />
                            }
                        </div>
                        <div style="flex:1; min-width:220px;">
                            <label class="md-label">Thumbnail da Formação</label>
                            <input type="file" id="thumbnailInput" name="thumbnail"
                                   accept="image/jpeg,image/png,image/webp" class="md-input" style="padding:6px;" />
                            <small style="color:var(--md-text-muted); font-size:11px;">
                                JPG, PNG, WebP — 1200×800 px recomendado.
                                @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
                                {
                                    <span>Seleccione novo ficheiro para substituir o actual.</span>
                                }
                            </small>
                        </div>
                    </div>
                </div>

                <div class="col-12" style="border-top:1px solid var(--md-border); padding-top:20px; margin-top:4px;">
                    <p class="md-label" style="font-size:11px; text-transform:uppercase; letter-spacing:.05em;
                                               color:var(--md-text-muted); margin-bottom:16px;">
                        Ficheiros de Apoio
                    </p>
                    <div class="row g-3">

                        <!-- Snapshot ZIP -->
                        <div class="col-md-6">
                            <div style="padding:20px; border:1px solid var(--md-border); border-radius:var(--md-radius);
                                        background:var(--md-bg-secondary); height:100%;">
                                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                                    <div style="width:38px; height:38px; border-radius:8px;
                                                background:rgba(99,102,241,0.12); display:flex;
                                                align-items:center; justify-content:center;
                                                font-size:18px; color:#818CF8; flex-shrink:0;">
                                        <i class="bi bi-file-earmark-zip-fill"></i>
                                    </div>
                                    <div>
                                        <p style="font-weight:700; font-size:13px; margin:0; color:var(--md-text-primary);">
                                            Snapshot da Formação
                                        </p>
                                        <small style="color:var(--md-text-muted); font-size:11px;">
                                            Código-fonte por aula (.zip)
                                        </small>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.SnapshotUrl))
                                {
                                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;
                                                padding:8px 12px; background:rgba(99,102,241,0.08);
                                                border:1px solid rgba(99,102,241,0.25); border-radius:6px;">
                                        <i class="bi bi-check-circle-fill" style="color:#818CF8; font-size:13px;"></i>
                                        <small style="color:#818CF8; font-size:12px; font-weight:600;">
                                            @System.IO.Path.GetFileName(Model.SnapshotUrl)
                                        </small>
                                    </div>
                                }
                                <input type="file" name="snapshotFile" accept=".zip"
                                       class="md-input" style="padding:6px; font-size:12px;" />
                                <small style="color:var(--md-text-muted); font-size:11px; margin-top:6px; display:block;">
                                    @(string.IsNullOrWhiteSpace(Model.SnapshotUrl)
                                        ? "Nenhum ficheiro carregado ainda."
                                        : "Seleccione novo .zip para substituir.")
                                </small>
                            </div>
                        </div>

                        <!-- PDF -->
                        <div class="col-md-6">
                            <div style="padding:20px; border:1px solid var(--md-border); border-radius:var(--md-radius);
                                        background:var(--md-bg-secondary); height:100%;">
                                <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                                    <div style="width:38px; height:38px; border-radius:8px;
                                                background:rgba(239,68,68,0.1); display:flex;
                                                align-items:center; justify-content:center;
                                                font-size:18px; color:#F87171; flex-shrink:0;">
                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                    </div>
                                    <div>
                                        <p style="font-weight:700; font-size:13px; margin:0; color:var(--md-text-primary);">
                                            Ficheiro PDF
                                        </p>
                                        <small style="color:var(--md-text-muted); font-size:11px;">
                                            Slides, guias ou material de apoio
                                        </small>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.PdfFileUrl))
                                {
                                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;
                                                padding:8px 12px; background:rgba(239,68,68,0.08);
                                                border:1px solid rgba(239,68,68,0.25); border-radius:6px;">
                                        <i class="bi bi-check-circle-fill" style="color:#F87171; font-size:13px;"></i>
                                        <small style="color:#F87171; font-size:12px; font-weight:600;">
                                            @System.IO.Path.GetFileName(Model.PdfFileUrl)
                                        </small>
                                    </div>
                                }
                                <input type="file" name="pdfFile" accept=".pdf"
                                       class="md-input" style="padding:6px; font-size:12px;" />
                                <small style="color:var(--md-text-muted); font-size:11px; margin-top:6px; display:block;">
                                    @(string.IsNullOrWhiteSpace(Model.PdfFileUrl)
                                        ? "Nenhum ficheiro carregado ainda."
                                        : "Seleccione novo .pdf para substituir.")
                                </small>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
        <!-- ══ /TAB: UPLOADS ═══════════════════════════════════════════ -->

        <!-- Botões do form (visíveis nas tabs Dados e Uploads) -->
        <div id="formActions" style="display:flex; gap:12px; margin-top:28px; padding-top:20px; border-top:1px solid var(--md-border);">
            <button type="submit" form="courseForm" class="btn-md-primary">
                <i class="bi bi-check-lg"></i> Guardar
            </button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>

    </form>
    <!-- ── /Form ──────────────────────────────────────────────────────── -->

    <!-- ══ TAB: PRÉ-REQUISITOS (fora do form) ══════════════════════════ -->
    <div id="tab-prereqs" class="tab-pane">

        <p class="md-label" style="margin-bottom:4px;">Pré-requisitos</p>
        <p style="font-size:12px; color:var(--md-text-muted); margin-bottom:20px;">
            Formações que o aluno deve concluir antes de aceder a este projecto.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="alert-danger-md mb-3"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
        }

        <!-- Lista actual -->
        @if (requirements.Any())
        {
            <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:20px;">
                @foreach (var req in requirements)
                {
                    var title  = req.PrerequisiteCourse?.Title ?? "—";
                    var abbr   = string.Join("", title.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                     .Take(2).Select(w => w[0].ToString().ToUpper()));
                    var isFree = req.PrerequisiteCourse?.IsFree == true;

                    <div style="display:flex; align-items:center; gap:10px; padding:12px 14px;
                                background:var(--md-bg-secondary); border:1px solid var(--md-border);
                                border-radius:var(--md-radius-sm);">
                        @if (!string.IsNullOrWhiteSpace(req.PrerequisiteCourse?.Thumbnail))
                        {
                            <img src="@req.PrerequisiteCourse.Thumbnail" alt="@title"
                                 style="width:40px;height:40px;border-radius:6px;object-fit:cover;flex-shrink:0;" />
                        }
                        else
                        {
                            <div style="width:40px;height:40px;border-radius:6px;flex-shrink:0;
                                        background:linear-gradient(135deg,#6366F1,#8B5CF6);
                                        display:flex;align-items:center;justify-content:center;
                                        font-size:12px;font-weight:800;color:#fff;">@abbr</div>
                        }
                        <div style="flex:1;min-width:0;">
                            <p style="font-weight:600;font-size:13px;margin:0;color:var(--md-text-primary);
                                      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@title</p>
                            @if (isFree) { <span style="font-size:11px;color:var(--md-success);">Gratuito</span> }
                        </div>
                        <form asp-action="RemoveRequirement" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requirementId" value="@req.Id" />
                            <input type="hidden" name="courseId"      value="@Model.Id" />
                            <button type="submit" class="action-btn danger" title="Remover" style="width:30px;height:30px;">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align:center; padding:32px; border:1px dashed var(--md-border);
                        border-radius:var(--md-radius); margin-bottom:20px; color:var(--md-text-muted);">
                <i class="bi bi-diagram-3" style="font-size:32px; display:block; margin-bottom:10px;"></i>
                <p style="margin:0; font-size:13px;">Nenhum pré-requisito definido.</p>
            </div>
        }

        <!-- Adicionar -->
        @if (availableCourses != null && availableCourses.Any())
        {
            <form asp-action="AddRequirement" method="post"
                  style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" value="@Model.Id" />
                <div style="flex:1;min-width:200px;">
                    <label class="md-label" style="margin-bottom:4px;">Adicionar pré-requisito</label>
                    <select name="prerequisiteCourseId" class="md-select" style="height:42px;">
                        <option value="">Seleccionar formação...</option>
                        @foreach (var item in availableCourses)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn-md-primary" style="height:42px;white-space:nowrap;">
                    <i class="bi bi-plus-lg"></i> Adicionar
                </button>
            </form>
        }
        else
        {
            <p style="font-size:12px; color:var(--md-text-muted); font-style:italic;">
                Não existem outras formações disponíveis para adicionar como pré-requisito.
            </p>
        }

    </div>
    <!-- ══ /TAB: PRÉ-REQUISITOS ════════════════════════════════════════ -->

</div>


@section Scripts {
<script>
    // ── Tab switching ──────────────────────────────────────────────────
    function switchTab(name, btn) {
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('tab-' + name).classList.add('active');
        btn.classList.add('active');
        // Botões Guardar/Cancelar só visíveis nas tabs com form
        document.getElementById('formActions').style.display =
            (name === 'prereqs') ? 'none' : 'flex';
    }

    // ── Filtro cascata Equipa → Categoria ──────────────────────────────
    (function () {
        const teamSel      = document.getElementById('teamFilter');
        const catSel       = document.getElementById('categorySelect');
        const allOpts      = Array.from(catSel.querySelectorAll('option[data-team]'));
        const selectedTeam = '@(selectedTeamId?.ToString() ?? "")';

        if (selectedTeam) teamSel.value = selectedTeam;

        function filterCategories() {
            const teamId = teamSel.value;
            allOpts.forEach(opt => {
                const show = !teamId || opt.dataset.team === teamId;
                opt.style.display = show ? '' : 'none';
                if (!show && opt.selected) { opt.selected = false; catSel.value = ''; }
            });
        }

        teamSel.addEventListener('change', filterCategories);
        filterCategories();
    })();

    // ── Loading overlay ────────────────────────────────────────────────
    document.getElementById('courseForm').addEventListener('submit', function () {
        if (!this.checkValidity()) return;
        document.getElementById('globalLoadingOverlay').style.display = 'flex';
    });

    // ── Preview thumbnail ──────────────────────────────────────────────
    document.getElementById('thumbnailInput').addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const img   = document.getElementById('thumbPreview');
        const empty = document.getElementById('thumbPreviewEmpty');
        img.src = URL.createObjectURL(file);
        img.style.display = 'block';
        if (empty) empty.style.display = 'none';
    });

    // ── Se houver erro de validação, abrir a tab Dados ─────────────────
    const hasErrors = document.querySelector('.md-alert-danger');
    if (hasErrors && hasErrors.children.length > 0) {
        switchTab('dados', document.querySelector('.tab-btn'));
    }
</script>
}
