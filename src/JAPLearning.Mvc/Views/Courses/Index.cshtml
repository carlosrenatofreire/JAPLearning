@model List<JAPLearning.Mvc.ViewModels.Entities.CourseViewModel>
@using System.Text.Json
@{
    ViewData["Title"] = "Formações";
    var courseDurations    = ViewBag.CourseDurations  as Dictionary<Guid, TimeSpan> ?? new();
    var teamsJson          = JsonSerializer.Serialize(ViewBag.FilterTeams);
    var categoriesJson     = JsonSerializer.Serialize(ViewBag.FilterCategories);
    var supervisorTeamId   = ViewBag.SupervisorTeamId as string ?? "";
}
@await Html.PartialAsync("_CrudStyles")

<style>
    .filter-bar {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 16px; border-bottom: 1px solid var(--md-border); flex-wrap: wrap;
    }
    .filter-bar label {
        font-size: 11px; font-weight: 700; color: var(--md-text-muted);
        text-transform: uppercase; letter-spacing: .04em; white-space: nowrap;
    }
    .filter-select {
        height: 36px; padding: 0 10px; font-size: 13px;
        background: var(--md-bg-secondary); border: 1px solid var(--md-border);
        border-radius: var(--md-radius-sm); color: var(--md-text-primary);
        min-width: 160px; flex: 1; max-width: 240px; cursor: pointer; transition: border-color .15s;
    }
    .filter-select:focus   { outline: none; border-color: var(--md-accent); }
    .filter-select:disabled { opacity: .4; cursor: not-allowed; }
    .filter-divider { width: 1px; height: 24px; background: var(--md-border); flex-shrink: 0; }
    .filter-search  { margin-left: auto; display: flex; align-items: center; gap: 8px; }
    #courseSearch {
        height: 36px; padding: 0 12px; font-size: 13px;
        background: var(--md-bg-secondary); border: 1px solid var(--md-border);
        border-radius: var(--md-radius-sm); color: var(--md-text-primary); width: 200px;
    }
    #courseSearch:focus { outline: none; border-color: var(--md-accent); }
    .filter-clear {
        height: 36px; padding: 0 12px; font-size: 12px; font-weight: 600;
        background: none; border: 1px solid var(--md-border);
        border-radius: var(--md-radius-sm); color: var(--md-text-muted);
        cursor: pointer; white-space: nowrap; transition: .15s;
    }
    .filter-clear:hover { border-color: var(--md-accent); color: var(--md-accent); }
    .results-count { font-size: 12px; color: var(--md-text-muted); padding: 8px 16px; border-top: 1px solid var(--md-border); }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert-success-md"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="page-header">
    <div>
        <h4 class="page-header-title">Formações</h4>
        <p class="page-header-sub">Gestão do catálogo de formações</p>
    </div>
    <a asp-action="Create" class="btn-md-primary"><i class="bi bi-plus-lg"></i> Nova Formação</a>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">

    <!-- ── Filtros em cascata ─────────────────────────────────────────── -->
    <div class="filter-bar">

        <label>Equipa</label>
        <select id="filterTeam" class="filter-select">
            <option value="">Todas as equipas</option>
        </select>

        <i class="bi bi-chevron-right" style="color:var(--md-border); font-size:11px; flex-shrink:0;"></i>

        <label>Categoria</label>
        <select id="filterCategory" class="filter-select" disabled title="Seleccione primeiro uma equipa">
            <option value="">— seleccione equipa —</option>
        </select>

        <div class="filter-divider"></div>

        <div class="filter-search">
            <i class="bi bi-search" style="color:var(--md-text-muted); font-size:13px;"></i>
            <input type="text" id="courseSearch" placeholder="Pesquisar formação..." />
            <button type="button" class="filter-clear" id="btnClearFilters">
                <i class="bi bi-x-lg" style="margin-right:4px;"></i> Limpar
            </button>
        </div>
    </div>

    <!-- ── Tabela ─────────────────────────────────────────────────────── -->
    <table id="coursesTable" class="crud-table" style="margin:0;">
        <thead>
            <tr>
                <th>Título</th>
                <th style="width:90px; text-align:center;">Duração</th>
                <th>Equipa</th>
                <th>Categoria</th>
                <th>Professor</th>
                <th>Nível</th>
                <th style="width:70px; text-align:center;">Breve</th>
                <th>Estado</th>
                <th style="width:100px; text-align:center;">Acções</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:var(--md-text-primary); font-weight:600;">
                        <div style="display:flex; align-items:center; gap:12px;">
                            @if (!string.IsNullOrWhiteSpace(item.Thumbnail))
                            {
                                <img src="@item.Thumbnail" alt="@item.Title"
                                     style="width:52px; height:36px; object-fit:cover; border-radius:5px; flex-shrink:0; border:1px solid var(--md-border);" />
                            }
                            else
                            {
                                <div style="width:52px; height:36px; border-radius:5px; background:var(--md-border); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <i class="bi bi-collection-play" style="font-size:14px; color:var(--md-text-muted);"></i>
                                </div>
                            }
                            <span>@item.Title</span>
                        </div>
                    </td>
                    @{
                        var hasDur = courseDurations.TryGetValue(item.Id, out var dur) && dur > TimeSpan.Zero;
                        var durTxt = hasDur
                            ? (dur.TotalHours >= 1 ? $"{(int)dur.TotalHours}h {dur.Minutes:D2}min" : $"{(int)dur.TotalMinutes}min")
                            : "—";
                    }
                    <td style="text-align:center; font-size:12px; color:var(--md-text-muted); font-variant-numeric:tabular-nums; white-space:nowrap;">
                        @if (hasDur) { <i class="bi bi-clock" style="margin-right:3px;"></i> }@durTxt
                    </td>
                    <td><span class="md-badge md-badge-secondary">@item.TeamName</span></td>
                    <td>@item.CategoryName</td>
                    <td>@item.TeacherName</td>
                    <td><span class="md-badge md-badge-warning">@item.LevelName</span></td>
                    <td style="text-align:center;">
                        @if (item.IsBrief)
                        {
                            <span class="md-badge" style="background:rgba(245,158,11,0.15); color:#f59e0b; border:1px solid rgba(245,158,11,0.3);">Sim</span>
                        }
                    </td>
                    <td>
                        @if (item.IsActived) { <span class="badge-active"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Activo</span> }
                        else { <span class="badge-inactive"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Inactivo</span> }
                    </td>
                    <td style="text-align:center;">
                        <div style="display:flex; gap:6px; justify-content:center;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="margin:0;"
                                  onsubmit="return confirm('Eliminar esta formação?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-btn danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="9" style="text-align:center; padding:40px; color:var(--md-text-muted);">
                    <i class="bi bi-collection-play" style="font-size:32px; display:block; margin-bottom:8px;"></i>
                    Nenhuma formação encontrada.
                </td></tr>
            }
        </tbody>
    </table>

    <div class="results-count" id="resultsCount"></div>
</div>

@section Scripts {
<script>
$(document).ready(function () {

    const ALL_TEAMS      = @Html.Raw(teamsJson);
    const ALL_CATEGORIES = @Html.Raw(categoriesJson);
    const SUPERVISOR_TID = '@Html.Raw(supervisorTeamId)';

    const selTeam     = document.getElementById('filterTeam');
    const selCategory = document.getElementById('filterCategory');
    const txtSearch   = document.getElementById('courseSearch');
    const btnClear    = document.getElementById('btnClearFilters');
    const countEl     = document.getElementById('resultsCount');

    // ── DataTables ────────────────────────────────────────────────────
    let dt = null;
    setTimeout(() => {
        dt = $('#coursesTable').DataTable();
        $('#coursesTable').closest('.dataTables_wrapper').find('.dt-header').remove();
        $('.dataTables_info').hide();
        updateCount();
    }, 50);

    // ── Filtro: data[2]=Equipa, data[3]=Categoria ─────────────────────
    $.fn.dataTable.ext.search.push(function (settings, data) {
        if (settings.nTable.id !== 'coursesTable') return true;
        const teamFilter = selTeam.value
            ? selTeam.options[selTeam.selectedIndex].text : '';
        const catFilter  = selCategory.value
            ? selCategory.options[selCategory.selectedIndex].text : '';
        const search     = txtSearch.value.trim().toLowerCase();

        const matchTeam   = !teamFilter || (data[2] || '').includes(teamFilter);
        const matchCat    = !catFilter  || (data[3] || '') === catFilter;
        const matchSearch = !search     || (data[0] || '').toLowerCase().includes(search)
                                        || (data[3] || '').toLowerCase().includes(search);
        return matchTeam && matchCat && matchSearch;
    });

    // ── Popular Equipas ───────────────────────────────────────────────
    ALL_TEAMS.forEach(t => selTeam.add(new Option(t.name, t.id)));

    // ── Cascata: Equipa → Categoria ───────────────────────────────────
    function populateCategories(teamId) {
        selCategory.innerHTML = '<option value="">Todas as categorias</option>';
        if (!teamId) {
            selCategory.disabled = true;
            redraw();
            return;
        }
        const filtered = ALL_CATEGORIES.filter(c => c.teamId === teamId);
        filtered.forEach(c => selCategory.add(new Option(c.name, c.id)));
        selCategory.disabled = false;
        redraw();
    }

    // Supervisor: auto-seleccionar a sua equipa e popular categorias
    if (SUPERVISOR_TID) {
        selTeam.value = SUPERVISOR_TID;
        populateCategories(SUPERVISOR_TID);
    }

    // ── Redesenhar + contador ─────────────────────────────────────────
    function redraw() {
        if (dt) { dt.draw(); updateCount(); }
    }

    function updateCount() {
        if (!dt) return;
        const info  = dt.page.info();
        const shown = info.recordsDisplay;
        const total = info.recordsTotal;
        countEl.textContent = shown === total
            ? `Mostrando ${total} formação(ões)`
            : `Mostrando ${shown} de ${total} formação(ões)`;
    }

    // ── Limpar ────────────────────────────────────────────────────────
    function clearAll() {
        selCategory.innerHTML = '<option value="">— seleccione equipa —</option>';
        selCategory.disabled  = true;
        txtSearch.value       = '';
        if (SUPERVISOR_TID) {
            // Supervisor: repor a sua equipa
            selTeam.value = SUPERVISOR_TID;
            populateCategories(SUPERVISOR_TID);
        } else {
            selTeam.value = '';
            redraw();
        }
    }

    // ── Eventos ───────────────────────────────────────────────────────
    selTeam.addEventListener('change',    () => populateCategories(selTeam.value));
    selCategory.addEventListener('change', redraw);
    txtSearch.addEventListener('input',    redraw);
    btnClear.addEventListener('click',     clearAll);

    $('#coursesTable').on('draw.dt', updateCount);

    // ── Loading overlay ao navegar ────────────────────────────────────
    const overlay = document.getElementById('globalLoadingOverlay');
    document.querySelectorAll('a.action-btn').forEach(l =>
        l.addEventListener('click', () => overlay.style.display = 'flex'));
    document.querySelectorAll('form[action*="Delete"]').forEach(f =>
        f.addEventListener('submit', () => overlay.style.display = 'flex'));
});
</script>
}
