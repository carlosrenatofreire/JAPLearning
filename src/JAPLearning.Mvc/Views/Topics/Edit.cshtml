@model JAPLearning.Mvc.ViewModels.Entities.TopicViewModel
@{
    ViewData["Title"] = "Editar Tópico";
    var selectedTeamId = ViewBag.SelectedTeamId as Guid?;
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Tópico</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-text-muted);">Tópicos</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> Editar</p>
    </div>
</div>

<div class="md-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="row g-3">

            <!-- Equipa | Formação -->
            <div class="col-md-4">
                <div class="md-form-row">
                    <label class="md-label">Equipa</label>
                    <select id="teamFilter" asp-items="ViewBag.Teams" class="md-select">
                        <option value="">Seleccionar equipa...</option>
                    </select>
                </div>
            </div>
            <div class="col-md-8">
                <div class="md-form-row">
                    <label asp-for="CourseId" class="md-label">Formação</label>
                    <select asp-for="CourseId" asp-items="ViewBag.Courses" class="md-select" id="courseSelect"
                            disabled="@(!selectedTeamId.HasValue)">
                        <option value="">@(selectedTeamId.HasValue ? "Seleccionar formação..." : "Seleccionar equipa primeiro...")</option>
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>

            <!-- Nome | Ordem -->
            <div class="col-md-8">
                <div class="md-form-row">
                    <label asp-for="Name" class="md-label">Nome</label>
                    <input asp-for="Name" class="md-input" placeholder="Nome do tópico" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="md-form-row">
                    <label asp-for="Order" class="md-label">Ordem</label>
                    <input asp-for="Order" class="md-input" type="number" min="1" />
                </div>
            </div>

            <!-- Descrição -->
            <div class="col-12">
                <div class="md-form-row">
                    <label asp-for="Description" class="md-label">Descrição</label>
                    <textarea asp-for="Description" class="md-input" rows="3" placeholder="Descrição opcional"></textarea>
                </div>
            </div>

            <!-- Activo -->
            <div class="col-12">
                <div class="md-form-check">
                    <input asp-for="IsActived" type="checkbox" />
                    <label asp-for="IsActived">Activo</label>
                </div>
            </div>

        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    (function () {
        const teamSel        = document.getElementById('teamFilter');
        const courseSel      = document.getElementById('courseSelect');
        const selectedTeam   = '@(selectedTeamId?.ToString() ?? "")';
        const selectedCourse = '@Model.CourseId';

        function loadCourses(teamId, preselectId) {
            if (!teamId) {
                courseSel.innerHTML = '<option value="">Seleccionar equipa primeiro...</option>';
                courseSel.disabled  = true;
                return;
            }
            courseSel.innerHTML = '<option value="">A carregar...</option>';
            courseSel.disabled  = true;
            fetch('/Topics/GetCoursesByTeam?teamId=' + teamId)
                .then(r => r.json())
                .then(data => {
                    if (data.length === 0) {
                        courseSel.innerHTML = '<option value="">Sem formações nesta equipa</option>';
                        return;
                    }
                    courseSel.innerHTML = '<option value="">Seleccionar formação...</option>';
                    data.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.value;
                        opt.text  = c.text;
                        if (preselectId && c.value === preselectId) opt.selected = true;
                        courseSel.appendChild(opt);
                    });
                    courseSel.disabled = false;
                });
        }

        // On load: if team already known, filter and restore selection
        if (selectedTeam) {
            teamSel.value = selectedTeam;
            loadCourses(selectedTeam, selectedCourse);
        }

        teamSel.addEventListener('change', function () {
            loadCourses(this.value, null);
        });
    })();
</script>
}
