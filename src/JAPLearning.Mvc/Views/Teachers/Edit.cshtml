@model JAPLearning.Mvc.ViewModels.Parameters.TeacherViewModel
@{
    ViewData["Title"] = "Editar Professor";
    var initials = string.Join("", (Model.Name ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0].ToString().ToUpper()));
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Professor</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-text-muted);">Professores</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> Editar</p>
    </div>
</div>

<div class="md-card form-card" style="max-width:100%;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PhotoUrl" />
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="row g-3">

            <!-- Linha 1: Nome + Activo -->
            <div class="col-md-10">
                <div class="md-form-row">
                    <label asp-for="Name" class="md-label"></label>
                    <input asp-for="Name" class="md-input" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-2" style="display:flex; align-items:flex-end; padding-bottom:4px;">
                <div class="md-form-check">
                    <input asp-for="IsActived" type="checkbox" />
                    <label asp-for="IsActived">Activo</label>
                </div>
            </div>

            <!-- Linha 2: Descrição + Foto -->
            <div class="col-md-8">
                <div class="md-form-row">
                    <label asp-for="Description" class="md-label"></label>
                    <textarea asp-for="Description" class="md-input" rows="6" placeholder="Biografia / descrição do professor"></textarea>
                </div>
            </div>
            <div class="col-md-4">
                <div class="md-form-row">
                    <label class="md-label">Foto do Professor</label>
                    <div style="width:100%; display:flex; flex-direction:column; align-items:center; gap:12px;">
                        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
                        {
                            <img id="photoPreview" src="@Model.PhotoUrl" alt="Foto actual"
                                 style="width:110px; height:110px; object-fit:cover; border-radius:50%;
                                        border:2px solid var(--md-border); flex-shrink:0;" />
                        }
                        else
                        {
                            <div id="photoPreview" class="md-avatar"
                                 style="width:110px; height:110px; font-size:32px; flex-shrink:0;">@initials</div>
                        }
                        <div style="width:100%;">
                            <input type="file" id="photoInput" name="photo" accept="image/jpeg,image/png,image/webp"
                                   class="md-input" style="padding:6px;" />
                            <small style="display:block; color:var(--md-text-muted); font-size:11px; margin-top:4px;">
                                JPG, PNG ou WebP — seleccione para substituir
                            </small>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    document.getElementById('photoInput')?.addEventListener('change', function () {
        const file = this.files[0];
        if (!file) return;
        const url  = URL.createObjectURL(file);
        const prev = document.getElementById('photoPreview');
        if (prev.tagName === 'IMG') {
            prev.src = url;
        } else {
            const img = document.createElement('img');
            img.id    = 'photoPreview';
            img.src   = url;
            img.style.cssText = 'width:110px;height:110px;object-fit:cover;border-radius:50%;border:2px solid var(--md-border);flex-shrink:0;';
            prev.replaceWith(img);
        }
    });
</script>
}
