@model JAPLearning.Mvc.ViewModels.Parameters.TeamViewModel
@{
    ViewData["Title"] = "Nova Equipa";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Nova Equipa</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-text-muted);">Equipas</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> Nova</p>
    </div>
</div>

<div class="md-card form-card" style="max-width:100%;">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="row g-3">

            <!-- Linha 1: Nome + Activo -->
            <div class="col-md-10">
                <div class="md-form-row">
                    <label asp-for="Name" class="md-label"></label>
                    <input asp-for="Name" class="md-input" placeholder="Nome da equipa" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-2" style="display:flex; align-items:flex-end; padding-bottom:4px;">
                <div class="md-form-check">
                    <input asp-for="IsActived" type="checkbox" />
                    <label asp-for="IsActived">Activo</label>
                </div>
            </div>

            <!-- Linha 2: Thumbnail + Descrição -->
            <div class="col-md-3">
                <div class="md-form-row">
                    <label class="md-label">Thumbnail da Equipa</label>
                    <div style="width:100%; height:150px; border-radius:10px; background:var(--md-bg-secondary);
                                border:1px solid var(--md-border); overflow:hidden; position:relative; margin-bottom:10px;">
                        <div id="thumbPlaceholder" style="width:100%; height:100%; display:flex; align-items:center;
                                    justify-content:center; color:var(--md-text-muted); font-size:42px;">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <img id="thumbPreview" src="" alt="Preview"
                             style="width:100%; height:100%; object-fit:cover; display:none; position:absolute; top:0; left:0;" />
                    </div>
                    <input type="file" id="thumbnailInput" name="thumbnail" accept="image/jpeg,image/png,image/webp"
                           class="md-input" style="padding:6px;" />
                    <small style="color:var(--md-text-muted); font-size:11px;">JPG, PNG ou WebP — opcional</small>
                </div>
            </div>
            <div class="col-md-9">
                <div class="md-form-row">
                    <label asp-for="Description" class="md-label"></label>
                    <textarea asp-for="Description" class="md-input" rows="7" placeholder="Descrição opcional"></textarea>
                </div>
            </div>

        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    document.getElementById('thumbnailInput').addEventListener('change', function () {
        const file        = this.files[0];
        if (!file) return;
        const preview     = document.getElementById('thumbPreview');
        const placeholder = document.getElementById('thumbPlaceholder');
        preview.src = URL.createObjectURL(file);
        preview.style.display    = 'block';
        placeholder.style.display = 'none';
    });
</script>
}
