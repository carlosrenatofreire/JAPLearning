<script>
(function () {
    var slides  = Array.from(document.querySelectorAll('.hc-slide'));
    var dots    = Array.from(document.querySelectorAll('.hc-dot'));
    var titleEl = document.getElementById('hc-title');
    var btnPrev = document.getElementById('hc-prev');
    var btnNext = document.getElementById('hc-next');
    var current = 0;
    var total   = slides.length;
    var timer;

    function goTo(idx) {
        slides[current].classList.remove('active');
        slides[current].classList.add('exit');
        dots[current].classList.remove('active');

        var prev = current;
        current = (idx + total) % total;

        slides[current].classList.add('active');
        dots[current].classList.add('active');
        titleEl.textContent = slides[current].dataset.title;

        btnPrev.disabled = current === 0;
        btnNext.disabled = current === total - 1;

        setTimeout(function () { slides[prev].classList.remove('exit'); }, 420);
    }

    function startAuto() { timer = setInterval(function () { if (current < total - 1) goTo(current + 1); else goTo(0); }, 4000); }
    function stopAuto()  { clearInterval(timer); }

    window.hcNav = function (dir) { stopAuto(); goTo(current + dir); };
    window.hcGo  = function (idx) { stopAuto(); goTo(idx); };

    startAuto();
    document.querySelector('.hero-carousel-wrap').addEventListener('mouseenter', stopAuto);
    document.querySelector('.hero-carousel-wrap').addEventListener('mouseleave', startAuto);
})();
</script>

