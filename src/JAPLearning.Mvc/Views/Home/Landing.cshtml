                                    <div style="font-size:8px;color:#94a3b8;margin-bottom:8px;">Grupo JAP · 2026</div>
                                    <div style="border-top:1px solid rgba(255,255,255,0.06);padding-top:8px;">
                                        <div style="font-size:9px;font-weight:700;color:#cbd5e1;">Colaborador da Silva</div>
                                        <div style="font-size:7px;color:#64748b;margin-top:1px;">Equipa DMC-Developers</div>
                                    </div>
                                    <div style="margin-top:8px;display:flex;align-items:center;justify-content:center;gap:4px;">
                                        <i class="bi bi-shield-check" style="font-size:9px;color:#4ade80;"></i>
                                        <span style="font-size:7px;color:#4ade80;">Verificado · JAP Learning</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Janela 5: Dashboard de Equipa -->
