                        <div class="hw-body">
                            <div class="hw-dash-body">
                                <div class="kpi-mini">
                                    <div class="kpi-card"><span class="kpi-val" style="color:#4ade80;">12</span><span class="kpi-lbl">Concluídas</span></div>
                                    <div class="kpi-card"><span class="kpi-val" style="color:#60a5fa;">5</span><span class="kpi-lbl">Em Curso</span></div>
