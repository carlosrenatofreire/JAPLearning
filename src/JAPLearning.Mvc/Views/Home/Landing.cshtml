                        </div>
                    </div>

                    <!-- Janela 4 (frente): Player de Aula -->
                    <div class="hw hw-player">
                        <div class="hw-titlebar">
                            <div class="hw-dot" style="background:#ff5f57;"></div>
                            <div class="hw-dot" style="background:#ffbd2e;"></div>
                            <div class="hw-dot" style="background:#28ca41;"></div>
                            <span style="margin-left:4px;">Aula: Importar dados — JAP Learning</span>
                        </div>
                        <div class="hw-body" style="display:flex;flex-direction:column;">
                            <!-- Área do vídeo -->
