                            <div style="margin-bottom:8px;">
                                <div style="display:flex;justify-content:space-between;font-size:7px;color:#64748b;margin-bottom:3px;"><span>O teu progresso</span><span style="color:#60a5fa;">3 / 8 aulas</span></div>
