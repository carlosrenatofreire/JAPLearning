                                <div class="kpi-card"><span class="kpi-val" style="color:#60a5fa;">12</span><span class="kpi-lbl">Formações</span></div>
                                <div class="kpi-card"><span class="kpi-val" style="color:#f59e0b;">27</span><span class="kpi-lbl">Certificados</span></div>
                                <div class="kpi-card"><span class="kpi-val" style="color:#a78bfa;">4</span><span class="kpi-lbl">Equipas</span></div>
                            </div>
                            <!-- Acções rápidas -->
                            <div style="display:flex;gap:4px;margin-bottom:8px;">
                                <div style="flex:1;background:rgba(232,80,26,0.1);border:1px solid rgba(232,80,26,0.25);border-radius:5px;padding:5px 4px;text-align:center;">
                                    <i class="bi bi-person-plus" style="color:#e8501a;font-size:11px;display:block;margin-bottom:2px;"></i>
                                    <span style="font-size:7px;color:#94a3b8;">Colaborador</span>
                                </div>
                                <div style="flex:1;background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.2);border-radius:5px;padding:5px 4px;text-align:center;">
                                    <i class="bi bi-collection-play" style="color:#818cf8;font-size:11px;display:block;margin-bottom:2px;"></i>
                                    <span style="font-size:7px;color:#94a3b8;">Formação</span>
                                </div>
                                <div style="flex:1;background:rgba(34,197,94,0.07);border:1px solid rgba(34,197,94,0.2);border-radius:5px;padding:5px 4px;text-align:center;">
                                    <i class="bi bi-newspaper" style="color:#4ade80;font-size:11px;display:block;margin-bottom:2px;"></i>
                                    <span style="font-size:7px;color:#94a3b8;">Artigo</span>
                                </div>
                                <div style="flex:1;background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.2);border-radius:5px;padding:5px 4px;text-align:center;">
                                    <i class="bi bi-people" style="color:#f59e0b;font-size:11px;display:block;margin-bottom:2px;"></i>
                                    <span style="font-size:7px;color:#94a3b8;">Equipa</span>
                                </div>
                            </div>
                            <!-- Módulos -->
                            <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:5px;overflow:hidden;">
                                <div style="padding:5px 8px;border-bottom:1px solid rgba(255,255,255,0.06);display:flex;justify-content:space-between;">
                                    <span style="font-size:8px;font-weight:700;color:#cbd5e1;">Módulo</span>
                                    <span style="font-size:8px;font-weight:700;color:#cbd5e1;">Registos</span>
                                </div>
                                <div class="dash-row" style="padding:4px 8px;"><span style="font-size:9px;">Colaboradores</span><span style="font-size:9px;color:#4ade80;">48</span></div>
                                <div class="dash-row" style="padding:4px 8px;"><span style="font-size:9px;">Formações</span><span style="font-size:9px;color:#60a5fa;">12</span></div>
                                <div class="dash-row" style="padding:4px 8px;"><span style="font-size:9px;">Equipas</span><span style="font-size:9px;color:#a78bfa;">4</span></div>
                                <div class="dash-row" style="padding:4px 8px;border:none;"><span style="font-size:9px;">Categorias</span><span style="font-size:9px;color:#f59e0b;">9</span></div>
                            </div>
                            <!-- Mini gráfico -->
                            <div style="margin-top:8px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.05);border-radius:5px;padding:6px 8px;">
                                <div style="font-size:7px;color:#64748b;margin-bottom:4px;">Progresso por equipa — Mai 2026</div>
                                <svg viewBox="0 0 240 36" style="width:100%;height:32px;display:block;">
                                    <defs><linearGradient id="ag1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#e8501a" stop-opacity="0.3"/><stop offset="100%" stop-color="#e8501a" stop-opacity="0"/></linearGradient></defs>
                                    <polygon points="0,36 0,30 40,26 80,20 120,14 160,9 200,5 240,2 240,36" fill="url(#ag1)"/>
                                    <polyline points="0,30 40,26 80,20 120,14 160,9 200,5 240,2" fill="none" stroke="#e8501a" stroke-width="1.5" stroke-linejoin="round"/>
                                    <circle cx="240" cy="2" r="2.5" fill="#4ade80"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Janela 2: Lista de Formações -->
                    <div class="hw hw-catalog">
                        <div class="hw-titlebar">
                            <div class="hw-dot" style="background:#ff5f57;"></div>
                            <div class="hw-dot" style="background:#ffbd2e;"></div>
                            <div class="hw-dot" style="background:#28ca41;"></div>
                            <span style="margin-left:4px;">Formações — JAP Learning</span>
                        </div>
                        <div class="hw-body" style="padding:10px;">
                            <!-- Filtro por equipa -->
                            <div style="display:flex;gap:4px;margin-bottom:8px;flex-wrap:wrap;">
                                <span style="font-size:8px;background:rgba(232,80,26,0.15);border:1px solid rgba(232,80,26,0.4);color:#fb923c;padding:2px 8px;border-radius:10px;">Todas</span>
                                <span style="font-size:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:2px 8px;border-radius:10px;">DevOps</span>
                                <span style="font-size:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:2px 8px;border-radius:10px;">BI & Dados</span>
                                <span style="font-size:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:2px 8px;border-radius:10px;">RH</span>
                            </div>
                            <!-- Card 1 -->
                            <div class="course-card-mini">
                                <div style="height:38px;background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(139,92,246,0.12));display:flex;align-items:center;justify-content:center;">
                                    <i class="bi bi-bar-chart-fill" style="color:#818cf8;font-size:16px;"></i>
                                </div>
                                <div style="padding:6px 8px;">
                                    <div style="display:flex;gap:4px;margin-bottom:3px;">
                                        <span style="font-size:7px;background:rgba(99,102,241,0.15);color:#818cf8;padding:1px 5px;border-radius:3px;">BI & Dados</span>
                                        <span style="font-size:7px;background:rgba(245,158,11,0.12);color:#f59e0b;padding:1px 5px;border-radius:3px;">Intermédio</span>
                                    </div>
                                    <div style="font-size:9px;font-weight:700;color:#e2e8f0;">Power BI Essencial</div>
                                    <div style="font-size:8px;color:#64748b;">João Silva · 8 aulas</div>
                                </div>
                            </div>
                            <!-- Card 2 -->
                            <div class="course-card-mini">
                                <div style="height:38px;background:linear-gradient(135deg,rgba(232,80,26,0.18),rgba(160,31,58,0.1));display:flex;align-items:center;justify-content:center;">
                                    <i class="bi bi-gear-fill" style="color:#fb923c;font-size:16px;"></i>
                                </div>
                                <div style="padding:6px 8px;">
                                    <div style="display:flex;gap:4px;margin-bottom:3px;">
                                        <span style="font-size:7px;background:rgba(232,80,26,0.15);color:#fb923c;padding:1px 5px;border-radius:3px;">DevOps</span>
                                        <span style="font-size:7px;background:rgba(34,197,94,0.1);color:#4ade80;padding:1px 5px;border-radius:3px;">Avançado</span>
                                    </div>
                                    <div style="font-size:9px;font-weight:700;color:#e2e8f0;">CI/CD com GitHub Actions</div>
                                    <div style="font-size:8px;color:#64748b;">Ana Pereira · 12 aulas</div>
                                </div>
                            </div>
                            <!-- Card 3 parcial -->
                            <div class="course-card-mini" style="opacity:.6;">
                                <div style="padding:6px 8px;">
                                    <div style="font-size:9px;font-weight:700;color:#94a3b8;">Gestão de Projectos Ágeis</div>
                                    <div style="font-size:8px;color:#475569;">RH · 6 aulas</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Janela 3: Detalhe da Formação -->
                    <div class="hw hw-detail">
                        <div class="hw-titlebar">
                            <div class="hw-dot" style="background:#ff5f57;"></div>
                            <div class="hw-dot" style="background:#ffbd2e;"></div>
                            <div class="hw-dot" style="background:#28ca41;"></div>
                            <span style="margin-left:4px;">Power BI Essencial — JAP Learning</span>
                        </div>
                        <div class="hw-body" style="padding:10px;">
                            <!-- Capa + título -->
                            <div style="height:48px;background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(139,92,246,0.1));border-radius:5px;display:flex;align-items:center;justify-content:center;margin-bottom:8px;">
