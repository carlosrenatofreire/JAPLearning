@{
    ViewData["Title"] = "JAPLearning — A plataforma de aprendizagem do Grupo JAP";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<style>
    .hero {
        min-height: 65vh;
        display: flex; align-items: center;
        position: relative; overflow: visible;
        padding: 48px 0 40px;
    }
    .hero::before {
        content: '';
        position: absolute; top: -200px; right: -200px;
        width: 700px; height: 700px;
        background: radial-gradient(circle, rgba(232,80,26,0.12) 0%, transparent 65%);
        pointer-events: none;
    }
    .hero::after {
        content: '';
        position: absolute; bottom: -150px; left: -150px;
        width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(160,31,58,0.08) 0%, transparent 65%);
        pointer-events: none;
    }
    .hero-eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(232,80,26,0.1); border: 1px solid rgba(232,80,26,0.25);
        border-radius: 20px; padding: 6px 14px;
        font-size: 12px; font-weight: 700; color: var(--md-accent);
        text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 24px;
    }
    .hero h1 {
        font-size: clamp(36px, 5vw, 58px); font-weight: 900;
        line-height: 1.1; margin-bottom: 24px; letter-spacing: -0.02em;
    }
    .hero-sub {
        font-size: 18px; color: var(--md-text-secondary);
        line-height: 1.7; margin-bottom: 36px; max-width: 520px;
    }
    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 48px; }
    .hero-social-proof { display: flex; align-items: center; gap: 16px; }
    .hero-avatars { display: flex; }
    .hero-avatars .md-avatar { width: 34px; height: 34px; font-size: 12px; margin-right: -8px; border: 2px solid var(--md-bg-primary); }
    .hero-proof-text { font-size: 13px; color: var(--md-text-secondary); }
    .hero-proof-text strong { color: var(--md-text-primary); }

    /* ── Carrossel hero ── */
    .hero-carousel-wrap {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }
    .hero-window {
        width: 100%;
        max-width: 520px;
        height: 400px;
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #0c1220;
        border: 1px solid rgba(232,80,26,0.3);
        box-shadow: 0 16px 64px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04);
    }
    .hw-titlebar {
        display: flex; align-items: center; gap: 6px;
        padding: 9px 14px; font-size: 10px; color: #94a3b8;
        background: #101828; border-bottom: 1px solid rgba(255,255,255,0.07);
        flex-shrink: 0;
    }
    .hw-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }

    /* Slides */
    .hc-slides { position: relative; flex: 1; overflow: hidden; }
    .hc-slide {
        position: absolute; inset: 0;
        opacity: 0; transform: translateX(30px);
        transition: opacity .4s ease, transform .4s ease;
        pointer-events: none;
        overflow: hidden;
    }
    .hc-slide.active {
        opacity: 1; transform: translateX(0);
        pointer-events: auto;
    }
    .hc-slide.exit {
        opacity: 0; transform: translateX(-30px);
    }

    /* Paginação */
    .hc-nav {
        display: flex; align-items: center; justify-content: center; gap: 14px;
    }
    .hc-nav-btn {
        width: 36px; height: 36px; border-radius: 50%;
        background: transparent; border: 1px solid rgba(255,255,255,0.12);
        color: #94a3b8; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: border-color .2s, color .2s;
        font-size: 13px;
    }
    .hc-nav-btn:hover { border-color: var(--md-accent); color: var(--md-accent); }
    .hc-nav-btn:disabled { opacity: .35; cursor: not-allowed; }
    .hc-dots { display: flex; gap: 8px; align-items: center; }
    .hc-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: rgba(255,255,255,0.15); border: none; padding: 0; cursor: pointer;
        transition: background .2s, transform .2s;
    }
    .hc-dot.active { background: var(--md-accent); transform: scale(1.35); }

    /* Mini componentes reutilizáveis */
    .kpi-mini { display: grid; gap: 5px; margin-bottom: 8px; }
    .kpi-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; padding: 7px 6px; }
    .kpi-val  { font-size: 14px; font-weight: 900; color: #e2e8f0; display: block; margin-bottom: 2px; }
    .kpi-lbl  { font-size: 7.5px; color: #64748b; line-height: 1.2; }
    .kpi-icon-wrap { width: 22px; height: 22px; border-radius: 5px; display: flex; align-items: center; justify-content: center; font-size: 11px; margin-bottom: 5px; }
    .module-row { display: flex; align-items: center; gap: 6px; padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .course-card-mini { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 7px; overflow: hidden; margin-bottom: 6px; }

    /* Stats & features */
    .stat-card { background: var(--md-bg-card); border: 1px solid var(--md-border); border-radius: var(--md-radius); padding: 20px; text-align: center; }
    .stat-number { font-size: 32px; font-weight: 900; background: var(--md-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; display: block; }
    .stat-label { font-size: 13px; color: var(--md-text-muted); margin-top: 4px; }
    .feature-icon { width: 48px; height: 48px; background: rgba(232,80,26,0.1); border: 1px solid rgba(232,80,26,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: var(--md-accent); margin-bottom: 16px; }
    .md-section { padding: 80px 0; }
    .md-section-alt { background: var(--md-bg-secondary); }

    /* Testimonials */
    .testimonials-dot { background: var(--md-border); transition: var(--md-transition); }
    .testimonials-dot.active { background: var(--md-accent); transform: scale(1.3); }
    .testimonials-dot:hover { background: var(--md-text-muted); }
    .testimonials-nav:hover { border-color: var(--md-accent) !important; color: var(--md-accent) !important; }
    .testimonials-nav:disabled { opacity: 0.4; cursor: not-allowed; }
    .testimonial-linkedin:hover { color: #0a4d8c !important; transform: translateY(-2px); }
</style>

<!-- Hero -->
<section class="hero">
    <div class="container position-relative" style="z-index:1;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-eyebrow">
                    <i class="bi bi-mortarboard-fill"></i> Plataforma de Aprendizagem do Grupo JAP
                </div>
                <h1>
                    Desenvolve as competências<br />
                    <span class="md-gradient-text">da tua equipa.</span>
                </h1>
                <p class="hero-sub">
                    Acede a formações práticas, acompanha o progresso da tua equipa
                    e desenvolve as competências certas para os desafios reais da empresa.
                </p>
                <div class="hero-actions">
                    <a asp-controller="Home" asp-action="Courses" class="btn-md-primary" style="font-size:16px; padding:14px 28px;">
                        Explorar Formações <i class="bi bi-arrow-right"></i>
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn-md-outline" style="font-size:16px; padding:14px 28px;">
                        Entrar na Plataforma
                    </a>
                </div>
                <div class="hero-social-proof">
                    <div class="hero-avatars">
                        <div class="md-avatar">AB</div>
                        <div class="md-avatar" style="background:linear-gradient(135deg,#E8501A,#C8372A);">CF</div>
                        <div class="md-avatar" style="background:linear-gradient(135deg,#22C55E,#16A34A);">MR</div>
                        <div class="md-avatar" style="background:linear-gradient(135deg,#F59E0B,#D97706);">LS</div>
                    </div>
                    <p class="hero-proof-text">
                        <strong>+50 profissionais</strong> já formados.<br />
                        Junte-se a quem quer liderar tecnicamente.
                    </p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-carousel-wrap">

                    <!-- Janela única com carrossel -->
                    <div class="hero-window">
                        <!-- Titlebar dinâmica -->
                        <div class="hw-titlebar">
                            <div class="hw-dot" style="background:#ff5f57;"></div>
                            <div class="hw-dot" style="background:#ffbd2e;"></div>
                            <div class="hw-dot" style="background:#28ca41;"></div>
                            <span id="hc-title" style="margin-left:6px;">Catálogo de Formações — JAP Learning</span>
                        </div>

                        <!-- Slides -->
                        <div class="hc-slides">

                            <!-- ── Slide 1: Catálogo de Formações ── -->
                            <div class="hc-slide active" data-title="Catálogo de Formações — JAP Learning">
                                <div style="padding:12px;height:100%;display:flex;flex-direction:column;gap:8px;overflow:hidden;">
                                    <!-- Filtros -->
                                    <div style="display:flex;gap:5px;flex-wrap:wrap;">
                                        <span style="font-size:8px;background:rgba(232,80,26,0.15);border:1px solid rgba(232,80,26,0.4);color:#fb923c;padding:3px 10px;border-radius:10px;font-weight:600;">Todas</span>
                                        <span style="font-size:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:3px 10px;border-radius:10px;">Onboarding</span>
                                        <span style="font-size:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:3px 10px;border-radius:10px;">Arquitectura</span>
                                        <span style="font-size:8px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#64748b;padding:3px 10px;border-radius:10px;">Desenvolvimento</span>
                                    </div>
                                    <!-- Grid 2×3 -->
                                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:7px;flex:1;overflow:hidden;">
                                        @foreach (var (icon, color, bg, cat, lvl, title, meta) in new[]{
                                            ("bi-code-slash","#818cf8","rgba(99,102,241,0.18)","Onboarding","Iniciante","1 - Fundamentos em .NET","16 aulas · 1h 17m"),
                                            ("bi-grid-1x2-fill","#fb923c","rgba(232,80,26,0.18)","Onboarding","Intermédio","2 - ASP.NET Core MVC","22 aulas · 1h 50m"),
                                            ("bi-diagram-3-fill","#60a5fa","rgba(96,165,250,0.12)","Onboarding","Intermédio","3 - ASP.NET Core WebAPI","34 aulas · 2h 50m"),
                                            ("bi-layers-fill","#a78bfa","rgba(167,139,250,0.12)","Onboarding","Intermédio","4 - MVC Avançado","31 aulas · 6h 8m"),
                                            ("bi-award-fill","#4ade80","rgba(34,197,94,0.1)","Onboarding","Intermédio","5 - POO + SOLID + Clean Code","26 aulas · 4h"),
                                            ("bi-boxes","#f59e0b","rgba(245,158,11,0.1)","Arquitectura","Avançado","6 - Arquitectura em Camadas","8 aulas · 2h"),
                                        })
                                        {
                                            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:7px;overflow:hidden;display:flex;flex-direction:column;">
                                                <div style="height:32px;background:@bg;display:flex;align-items:center;justify-content:center;">
                                                    <i class="bi @icon" style="color:@color;font-size:14px;"></i>
                                                </div>
                                                <div style="padding:5px 6px;flex:1;">
                                                    <div style="display:flex;gap:3px;margin-bottom:2px;">
                                                        <span style="font-size:6.5px;background:rgba(232,80,26,0.12);color:#fb923c;padding:1px 4px;border-radius:3px;">@cat</span>
                                                        <span style="font-size:6.5px;background:rgba(255,255,255,0.06);color:#64748b;padding:1px 4px;border-radius:3px;">@lvl</span>
                                                    </div>
                                                    <div style="font-size:8px;font-weight:700;color:#e2e8f0;line-height:1.3;margin-bottom:2px;">@title</div>
                                                    <div style="font-size:7px;color:#475569;">@meta</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- ── Slide 2: Detalhe da Formação ── -->
                            <div class="hc-slide" data-title="4 - ASP.NET Core MVC Avançado — JAP Learning">
                                <div style="display:flex;height:100%;overflow:hidden;">
                                    <!-- Conteúdo principal -->
                                    <div style="flex:1;padding:12px;overflow:hidden;display:flex;flex-direction:column;gap:7px;border-right:1px solid rgba(255,255,255,0.06);">
                                        <!-- Thumbnail -->
                                        <div style="height:56px;background:linear-gradient(135deg,rgba(232,80,26,0.2),rgba(167,139,250,0.1));border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <i class="bi bi-grid-1x2-fill" style="color:#fb923c;font-size:20px;"></i>
                                        </div>
                                        <!-- Meta -->
                                        <div>
                                            <div style="font-size:10px;font-weight:800;color:#e2e8f0;margin-bottom:3px;">ASP.NET Core MVC Avançado</div>
                                            <div style="font-size:7.5px;color:#64748b;">Carlos Freire · Intermédio · Onboarding</div>
                                        </div>
                                        <!-- Tabs -->
                                        <div style="display:flex;gap:8px;border-bottom:1px solid rgba(255,255,255,0.07);padding-bottom:5px;">
                                            <span style="font-size:8px;color:#fb923c;border-bottom:1.5px solid #fb923c;padding-bottom:4px;font-weight:700;">Ementa</span>
                                            <span style="font-size:8px;color:#475569;">Apresentação</span>
                                            <span style="font-size:8px;color:#475569;">Instrutor</span>
                                        </div>
                                        <!-- Módulos -->
                                        <div style="overflow:hidden;flex:1;">
                                            <div style="font-size:7px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;">INTRODUÇÃO — 1 AULA</div>
                                            <div class="module-row"><i class="bi bi-play-circle-fill" style="color:#fb923c;font-size:9px;flex-shrink:0;"></i><span style="font-size:7.5px;color:#94a3b8;flex:1;">Apresentação e pré-requisitos</span><span style="font-size:6.5px;color:#475569;">7m</span></div>
                                            <div style="font-size:7px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin:5px 0 4px;">MÓDULO 1 — APROFUNDAR NO ESSENCIAL</div>
                                            <div class="module-row"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7.5px;color:#475569;flex:1;">Pipeline do ASP.NET</span><span style="font-size:6.5px;color:#334155;">43m</span></div>
                                            <div class="module-row"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7.5px;color:#475569;flex:1;">Ferramentas de Front-end</span><span style="font-size:6.5px;color:#334155;">26m</span></div>
                                            <div class="module-row" style="border:none;"><i class="bi bi-circle" style="color:#334155;font-size:9px;flex-shrink:0;"></i><span style="font-size:7.5px;color:#475569;flex:1;">Bundling e Minication</span><span style="font-size:6.5px;color:#334155;">26m</span></div>
                                        </div>
                                    </div>
                                    <!-- Sidebar direita -->
                                    <div style="width:130px;padding:10px;display:flex;flex-direction:column;gap:8px;overflow:hidden;">
                                        <div style="background:rgba(232,80,26,0.1);border:1px solid rgba(232,80,26,0.3);border-radius:5px;padding:5px 7px;text-align:center;">
                                            <div style="font-size:7px;font-weight:700;color:#fb923c;margin-bottom:3px;">FORMAÇÃO</div>
                                            <div style="font-size:7.5px;color:#e2e8f0;font-weight:600;line-height:1.3;margin-bottom:5px;">ASP.NET Core MVC Avançado</div>
                                            <div style="background:rgba(232,80,26,0.8);border-radius:4px;padding:4px;text-align:center;font-size:7px;color:#fff;font-weight:700;">▶ Continuar Formação</div>
                                        </div>
                                        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:5px;padding:6px 8px;">
                                            <div style="font-size:7px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">Informações</div>
                                            <div style="display:flex;align-items:center;gap:4px;margin-bottom:3px;"><i class="bi bi-clock" style="color:#64748b;font-size:8px;"></i><span style="font-size:7.5px;color:#64748b;">6h 8m</span></div>
                                            <div style="display:flex;align-items:center;gap:4px;margin-bottom:3px;"><i class="bi bi-collection-play" style="color:#64748b;font-size:8px;"></i><span style="font-size:7.5px;color:#64748b;">8 módulos</span></div>
                                            <div style="display:flex;align-items:center;gap:4px;"><i class="bi bi-play-btn" style="color:#64748b;font-size:8px;"></i><span style="font-size:7.5px;color:#64748b;">31 aulas</span></div>
                                        </div>
                                        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:5px;padding:6px 8px;">
                                            <div style="font-size:7px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">Pré-Requisitos</div>
                                            <div style="display:flex;align-items:center;gap:4px;margin-bottom:4px;"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:8px;flex-shrink:0;"></i><span style="font-size:7px;color:#64748b;">Fundamentos em .NET</span></div>
                                            <div style="display:flex;align-items:center;gap:4px;"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:8px;flex-shrink:0;"></i><span style="font-size:7px;color:#64748b;">ASP.NET Core MVC</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ── Slide 3: Player ── -->
                            <div class="hc-slide" data-title="Protecção contra CSRF — JAP Learning">
                                <div style="display:flex;height:100%;overflow:hidden;">
                                    <!-- Sidebar esquerda de lições -->
                                    <div style="width:135px;border-right:1px solid rgba(255,255,255,0.06);padding:8px;overflow:hidden;display:flex;flex-direction:column;gap:5px;">
                                        <!-- Barra de progresso geral -->
                                        <div style="margin-bottom:3px;">
                                            <div style="display:flex;justify-content:space-between;font-size:6.5px;color:#64748b;margin-bottom:3px;"><span>SEU PROGRESSO</span><span style="color:#fb923c;font-weight:700;">81%</span></div>
                                            <div style="background:rgba(255,255,255,0.06);border-radius:2px;height:3px;overflow:hidden;"><div style="background:linear-gradient(90deg,#e8501a,#fb923c);width:81%;height:100%;border-radius:2px;"></div></div>
                                        </div>
                                        <!-- Módulo + aulas -->
                                        <div style="font-size:6.5px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.05em;">INTRODUÇÃO</div>
                                        <div class="module-row" style="border:none;"><i class="bi bi-check-circle-fill" style="color:#4ade80;font-size:9px;flex-shrink:0;"></i><span style="font-size:7.5px;color:#64748b;flex:1;">Apresentação</span><span style="font-size:6.5px;color:#475569;">7:58</span></div>
                                        <div style="font-size:6.5px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-top:2px;">MÓDULO 1: APROFUNDAR</div>
                                        @foreach (var (name, time, done) in new[]{
                                            ("Pipeline do ASP.NET","41:56",true),
                                            ("Ferramentas de Front-end","20:31",true),
                                            ("Bundling e Minication","26:10",true),
                                            ("Trabalhar com Layouts","9:34",true),
                                            ("Tag Helper Customizado","44:32",true),
                                            ("View Component","9:32",true),
                                            ("Roteamento Inteligente","20:14",true),
                                        })
                                        {
                                            <div class="module-row" style="border:none;">
                                                <i class="bi bi-@(done?"check-circle-fill":"circle")" style="color:@(done?"#4ade80":"#334155");font-size:9px;flex-shrink:0;"></i>
                                                <span style="font-size:7px;color:@(done?"#64748b":"#475569");flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@name</span>
                                                <span style="font-size:6.5px;color:#334155;">@time</span>
                                            </div>
                                        }
                                    </div>
                                    <!-- Área principal: vídeo + info -->
                                    <div style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
                                        <!-- Breadcrumb -->
                                        <div style="padding:6px 10px;font-size:6.5px;color:#475569;border-bottom:1px solid rgba(255,255,255,0.05);">Minhas Formações / MVC Avançado / <span style="color:#94a3b8;">Protecção contra CSRF</span></div>
                                        <!-- Vídeo -->
                                        <div style="background:#000;height:140px;position:relative;flex-shrink:0;">
                                            <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(232,80,26,0.1),rgba(0,0,0,0.85));"></div>
                                            <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:5px;">
                                                <div style="width:36px;height:36px;background:rgba(232,80,26,0.9);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                                                    <i class="bi bi-play-fill" style="color:#fff;font-size:15px;margin-left:2px;"></i>
                                                </div>
                                                <span style="font-size:7.5px;color:rgba(255,255,255,0.65);">Protecção contra CSRF · 09:14</span>
                                            </div>
                                            <div style="position:absolute;bottom:0;left:0;right:0;padding:4px 8px;background:linear-gradient(transparent,rgba(0,0,0,0.85));">
                                                <div style="background:rgba(255,255,255,0.15);border-radius:2px;height:3px;"><div style="background:#e8501a;width:55%;height:100%;border-radius:2px;"></div></div>
                                                <div style="display:flex;justify-content:space-between;font-size:6px;color:rgba(255,255,255,0.4);margin-top:2px;"><span>5:02</span><span>9:14</span></div>
                                            </div>
