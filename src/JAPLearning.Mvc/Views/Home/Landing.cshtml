                </div>
            </div>
            <div class="col-lg-6" style="overflow:visible;">
                <div class="hero-scene">

                    <!-- Janela 1 (fundo): Dashboard Admin -->
                    <div class="hw hw-admin">
                        <div class="hw-titlebar">
                            <div class="hw-dot" style="background:#ff5f57;"></div>
                            <div class="hw-dot" style="background:#ffbd2e;"></div>
                            <div class="hw-dot" style="background:#28ca41;"></div>
                            <span style="margin-left:4px;">Dashboard — Administração</span>
                        </div>
                        <div class="hw-body" style="padding:10px;">
                            <!-- KPIs -->
