@{
    ViewData["Title"] = "JAPLearning — A plataforma de aprendizagem do Grupo JAP";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<style>
    .hero {
        min-height: 65vh;
        display: flex; align-items: center;
        position: relative; overflow: visible;
        padding: 48px 0 40px;
    }
    .hero::before {
        content: '';
        position: absolute; top: -200px; right: -200px;
        width: 700px; height: 700px;
        background: radial-gradient(circle, rgba(232,80,26,0.12) 0%, transparent 65%);
        pointer-events: none;
    }
    .hero::after {
        content: '';
        position: absolute; bottom: -150px; left: -150px;
        width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(160,31,58,0.08) 0%, transparent 65%);
        pointer-events: none;
    }
    .hero-eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(232,80,26,0.1); border: 1px solid rgba(232,80,26,0.25);
        border-radius: 20px; padding: 6px 14px;
        font-size: 12px; font-weight: 700; color: var(--md-accent);
        text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 24px;
    }
    .hero h1 {
        font-size: clamp(36px, 5vw, 58px); font-weight: 900;
        line-height: 1.1; margin-bottom: 24px; letter-spacing: -0.02em;
    }
    .hero-sub {
        font-size: 18px; color: var(--md-text-secondary);
        line-height: 1.7; margin-bottom: 36px; max-width: 520px;
    }
    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 48px; }
    .hero-social-proof { display: flex; align-items: center; gap: 16px; }
    .hero-avatars { display: flex; }
    .hero-avatars .md-avatar { width: 34px; height: 34px; font-size: 12px; margin-right: -8px; border: 2px solid var(--md-bg-primary); }
    .hero-proof-text { font-size: 13px; color: var(--md-text-secondary); }
    .hero-proof-text strong { color: var(--md-text-primary); }

    /* 4-window cascade */
    .hero-scene { position: relative; height: 486px; }
    .hw { position: absolute; width: 321px; height: 391px; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; }
    .hw-titlebar { display: flex; align-items: center; gap: 6px; padding: 8px 12px; font-size: 10px; color: #94a3b8; flex-shrink: 0; }
    .hw-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
    .hw-body { flex: 1; overflow: hidden; }

    /* Posicionamento das 4 janelas */
    .hw-admin   { top:0;    right:191px; z-index:1; background:#0f1824; border:1px solid rgba(232,80,26,0.38); box-shadow:0 8px 40px rgba(0,0,0,0.6); }
    .hw-admin   .hw-titlebar { background:#141e2e; border-bottom:1px solid rgba(232,80,26,0.3); }
    .hw-catalog { top:32px; right:128px; z-index:2; background:#0c1220; border:1px solid rgba(99,102,241,0.4);  box-shadow:0 8px 40px rgba(0,0,0,0.52); }
    .hw-catalog .hw-titlebar { background:#111827; border-bottom:1px solid rgba(99,102,241,0.3); }
    .hw-detail  { top:64px; right:64px;  z-index:3; background:#0d1520; border:1px solid rgba(232,80,26,0.32); box-shadow:0 8px 40px rgba(0,0,0,0.48); }
    .hw-detail  .hw-titlebar { background:#121a2a; border-bottom:1px solid rgba(232,80,26,0.25); }
    .hw-player  { top:96px; right:0;     z-index:4; background:#080e18; border:1px solid rgba(255,255,255,0.12); box-shadow:0 8px 40px rgba(0,0,0,0.45); }
    .hw-player  .hw-titlebar { background:#0d1320; border-bottom:1px solid rgba(255,255,255,0.1); }

    /* Shared mini components */
    .kpi-mini { display: grid; grid-template-columns: repeat(4,1fr); gap: 4px; margin-bottom: 8px; }
    .kpi-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 5px; padding: 5px 4px; text-align: center; }
    .kpi-val  { font-size: 12px; font-weight: 800; color: #e2e8f0; display: block; }
    .kpi-lbl  { font-size: 7px; color: #64748b; line-height: 1.2; }
    .dash-row { display: flex; justify-content: space-between; font-size: 9px; color: #64748b; padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .module-row { display: flex; align-items: center; gap: 6px; padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .course-card-mini { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; overflow: hidden; margin-bottom: 6px; }

    /* Stats & features */
    .stat-card { background: var(--md-bg-card); border: 1px solid var(--md-border); border-radius: var(--md-radius); padding: 20px; text-align: center; }
    .stat-number { font-size: 32px; font-weight: 900; background: var(--md-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; display: block; }
    .stat-label { font-size: 13px; color: var(--md-text-muted); margin-top: 4px; }
    .feature-icon { width: 48px; height: 48px; background: rgba(232,80,26,0.1); border: 1px solid rgba(232,80,26,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: var(--md-accent); margin-bottom: 16px; }
    .md-section { padding: 80px 0; }
    .md-section-alt { background: var(--md-bg-secondary); }

    /* Testimonials */
    .testimonials-dot { background: var(--md-border); transition: var(--md-transition); }
    .testimonials-dot.active { background: var(--md-accent); transform: scale(1.3); }
    .testimonials-dot:hover { background: var(--md-text-muted); }
    .testimonials-nav:hover { border-color: var(--md-accent) !important; color: var(--md-accent) !important; }
    .testimonials-nav:disabled { opacity: 0.4; cursor: not-allowed; }
    .testimonial-linkedin:hover { color: #0a4d8c !important; transform: translateY(-2px); }
</style>

<!-- Hero -->
<section class="hero">
    <div class="container position-relative" style="z-index:1;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-eyebrow">
                    <i class="bi bi-mortarboard-fill"></i> Plataforma de Aprendizagem do Grupo JAP
                </div>
                <h1>
                    Desenvolve as competências<br />
