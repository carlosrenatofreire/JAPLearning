@{
    ViewData["Title"] = "Quem Somos";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<style>
    .about-hero { padding: 72px 0 56px; border-bottom: 1px solid var(--md-border); margin-bottom: 64px; }
    .timeline-item {
        display: flex; gap: 24px;
        padding-bottom: 32px; position: relative;
    }
    .timeline-item::before {
        content: '';
        position: absolute; left: 19px; top: 40px; bottom: 0;
        width: 2px; background: var(--md-border);
    }
    .timeline-item:last-child::before { display: none; }
    .timeline-dot {
        width: 40px; height: 40px;
        background: var(--md-gradient);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px; color: #fff;
        flex-shrink: 0; z-index: 1;
    }
    .value-card {
        background: var(--md-bg-card); border: 1px solid var(--md-border);
        border-radius: var(--md-radius); padding: 24px; text-align: center;
    }
    .value-icon {
        width: 52px; height: 52px;
        background: rgba(232,80,26,0.1); border: 1px solid rgba(232,80,26,0.2);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 24px; color: var(--md-accent);
        margin: 0 auto 16px;
    }
</style>

<!-- Hero -->
<section class="about-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="md-badge md-badge-accent mb-3 d-inline-block">Sobre a JAPLearning</span>
                <h1 style="font-size:42px; font-weight:900; line-height:1.15; margin-bottom:20px;">
                    A plataforma de aprendizagem<br />
                    <span class="md-gradient-text">do Grupo JAP.</span>
                </h1>
                <p style="color:var(--md-text-secondary); font-size:17px; line-height:1.8; margin-bottom:24px;">
                    A JAPLearning nasceu da necessidade de centralizar e estruturar a formação interna
                    do Grupo JAP, garantindo que cada colaborador tem acesso aos conteúdos certos,
                    no momento certo, ao seu próprio ritmo.
                </p>
                <p style="color:var(--md-text-secondary); font-size:17px; line-height:1.8;">
                    Uma plataforma privada, pensada para as equipas da empresa, com formações práticas
                    orientadas aos desafios reais do negócio.
                </p>
            </div>
            <div class="col-lg-5">
                <div class="md-card text-center">
                    <div class="value-icon mx-auto mb-3" style="width:88px;height:88px;font-size:36px;border-radius:50%;border:3px solid var(--md-accent);">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <h4 style="font-weight:800; margin-bottom:4px;">JAP Learning</h4>
                    <p style="color:var(--md-accent); font-size:14px; font-weight:600; margin-bottom:12px;">Plataforma Interna do Grupo JAP</p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap mb-3">
                        <span class="md-badge md-badge-info">Formação</span>
                        <span class="md-badge md-badge-accent">Equipas</span>
                        <span class="md-badge md-badge-success">Certificados</span>
                    </div>
                    <p style="color:var(--md-text-secondary); font-size:14px; line-height:1.7; margin-bottom:0;">
                        Acesso centralizado a formações práticas, acompanhamento de progresso
                        por equipa e emissão de certificados digitais para todos os colaboradores.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Missão, Visão, Valores -->
<section style="padding:0 0 64px;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 style="font-size:32px; font-weight:900; margin-bottom:12px;">O que nos move</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="value-card">
                    <div class="value-icon"><i class="bi bi-bullseye"></i></div>
                    <h5 style="font-weight:700; margin-bottom:10px;">Missão</h5>
                    <p style="font-size:14px; color:var(--md-text-secondary); margin:0; line-height:1.7;">
                        Promover o desenvolvimento contínuo dos colaboradores do Grupo JAP,
                        disponibilizando formações práticas e acessíveis a todas as equipas.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div class="value-icon"><i class="bi bi-eye"></i></div>
                    <h5 style="font-weight:700; margin-bottom:10px;">Visão</h5>
                    <p style="font-size:14px; color:var(--md-text-secondary); margin:0; line-height:1.7;">
                        Ser o principal recurso de aprendizagem interna do Grupo JAP, reconhecido
                        pela relevância, qualidade e impacto no desenvolvimento das equipas.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div class="value-icon"><i class="bi bi-gem"></i></div>
                    <h5 style="font-weight:700; margin-bottom:10px;">Valores</h5>
                    <p style="font-size:14px; color:var(--md-text-secondary); margin:0; line-height:1.7;">
                        Rigor, aplicabilidade prática, respeito pelo ritmo de cada colaborador
                        e compromisso com o crescimento profissional genuíno das equipas.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Trajetória -->
<section style="padding:0 0 80px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <h2 style="font-size:28px; font-weight:900; margin-bottom:40px;">A Nossa História</h2>
                <div class="timeline-item">
                    <div class="timeline-dot"><i class="bi bi-building"></i></div>
                    <div>
                        <p style="font-size:12px; color:var(--md-accent); font-weight:700; margin-bottom:4px;">Fundação — Grupo JAP</p>
                        <p style="font-weight:700; margin-bottom:6px; color:var(--md-text-primary);">Constituição do Grupo JAP</p>
                        <p style="font-size:14px; color:var(--md-text-secondary); margin:0;">O Grupo JAP inicia a sua actividade com o compromisso de investir continuamente no desenvolvimento dos seus colaboradores.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-dot"><i class="bi bi-people"></i></div>
                    <div>
                        <p style="font-size:12px; color:var(--md-accent); font-weight:700; margin-bottom:4px;">Crescimento — Equipas</p>
                        <p style="font-weight:700; margin-bottom:6px; color:var(--md-text-primary);">Expansão das Equipas</p>
                        <p style="font-size:14px; color:var(--md-text-secondary); margin:0;">Com o crescimento do grupo, surgiu a necessidade de uma solução centralizada para gerir e acompanhar a formação interna.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-dot"><i class="bi bi-mortarboard"></i></div>
                    <div>
                        <p style="font-size:12px; color:var(--md-accent); font-weight:700; margin-bottom:4px;">Formação Interna</p>
                        <p style="font-weight:700; margin-bottom:6px; color:var(--md-text-primary);">Primeiras Formações Estruturadas</p>
                        <p style="font-size:14px; color:var(--md-text-secondary); margin:0;">Início das formações internas estruturadas, com mais de 50 colaboradores já envolvidos no processo de aprendizagem contínua.</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-dot"><i class="bi bi-rocket-takeoff"></i></div>
                    <div>
                        <p style="font-size:12px; color:var(--md-accent); font-weight:700; margin-bottom:4px;">2026 — JAPLearning</p>
                        <p style="font-weight:700; margin-bottom:6px; color:var(--md-text-primary);">Lançamento da Plataforma</p>
                        <p style="font-size:14px; color:var(--md-text-secondary); margin:0;">Criação da JAPLearning para centralizar toda a formação interna do Grupo JAP numa plataforma digital moderna e acessível a todas as equipas.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section style="background:var(--md-bg-secondary); padding:64px 0; border-top:1px solid var(--md-border);">
    <div class="container text-center">
        <h2 style="font-size:30px; font-weight:900; margin-bottom:12px;">Faz parte da equipa JAP?</h2>
        <p style="color:var(--md-text-secondary); font-size:16px; max-width:460px; margin:0 auto 28px;">
            Acede à plataforma e começa hoje a desenvolver as tuas competências.
        </p>
        <a asp-controller="Account" asp-action="Login" class="btn-md-primary" style="font-size:16px; padding:13px 30px;">
            Entrar na Plataforma <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</section>
