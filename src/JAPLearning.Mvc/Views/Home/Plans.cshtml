@model List<JAPLearning.Business.Models.Domains.Entities.Plan>
@using JAPLearning.Business.Models.Enums
@{
    ViewData["Title"] = "Planos";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<style>
    .plans-hero { padding: 64px 0 56px; border-bottom: 1px solid var(--md-border); margin-bottom: 64px; text-align: center; }
    .plan-card {
        background: var(--md-bg-card); border: 1px solid var(--md-border);
        border-radius: var(--md-radius); padding: 36px 28px;
        display: flex; flex-direction: column; gap: 0;
        transition: var(--md-transition); position: relative; overflow: hidden;
    }
    .plan-card.featured {
        border-color: var(--md-accent);
        background: linear-gradient(160deg, rgba(232,80,26,0.06) 0%, var(--md-bg-card) 60%);
    }
    .plan-card:hover { transform: translateY(-3px); box-shadow: 0 16px 48px rgba(0,0,0,0.3); }
    .plan-badge-top {
        position: absolute; top: -1px; left: 50%; transform: translateX(-50%);
        background: var(--md-gradient); color: #fff;
        font-size: 11px; font-weight: 700; padding: 4px 16px;
        border-radius: 0 0 10px 10px; text-transform: uppercase; letter-spacing: .06em;
    }
    .plan-price { font-size: 48px; font-weight: 900; color: var(--md-text-primary); line-height: 1; }
    .plan-price sup { font-size: 22px; vertical-align: top; margin-top: 10px; }
    .plan-price span { font-size: 16px; font-weight: 500; color: var(--md-text-muted); }
    .plan-features { list-style: none; padding: 0; margin: 0; }
    .plan-features li {
        display: flex; align-items: center; gap: 10px;
        padding: 8px 0; font-size: 14px; color: var(--md-text-secondary);
        border-bottom: 1px solid var(--md-border);
    }
    .plan-features li:last-child { border-bottom: none; }
    .plan-features li i { color: var(--md-accent); font-size: 16px; flex-shrink: 0; }
</style>

<!-- Hero -->
<section class="plans-hero">
    <div class="container">
        <span class="md-badge md-badge-accent mb-3 d-inline-block">Planos</span>
        <h1 style="font-size:42px; font-weight:900; margin-bottom:16px;">
            Invista na sua <span class="md-gradient-text">carreira</span>
        </h1>
        <p style="color:var(--md-text-secondary); font-size:17px; max-width:520px; margin:0 auto; line-height:1.7;">
            Escolha o plano que melhor se adapta ao seu ritmo. Cancele quando quiser.
        </p>
    </div>
</section>

<section style="padding:0 0 80px;">
    <div class="container">

        @if (!Model.Any())
        {
            <div style="text-align:center; padding:80px 0; color:var(--md-text-muted);">
                <i class="bi bi-credit-card" style="font-size:48px; display:block; margin-bottom:16px;"></i>
                <p style="font-size:16px;">Nenhum plano disponível no momento.</p>
            </div>
        }
        else
        {
            <div class="row g-4 justify-content-center">
                @foreach (var plan in Model)
                {
                    var isAnnual  = plan.PlanType == PlanType.Annual;
                    var isRequest = plan.PlanType == PlanType.OnRequest;
                    var featured  = isAnnual;
                    var priceLabel = isRequest ? "Sob consulta" : (plan.Price.HasValue ? plan.Price.Value.ToString("N2") : "—");
                    var periodLabel = plan.Months.HasValue
                        ? (plan.Months == 1 ? "/mês" : $"/{plan.Months} meses")
                        : "";

                    <div class="col-md-6 col-lg-4">
                        <div class="plan-card @(featured ? "featured" : "")">
                            @if (featured)
                            {
                                <div class="plan-badge-top">Mais popular</div>
                            }
                            <div style="margin-bottom:24px; @(featured ? "margin-top:16px;" : "")">
                                <h4 style="font-weight:800; color:var(--md-text-primary); margin-bottom:6px;">@plan.Name</h4>
                                @if (!string.IsNullOrWhiteSpace(plan.Description))
                                {
                                    <p style="font-size:13px; color:var(--md-text-secondary); margin:0; line-height:1.6;">@plan.Description</p>
                                }
                            </div>

                            <div style="margin-bottom:28px;">
                                @if (isRequest)
                                {
                                    <p class="plan-price" style="font-size:28px;">Sob consulta</p>
                                }
                                else
                                {
                                    <p class="plan-price">
                                        <sup>R$</sup>@priceLabel<span>@periodLabel</span>
                                    </p>
                                    @if (plan.Promotion == true && plan.DiscountPercent.HasValue)
                                    {
                                        <p style="font-size:13px; color:var(--md-accent); font-weight:700; margin-top:6px; margin-bottom:0;">
                                            <i class="bi bi-tag"></i> @plan.DiscountPercent% de desconto incluído
                                        </p>
                                    }
                                }
                            </div>

                            <ul class="plan-features" style="margin-bottom:28px;">
                                <li><i class="bi bi-check-lg"></i> Acesso a todos os projetos</li>
                                <li><i class="bi bi-check-lg"></i> Novos conteúdos sem custo extra</li>
                                <li><i class="bi bi-check-lg"></i> Certificados digitais</li>
                                @if (isAnnual)
                                {
                                    <li><i class="bi bi-check-lg"></i> 1 sessão mensal de mentoria (45 min)</li>
                                    <li><i class="bi bi-check-lg"></i> Acesso prioritário a novidades</li>
                                }
                                @if (isRequest)
                                {
                                    <li><i class="bi bi-check-lg"></i> Formação personalizada para equipa</li>
                                    <li><i class="bi bi-check-lg"></i> Suporte dedicado</li>
                                }
                                <li><i class="bi bi-check-lg"></i> Cancele a qualquer momento</li>
                            </ul>

                            <a asp-controller="Account" asp-action="Login"
                               class="@(featured ? "btn-md-primary" : "btn-md-ghost")"
                               style="width:100%; text-align:center; padding:12px 0; border:@(featured ? "none" : "1px solid var(--md-border)");">
                                @(isRequest ? "Entrar em contacto" : "Começar agora")
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Garantia -->
        <div style="text-align:center; margin-top:48px; padding:32px; background:var(--md-bg-card); border:1px solid var(--md-border); border-radius:var(--md-radius); max-width:560px; margin-left:auto; margin-right:auto;">
            <i class="bi bi-shield-check" style="font-size:32px; color:var(--md-accent); display:block; margin-bottom:12px;"></i>
            <h5 style="font-weight:800; margin-bottom:8px;">Garantia de 7 dias</h5>
            <p style="font-size:14px; color:var(--md-text-secondary); margin:0; line-height:1.7;">
                Não gostou? Reembolso integral nos primeiros 7 dias, sem perguntas.
            </p>
        </div>
    </div>
</section>
