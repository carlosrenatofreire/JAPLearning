<style>
    .welcome-banner {
        background: linear-gradient(135deg, rgba(232,80,26,0.12) 0%, rgba(160,31,58,0.06) 100%);
        border: 1px solid rgba(232,80,26,0.2);
        border-radius: var(--md-radius-lg);
        padding: 24px 28px;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }
    .kpi-card {
        background: var(--md-bg-card);
        border: 1px solid var(--md-border);
        border-radius: var(--md-radius);
        padding: 20px;
    }
    .kpi-value { font-size: 28px; font-weight: 800; color: var(--md-text-primary); }
    .kpi-label { font-size: 13px; color: var(--md-text-muted); margin-top: 4px; }
    .kpi-icon {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px;
        margin-bottom: 12px;
    }
</style>

@{
    var firstName = (User.Identity?.Name ?? "").Split(' ')[0];
}

<!-- Welcome -->
<div class="welcome-banner">
    <div>
        <h3 style="font-weight:800; margin-bottom:4px;">Olá, @firstName! 👋</h3>
        <p style="color:var(--md-text-secondary); margin:0; font-size:14px;">Continue aprendendo. O seu próximo certificado está a caminho.</p>
    </div>
    <a asp-controller="Home" asp-action="MyCourses" class="btn-md-primary">
        Minhas Formações <i class="bi bi-arrow-right"></i>
    </a>
</div>

<!-- KPIs -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(99,102,241,0.12); color:#818CF8;">
                <i class="bi bi-collection-play"></i>
            </div>
            <div class="kpi-value">0</div>
            <div class="kpi-label">Formações em Curso</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(34,197,94,0.12); color:var(--md-success);">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="kpi-value">0</div>
            <div class="kpi-label">Concluídos</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(245,158,11,0.12); color:var(--md-warning);">
                <i class="bi bi-award"></i>
            </div>
            <div class="kpi-value">0</div>
            <div class="kpi-label">Certificados</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(232,80,26,0.12); color:var(--md-accent);">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="kpi-value">0h</div>
            <div class="kpi-label">Horas Assistidas</div>
        </div>
    </div>
</div>

<!-- Placeholder -->
<div class="row g-4">
    <div class="col-12">
        <div class="md-card text-center" style="padding:48px 24px;">
            <i class="bi bi-collection-play" style="font-size:48px; color:var(--md-border); display:block; margin-bottom:16px;"></i>
            <h5 style="font-weight:700; margin-bottom:8px;">Ainda não iniciaste nenhuma formação</h5>
            <p style="color:var(--md-text-muted); font-size:14px; margin-bottom:24px;">Explora o catálogo e começa a aprender hoje.</p>
            <a href="#" class="btn-md-primary">
                <i class="bi bi-search"></i> Explorar Formações
            </a>
        </div>
    </div>
</div>
