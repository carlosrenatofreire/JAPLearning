@model List<JAPLearning.Business.Models.Domains.Entities.Article>
@{
    ViewData["Title"] = "Artigos";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
    var subjects = ViewBag.Subjects as List<JAPLearning.Business.Models.Domains.Parameters.Subject> ?? new();
}

<style>
    .blog-hero { padding: 64px 0 48px; border-bottom: 1px solid var(--md-border); margin-bottom: 56px; }
    .article-card {
        background: var(--md-bg-card); border: 1px solid var(--md-border);
        border-radius: var(--md-radius); overflow: hidden;
        transition: var(--md-transition); display: flex; flex-direction: column;
    }
    .article-card:hover { border-color: rgba(232,80,26,0.4); transform: translateY(-2px); }
    .article-cover {
        width: 100%; aspect-ratio: 16/9; object-fit: cover;
    }
    .article-cover-placeholder {
        width: 100%; aspect-ratio: 16/9;
        background: linear-gradient(135deg, rgba(232,80,26,0.10), rgba(160,31,58,0.06));
        display: flex; align-items: center; justify-content: center;
        font-size: 36px; color: var(--md-accent);
    }
    .article-body { padding: 22px; flex: 1; display: flex; flex-direction: column; }
    .article-title {
        font-size: 16px; font-weight: 700; color: var(--md-text-primary);
        margin-bottom: 8px; line-height: 1.4;
    }
    .article-desc {
        font-size: 13px; color: var(--md-text-secondary);
        line-height: 1.7; margin-bottom: 16px; flex: 1;
    }
    .filter-btn {
        padding: 8px 18px; border-radius: 20px; font-size: 13px; font-weight: 600;
        border: 1px solid var(--md-border); background: transparent;
        color: var(--md-text-secondary); cursor: pointer; transition: var(--md-transition);
    }
    .filter-btn:hover, .filter-btn.active {
        border-color: var(--md-accent); color: var(--md-accent);
        background: rgba(232,80,26,0.08);
    }
</style>

<!-- Hero -->
<section class="blog-hero">
    <div class="container">
        <span class="md-badge md-badge-accent mb-3 d-inline-block">Artigos</span>
        <h1 style="font-size:40px; font-weight:900; margin-bottom:16px;">
            Artigos & <span class="md-gradient-text">Conteúdo</span>
        </h1>
        <p style="color:var(--md-text-secondary); font-size:17px; max-width:540px; line-height:1.7; margin:0;">
            Conteúdo prático partilhado pelas equipas do Grupo JAP para o teu desenvolvimento profissional.
        </p>
    </div>
</section>

<section style="padding:0 0 80px;">
    <div class="container">

        @if (!Model.Any())
        {
            <div style="text-align:center; padding:80px 0; color:var(--md-text-muted);">
                <i class="bi bi-newspaper" style="font-size:48px; display:block; margin-bottom:16px;"></i>
                <p style="font-size:16px;">Nenhum artigo publicado ainda. Fique atento!</p>
            </div>
        }
        else
        {
            <!-- Filtros por assunto -->
            @if (subjects.Any())
            {
                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:32px;">
                    <span style="font-size:13px; color:var(--md-text-muted); font-weight:600;">Assunto:</span>
                    <button class="filter-btn active" data-subject="all">Todos</button>
                    @foreach (var s in subjects)
                    {
                        <button class="filter-btn" data-subject="@s.Id">@s.Name</button>
                    }
                </div>
            }

            <div id="articles-grid" class="row g-4">
                @foreach (var article in Model)
                {
                    var subjectId = article.Subject?.Id.ToString() ?? "";
                    <div class="col-sm-6 col-lg-4 article-item" data-subject="@subjectId">
                        <div class="article-card">
                            @if (!string.IsNullOrWhiteSpace(article.CoverImage))
                            {
                                <img src="@article.CoverImage" alt="@article.Name" class="article-cover" />
                            }
                            else
                            {
                                <div class="article-cover-placeholder">
                                    <i class="bi bi-journal-text"></i>
                                </div>
                            }
                            <div class="article-body">
                                <div style="display:flex; gap:8px; margin-bottom:10px; flex-wrap:wrap; align-items:center;">
                                    @if (article.Subject != null)
                                    {
                                        <span class="md-badge md-badge-info">@article.Subject.Name</span>
                                    }
                                    @if (article.ReadingTime.HasValue)
                                    {
                                        <span style="font-size:11px; color:var(--md-text-muted);">
                                            <i class="bi bi-clock"></i> @article.ReadingTime min
                                        </span>
                                    }
                                </div>
                                <p class="article-title">@article.Name</p>
                                @if (!string.IsNullOrWhiteSpace(article.Description))
                                {
                                    <p class="article-desc">@article.Description</p>
                                }
                                <div style="display:flex; align-items:center; justify-content:space-between; margin-top:auto;">
                                    <span style="font-size:12px; color:var(--md-text-muted);">
                                        <i class="bi bi-calendar3"></i>
                                        @article.PublishDate.ToString("dd MMM yyyy")
                                    </span>
                                    <a asp-controller="Account" asp-action="Login"
                                       style="font-size:13px; color:var(--md-accent); text-decoration:none; font-weight:600;">
                                        Ler mais <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div id="articles-empty" style="display:none; text-align:center; padding:60px 0; color:var(--md-text-muted);">
                <i class="bi bi-search" style="font-size:32px; display:block; margin-bottom:8px;"></i>
                Nenhum artigo encontrado neste assunto.
            </div>
        }
    </div>
</section>

@section Scripts {
<script>
    (function () {
        const btns  = document.querySelectorAll('.filter-btn[data-subject]');
        const items = document.querySelectorAll('.article-item');
        const empty = document.getElementById('articles-empty');
        if (!btns.length) return;

        btns.forEach(btn => btn.addEventListener('click', function () {
            const filter = this.dataset.subject;
            btns.forEach(b => b.classList.toggle('active', b === this));
            let visible = 0;
            items.forEach(item => {
                const match = filter === 'all' || item.dataset.subject === filter;
                item.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
        }));
    })();
</script>
}
