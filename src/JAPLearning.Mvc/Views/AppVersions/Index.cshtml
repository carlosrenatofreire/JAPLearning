@model List<JAPLearning.Business.Models.Domains.Auxiliaries.AppVersion>
@using JAPLearning.Business.Models.Domains.Auxiliaries
@{
    ViewData["Title"] = "Versões da Aplicação";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Versões da Aplicação</h4>
        <p class="page-header-sub">Histórico de releases e novidades publicadas aos utilizadores</p>
    </div>
    <a asp-action="Create" class="btn-md-primary">
        <i class="bi bi-plus-lg"></i> Nova Versão
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success-md mb-3"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="md-card" style="padding:0; overflow:hidden;">
    @if (!Model.Any())
    {
        <div style="text-align:center; padding:60px; color:var(--md-text-muted);">
            <i class="bi bi-clock-history" style="font-size:40px; display:block; margin-bottom:12px;"></i>
            <p style="margin:0;">Ainda não existe nenhuma versão registada.</p>
        </div>
    }
    else
    {
        <table class="crud-table" style="margin:0;">
            <thead>
                <tr>
                    <th style="width:100px;">Versão</th>
                    <th>Título</th>
                    <th style="width:130px;">Data</th>
                    <th style="width:80px; text-align:center;">Itens</th>
                    <th style="width:100px; text-align:center;">Estado</th>
                    <th style="width:100px; text-align:center;">Acções</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td>
                            <span style="font-weight:800; font-size:14px; color:var(--md-accent);">
                                v@(v.VersionNumber)
                            </span>
                        </td>
                        <td style="font-weight:600; font-size:13px;">@v.Title</td>
                        <td style="font-size:13px; color:var(--md-text-muted);">
                            @v.ReleaseDate.ToString("dd/MM/yyyy")
                        </td>
                        <td style="text-align:center;">
                            <span style="font-weight:700; font-size:13px; color:var(--md-text-secondary);">
                                @v.Items.Count
                            </span>
                        </td>
                        <td style="text-align:center;">
                            @if (v.IsPublished)
                            {
                                <span class="badge-active">Publicada</span>
                            }
                            else
                            {
                                <span style="font-size:11px; font-weight:700; padding:3px 10px;
                                             border-radius:20px; background:rgba(107,114,128,0.12);
                                             color:var(--md-text-muted);">Rascunho</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <div style="display:flex; gap:6px; justify-content:center;">
                                <a asp-action="Edit" asp-route-id="@v.Id"
                                   class="action-btn" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" method="post" style="margin:0;"
                                      onsubmit="return confirm('Eliminar versão v@v.VersionNumber e todos os seus itens?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.Id" />
                                    <button type="submit" class="action-btn danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
