@model JAPLearning.Mvc.ViewModels.Entities.LessonViewModel
@{
    ViewData["Title"] = "Editar Lição";
    var selectedTeamId = ViewBag.SelectedTeamId as Guid?;
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Lição</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-text-muted);">Lições</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> Editar</p>
    </div>
</div>

<div class="md-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="row g-3">

            <!-- Equipa | Formação | Tópico -->
            <div class="col-md-3">
                <div class="md-form-row">
                    <label class="md-label">Equipa</label>
                    <select id="teamFilter" asp-items="ViewBag.Teams" class="md-select">
                        <option value="">Seleccionar equipa...</option>
                    </select>
                </div>
            </div>
            <div class="col-md-5">
                <div class="md-form-row">
                    <label asp-for="CourseId" class="md-label">Formação</label>
                    <select asp-for="CourseId" asp-items="ViewBag.Courses" class="md-select" id="courseSelect"
                            disabled="@(!selectedTeamId.HasValue)">
                        <option value="">@(selectedTeamId.HasValue ? "Seleccionar formação..." : "Seleccionar equipa primeiro...")</option>
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="md-form-row">
                    <label asp-for="TopicId" class="md-label">Tópico</label>
                    <select asp-for="TopicId" asp-items="ViewBag.Topics" class="md-select" id="topicSelect"
                            disabled="@(Model.CourseId == Guid.Empty)">
                        <option value="">@(Model.CourseId != Guid.Empty ? "Seleccionar tópico..." : "Seleccionar formação primeiro...")</option>
                    </select>
                    <span asp-validation-for="TopicId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>

            <!-- Nome | Ordem -->
            <div class="col-md-8">
                <div class="md-form-row">
                    <label asp-for="Name" class="md-label">Nome</label>
                    <input asp-for="Name" class="md-input" placeholder="Nome da lição" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="md-form-row">
                    <label asp-for="Order" class="md-label">Ordem</label>
                    <input asp-for="Order" class="md-input" type="number" min="1" />
                </div>
            </div>

            <!-- Descrição -->
            <div class="col-12">
                <div class="md-form-row">
                    <label asp-for="Description" class="md-label">Descrição</label>
                    <textarea asp-for="Description" class="md-input" rows="2" placeholder="Descrição opcional"></textarea>
                </div>
            </div>

            <!-- URL Vídeo | Duração -->
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="Video" class="md-label">URL do Vídeo</label>
                    <input asp-for="Video" class="md-input" placeholder="https://..." />
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="TimeLesson" class="md-label">Duração (hh:mm:ss)</label>
                    <input asp-for="TimeLesson" class="md-input" placeholder="00:05:30" />
                </div>
            </div>

            <!-- Checkboxes -->
            <div class="col-12">
                <div class="row g-2">
                    <div class="col-md-4">
                        <div class="md-form-check">
                            <input asp-for="IsActived" type="checkbox" />
                            <label asp-for="IsActived">Activo</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="md-form-check">
                            <input asp-for="IsTest" type="checkbox" />
                            <label asp-for="IsTest">É Teste/Quiz</label>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    (function () {
        const teamSel        = document.getElementById('teamFilter');
        const courseSel      = document.getElementById('courseSelect');
        const topicSel       = document.getElementById('topicSelect');
        const selectedTeam   = '@(selectedTeamId?.ToString() ?? "")';
        const selectedCourse = '@Model.CourseId';
        const selectedTopic  = '@Model.TopicId';

        function loadTopics(courseId, preselectId) {
            topicSel.innerHTML = '<option value="">A carregar...</option>';
            topicSel.disabled  = true;
            fetch('/Topics/GetByCourse?courseId=' + courseId)
                .then(r => r.json())
                .then(data => {
                    if (data.length === 0) {
                        topicSel.innerHTML = '<option value="">Sem tópicos nesta formação</option>';
                        return;
                    }
                    topicSel.innerHTML = '<option value="">Seleccionar tópico...</option>';
                    data.forEach(t => {
                        const opt = document.createElement('option');
                        opt.value = t.id; opt.text = t.name;
                        if (preselectId && t.id === preselectId) opt.selected = true;
                        topicSel.appendChild(opt);
                    });
                    topicSel.disabled = false;
                });
        }

        function loadCourses(teamId, preselectCourseId, preselectTopicId) {
            courseSel.innerHTML = '<option value="">A carregar...</option>';
            courseSel.disabled  = true;
            topicSel.innerHTML  = '<option value="">Seleccionar formação primeiro...</option>';
            topicSel.disabled   = true;

            fetch('/Lessons/GetCoursesByTeam?teamId=' + teamId)
                .then(r => r.json())
                .then(data => {
                    if (data.length === 0) {
                        courseSel.innerHTML = '<option value="">Sem formações nesta equipa</option>';
                        return;
                    }
                    courseSel.innerHTML = '<option value="">Seleccionar formação...</option>';
                    let found = false;
                    data.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.value; opt.text = c.text;
                        if (preselectCourseId && c.value === preselectCourseId) {
                            opt.selected = true;
                            found = true;
                        }
                        courseSel.appendChild(opt);
                    });
                    courseSel.disabled = false;
                    if (found && preselectCourseId) loadTopics(preselectCourseId, preselectTopicId);
                });
        }

        // On load: restore full cascade if team is known
        if (selectedTeam) {
            teamSel.value = selectedTeam;
            loadCourses(selectedTeam, selectedCourse, selectedTopic);
        }

        teamSel.addEventListener('change', function () {
            const teamId = this.value;
            if (!teamId) {
                courseSel.innerHTML = '<option value="">Seleccionar equipa primeiro...</option>';
                courseSel.disabled  = true;
                topicSel.innerHTML  = '<option value="">Seleccionar formação primeiro...</option>';
                topicSel.disabled   = true;
                return;
            }
            loadCourses(teamId, null, null);
        });

        courseSel.addEventListener('change', function () {
            if (!this.value) {
                topicSel.innerHTML = '<option value="">Seleccionar formação primeiro...</option>';
                topicSel.disabled  = true;
                return;
            }
            loadTopics(this.value, null);
        });
    })();
</script>
}
