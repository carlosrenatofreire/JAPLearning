@model JAPLearning.Mvc.ViewModels.Entities.LessonViewModel
@{
    ViewData["Title"] = "Nova Lição";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Nova Lição</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-text-muted);">Lições</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> Nova</p>
    </div>
</div>

<div class="md-card" style="max-width:780px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="md-alert md-alert-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="CourseId" class="md-label">Curso</label>
                    <select asp-for="CourseId" asp-items="ViewBag.Courses" class="md-select" id="courseSelect" onchange="loadTopics(this.value)">
                        <option value="">Seleccionar curso...</option>
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="TopicId" class="md-label">Tópico</label>
                    <select asp-for="TopicId" asp-items="ViewBag.Topics" class="md-select" id="topicSelect">
                        <option value="">Seleccionar tópico...</option>
                    </select>
                    <span asp-validation-for="TopicId" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-8">
                <div class="md-form-row">
                    <label asp-for="Name" class="md-label">Nome</label>
                    <input asp-for="Name" class="md-input" placeholder="Nome da lição" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="md-form-row">
                    <label asp-for="Order" class="md-label">Ordem</label>
                    <input asp-for="Order" class="md-input" type="number" min="1" />
                </div>
            </div>
            <div class="col-12">
                <div class="md-form-row">
                    <label asp-for="Description" class="md-label">Descrição</label>
                    <textarea asp-for="Description" class="md-input" rows="2" placeholder="Descrição opcional"></textarea>
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="Video" class="md-label">URL do Vídeo</label>
                    <input asp-for="Video" class="md-input" placeholder="https://..." />
                </div>
            </div>
            <div class="col-md-6">
                <div class="md-form-row">
                    <label asp-for="TimeLesson" class="md-label">Duração (hh:mm:ss)</label>
                    <input asp-for="TimeLesson" class="md-input" placeholder="00:05:30" />
                </div>
            </div>
            <div class="col-12">
                <div class="row g-2">
                    <div class="col-md-4">
                        <div class="md-form-check">
                            <input asp-for="IsActived" type="checkbox" />
                            <label asp-for="IsActived">Activo</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="md-form-check">
                            <input asp-for="IsFreePreview" type="checkbox" />
                            <label asp-for="IsFreePreview">Preview Gratuito</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="md-form-check">
                            <input asp-for="IsTest" type="checkbox" />
                            <label asp-for="IsTest">É Teste/Quiz</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div style="display:flex; gap:12px; margin-top:24px;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function loadTopics(courseId) {
        const select = document.getElementById('topicSelect');
        select.innerHTML = '<option value="">A carregar...</option>';
        if (!courseId) { select.innerHTML = '<option value="">Seleccionar tópico...</option>'; return; }
        fetch('/Topics/GetByCourse?courseId=' + courseId)
            .then(r => r.json())
            .then(data => {
                select.innerHTML = '<option value="">Seleccionar tópico...</option>';
                data.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.id; opt.text = t.name;
                    select.appendChild(opt);
                });
            });
    }
</script>
}
