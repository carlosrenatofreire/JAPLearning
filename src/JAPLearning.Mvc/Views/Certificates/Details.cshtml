@model JAPLearning.Mvc.ViewModels.Entities.CertificateViewModel
@{
    ViewData["Title"] = "Detalhes do Certificado";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Detalhes do Certificado</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Certificados</a> / Detalhes</p>
    </div>
</div>

<div class="md-card" style="max-width:600px;">
    <div style="text-align:center; padding:20px 0 28px; border-bottom:1px solid var(--md-border); margin-bottom:24px;">
        <i class="bi bi-award" style="font-size:48px; color:var(--md-accent);"></i>
        <h5 style="color:var(--md-text-primary); margin-top:12px; margin-bottom:4px;">Certificado de Conclusão</h5>
        <p style="color:var(--md-text-muted); font-size:13px;">Emitido pela plataforma JAPLearning</p>
    </div>

    <dl style="display:grid; grid-template-columns:160px 1fr; gap:16px 12px; margin:0;">
        <dt style="color:var(--md-text-muted); font-size:13px;">Utilizador</dt>
        <dd style="color:var(--md-text-primary); font-weight:600; margin:0;">@Model.UserFullName</dd>

        <dt style="color:var(--md-text-muted); font-size:13px;">Curso</dt>
        <dd style="margin:0;"><span class="md-badge md-badge-info">@Model.CourseTitle</span></dd>

        <dt style="color:var(--md-text-muted); font-size:13px;">Data de Conclusão</dt>
        <dd style="margin:0;">@Model.CompletedDate.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-PT"))</dd>

        <dt style="color:var(--md-text-muted); font-size:13px;">Código de Validação</dt>
        <dd style="font-family:monospace; font-size:14px; color:var(--md-accent); letter-spacing:2px; margin:0;">
            @(Model.ValidationCode ?? "—")
        </dd>

        <dt style="color:var(--md-text-muted); font-size:13px;">Ficheiro</dt>
        <dd style="margin:0;">
            @if (!string.IsNullOrEmpty(Model.CertifiedFile))
            {
                <a href="@Model.CertifiedFile" target="_blank" style="color:var(--md-accent);">
                    <i class="bi bi-file-earmark-pdf"></i> Ver certificado
                </a>
            }
            else { <span style="color:var(--md-text-muted);">—</span> }
        </dd>
    </dl>

    <div style="margin-top:24px; padding-top:20px; border-top:1px solid var(--md-border);">
        <a asp-action="Index" class="btn-md-secondary"><i class="bi bi-arrow-left"></i> Voltar</a>
    </div>
</div>
