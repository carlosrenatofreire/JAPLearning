@model JAPLearning.Mvc.ViewModels.Entities.CertificateViewModel
@{
    ViewData["Title"] = "Detalhes do Certificado";
    var certViewUrl = Url.Action("CertificateView", "Student", new { id = Model.Id });
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Detalhes do Certificado</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Certificados</a> / Detalhes</p>
    </div>
</div>

<div style="display:flex; flex-direction:column; align-items:center; gap:28px;">

    <!-- ── Info card ───────────────────────────────────────────── -->
    <div class="md-card" style="width:100%; max-width:680px;">

        <!-- Header -->
        <div style="text-align:center; padding:20px 0 24px; border-bottom:1px solid var(--md-border); margin-bottom:24px;">
            <div style="width:64px; height:64px; border-radius:50%;
                        background:rgba(232,80,26,0.12); border:2px solid rgba(232,80,26,0.3);
                        display:flex; align-items:center; justify-content:center;
                        margin:0 auto 12px;">
                <i class="bi bi-award-fill" style="font-size:30px; color:var(--md-accent);"></i>
            </div>
            <h5 style="color:var(--md-text-primary); margin:0 0 4px; font-size:18px; font-weight:800;">
                Certificado de Conclusão
            </h5>
            <p style="color:var(--md-text-muted); font-size:13px; margin:0;">
                Emitido pela plataforma JAP Learning
            </p>
        </div>

        <!-- Details grid -->
        <dl style="display:grid; grid-template-columns:170px 1fr; gap:16px 12px; margin:0 0 24px;">
            <dt style="color:var(--md-text-muted); font-size:13px; display:flex; align-items:center; gap:6px;">
                <i class="bi bi-person"></i> Utilizador
            </dt>
            <dd style="color:var(--md-text-primary); font-weight:700; margin:0; font-size:15px;">
                @Model.UserFullName
            </dd>

            <dt style="color:var(--md-text-muted); font-size:13px; display:flex; align-items:center; gap:6px;">
                <i class="bi bi-collection-play"></i> Formação
            </dt>
            <dd style="margin:0;">
                <span class="md-badge md-badge-info">@Model.CourseTitle</span>
            </dd>

            <dt style="color:var(--md-text-muted); font-size:13px; display:flex; align-items:center; gap:6px;">
                <i class="bi bi-bar-chart"></i> Nota Final
            </dt>
            <dd style="margin:0; font-weight:700; font-size:15px;"
                style="color:@(Model.ScorePercent >= 70 ? "#4caf82" : "var(--md-accent)")">
                <span style="color:@(Model.ScorePercent >= 70 ? "#4caf82" : "var(--md-accent)");">
                    @Model.ScorePercent%
                </span>
            </dd>

            <dt style="color:var(--md-text-muted); font-size:13px; display:flex; align-items:center; gap:6px;">
                <i class="bi bi-calendar-check"></i> Data de Conclusão
            </dt>
            <dd style="margin:0;">
                @Model.CompletedDate.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-PT"))
            </dd>

            <dt style="color:var(--md-text-muted); font-size:13px; display:flex; align-items:center; gap:6px;">
                <i class="bi bi-shield-check"></i> Código de Validação
            </dt>
            <dd style="font-family:monospace; font-size:14px; color:var(--md-accent); letter-spacing:2px; margin:0;">
                @(Model.ValidationCode ?? "—")
            </dd>
        </dl>

        <!-- Actions -->
        <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;
                    padding-top:20px; border-top:1px solid var(--md-border);">
            <a href="@certViewUrl" target="_blank" class="btn-md-primary" style="gap:7px;">
                <i class="bi bi-award"></i> Ver Certificado
            </a>
            <a href="@certViewUrl" target="_blank" class="btn-md-ghost" style="gap:7px;"
               onclick="setTimeout(()=>{ let w=window.open('@certViewUrl','_blank'); w.onload=()=>w.print(); },100); return false;">
                <i class="bi bi-printer"></i> Imprimir / PDF
            </a>
            <a asp-action="Index" class="btn-md-ghost" style="gap:7px;">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    <!-- ── Certificate preview (iframe) ────────────────────────── -->
    <div style="width:100%; max-width:900px;">
        <p style="text-align:center; font-size:12px; color:var(--md-text-muted); margin-bottom:10px; text-transform:uppercase; letter-spacing:.08em; font-weight:700;">
            <i class="bi bi-eye"></i> Pré-visualização do Certificado
        </p>
        <div style="border:1px solid var(--md-border); border-radius:var(--md-radius); overflow:hidden;
                    box-shadow:0 4px 24px rgba(0,0,0,0.25);">
            <iframe src="@certViewUrl"
                    style="width:100%; height:620px; border:none; display:block;"
                    title="Pré-visualização do Certificado">
            </iframe>
        </div>
        <p style="text-align:center; font-size:11px; color:var(--md-text-muted); margin-top:8px;">
            <i class="bi bi-info-circle"></i>
            Para guardar em PDF: abrir o certificado e usar <kbd>Ctrl+P</kbd> → "Guardar como PDF"
        </p>
    </div>

</div>
