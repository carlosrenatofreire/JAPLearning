@model List<JAPLearning.Mvc.ViewModels.Auxiliaries.AuditLogViewModel>
@using JAPLearning.Business.Models.Enums
@{
    ViewData["Title"]      = "Auditoria";
    ViewData["ActiveMenu"] = "auditlogs";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";

    string LevelBadge(LogType level) => level switch
    {
        LogType.Info     => "<span class=\"md-badge\" style=\"background:rgba(99,102,241,0.15);color:#818CF8;\">Info</span>",
        LogType.Warning  => "<span class=\"md-badge\" style=\"background:rgba(245,158,11,0.15);color:var(--md-warning);\">Aviso</span>",
        LogType.Error    => "<span class=\"md-badge\" style=\"background:rgba(239,68,68,0.15);color:var(--md-danger);\">Erro</span>",
        LogType.Critical => "<span class=\"md-badge\" style=\"background:rgba(139,0,0,0.2);color:#ff4444;\">Crítico</span>",
        _                => ""
    };
}

@await Html.PartialAsync("_CrudStyles")

@if (TempData["Success"] != null)
{
    <div class="alert-success-md"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="md-alert md-alert-danger mb-3"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]</div>
}

<div class="page-header">
    <div>
        <h4 class="page-header-title">Auditoria</h4>
        <p class="page-header-sub">Registo de actividades e erros da aplicação</p>
    </div>
    <form asp-action="Clear" method="post" onsubmit="return confirm('Tem a certeza? Esta acção é irreversível.');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-md-secondary" style="color:var(--md-danger); border-color:var(--md-danger);">
            <i class="bi bi-trash3"></i> Limpar Registos
        </button>
    </form>
</div>

<!-- KPIs rápidos -->
@{
    var total    = Model.Count;
    var infos    = Model.Count(l => l.LogLevel == LogType.Info);
    var warnings = Model.Count(l => l.LogLevel == LogType.Warning);
    var errors   = Model.Count(l => l.LogLevel == LogType.Error || l.LogLevel == LogType.Critical);
    var totalBd  = (int)(ViewBag.TotalInDb ?? 0);
    var hasFilter = !string.IsNullOrWhiteSpace((string?)ViewBag.Search)
                 || !string.IsNullOrWhiteSpace((string?)ViewBag.FilterLevel)
                 || !string.IsNullOrWhiteSpace((string?)ViewBag.FilterEntity)
                 || !string.IsNullOrWhiteSpace((string?)ViewBag.FilterFrom)
                 || !string.IsNullOrWhiteSpace((string?)ViewBag.FilterTo);
}
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="md-card" style="padding:16px;">
            <div style="font-size:22px; font-weight:800; color:var(--md-text-primary);">@total</div>
            <div style="font-size:12px; color:var(--md-text-muted); margin-top:2px;">
                Total de Registos
                @if (hasFilter && totalBd != total)
                {
                    <span style="font-size:11px; color:var(--md-text-muted);"> (@totalBd na BD)</span>
                }
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="md-card" style="padding:16px;">
            <div style="font-size:22px; font-weight:800; color:#818CF8;">@infos</div>
            <div style="font-size:12px; color:var(--md-text-muted); margin-top:2px;">Informações</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="md-card" style="padding:16px;">
            <div style="font-size:22px; font-weight:800; color:var(--md-warning);">@warnings</div>
            <div style="font-size:12px; color:var(--md-text-muted); margin-top:2px;">Avisos</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="md-card" style="padding:16px;">
            <div style="font-size:22px; font-weight:800; color:var(--md-danger);">@errors</div>
            <div style="font-size:12px; color:var(--md-text-muted); margin-top:2px;">Erros</div>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="md-card mb-4" style="padding:16px;">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-12 col-md-4 col-lg-3">
            <label class="form-label" style="font-size:12px; color:var(--md-text-muted);">Pesquisar</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control md-input"
                   placeholder="Mensagem, utilizador…" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" style="font-size:12px; color:var(--md-text-muted);">Nível</label>
            <select name="level" class="form-select md-input">
                <option value="">Todos</option>
                @foreach (var lv in Enum.GetValues<LogType>())
                {
                    if (ViewBag.FilterLevel == lv.ToString())
                    {
                        <option value="@lv" selected>@lv</option>
                    }
                    else
                    {
                        <option value="@lv">@lv</option>
                    }
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" style="font-size:12px; color:var(--md-text-muted);">Entidade</label>
            <select name="entity" class="form-select md-input">
                <option value="">Todas</option>
                @foreach (var ent in (ViewBag.Entities as List<string> ?? new()))
                {
                    if (ViewBag.FilterEntity == ent)
                    {
                        <option value="@ent" selected>@ent</option>
                    }
                    else
                    {
                        <option value="@ent">@ent</option>
                    }
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" style="font-size:12px; color:var(--md-text-muted);">De</label>
            <input type="date" name="from" value="@ViewBag.FilterFrom" class="form-control md-input" autocomplete="off" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" style="font-size:12px; color:var(--md-text-muted);">Até</label>
            <input type="date" name="to" value="@ViewBag.FilterTo" class="form-control md-input" autocomplete="off" />
        </div>
        <div class="col-12 col-md-auto d-flex gap-2">
            <button type="submit" class="btn-md-primary" style="height:40px; padding:0 20px;">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
            <a asp-action="Index" class="btn-md-secondary" style="height:40px; padding:0 16px; display:inline-flex; align-items:center;">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </form>
</div>

<!-- Tabela -->
<div class="md-card" style="padding:0; overflow:hidden;">
    @if (Model.Any())
    {
        <table class="crud-table" style="margin:0;">
            <thead>
                <tr>
                    <th style="width:140px;">Data / Hora</th>
                    <th style="width:90px;">Nível</th>
                    <th style="width:120px;">Acção</th>
                    <th style="width:120px;">Entidade</th>
                    <th>Mensagem</th>
                    <th style="width:150px;">Utilizador</th>
                    <th style="width:70px; text-align:center;">HTTP</th>
                    <th style="width:60px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td style="font-size:12px; white-space:nowrap; color:var(--md-text-muted);">
                            @log.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")
                        </td>
                        <td>@Html.Raw(LevelBadge(log.LogLevel))</td>
                        <td style="font-size:12px;">
                            @if (!string.IsNullOrWhiteSpace(log.Action))
                            {
                                <span style="font-weight:600; color:var(--md-text-secondary);">@log.Action</span>
                            }
                            else { <text>—</text> }
                        </td>
                        <td style="font-size:12px; color:var(--md-text-secondary);">
                            @(log.EntityName ?? "—")
                        </td>
                        <td style="font-size:13px; max-width:300px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                            @log.Message
                        </td>
                        <td style="font-size:12px; color:var(--md-text-muted);">@log.CreatedBy</td>
                        <td style="text-align:center;">
                            @if (log.HttpStatusCode.HasValue)
                            {
                                var codeColor = log.HttpStatusCode >= 500 ? "var(--md-danger)"
                                              : log.HttpStatusCode >= 400 ? "var(--md-warning)"
                                              : "var(--md-success)";
                                <span style="font-weight:700; font-size:12px; color:@codeColor;">@log.HttpStatusCode</span>
                            }
                            else
                            {
                                <span style="color:var(--md-text-muted);">—</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            <a asp-action="Details" asp-route-id="@log.Id"
                               class="action-btn" title="Ver detalhe">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align:center; padding:60px; color:var(--md-text-muted);">
            <i class="bi bi-journal-x" style="font-size:40px; display:block; margin-bottom:12px;"></i>
            @if (hasFilter)
            {
                <p style="margin:0;">Nenhum registo encontrado com os filtros aplicados.</p>
                <p style="margin:8px 0 0; font-size:13px;">
                    <a asp-action="Index" style="color:var(--md-primary);">Limpar filtros</a> para ver todos os registos
                    @if (totalBd > 0)
                    {
                        <span> (@totalBd no total)</span>
                    }
                </p>
            }
            else
            {
                <p style="margin:0;">Nenhum registo de auditoria encontrado.</p>
            }
        </div>
    }
</div>
