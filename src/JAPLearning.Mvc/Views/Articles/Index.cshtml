@model List<JAPLearning.Mvc.ViewModels.Entities.ArticleViewModel>
@{
    ViewData["Title"] = "Artigos";
}
@await Html.PartialAsync("_CrudStyles")

@if (TempData["Success"] != null)
{
    <div class="alert-success-md"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="page-header">
    <div>
        <h4 class="page-header-title">Artigos</h4>
        <p class="page-header-sub">Gestão de artigos e conteúdo editorial</p>
    </div>
    <a asp-action="Create" class="btn-md-primary"><i class="bi bi-plus-lg"></i> Novo Artigo</a>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">
    <table class="crud-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Assunto</th>
                <th>Autor</th>
                <th>Data Publicação</th>
                <th>Leitura</th>
                <th>Estado</th>
                <th style="width:100px; text-align:center;">Acções</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:var(--md-text-primary); font-weight:600;">@item.Name</td>
                    <td><span class="md-badge md-badge-info">@item.SubjectName</span></td>
                    <td>@(item.Author ?? "—")</td>
                    <td>@item.PublishDate.ToString("dd/MM/yyyy")</td>
                    <td>@(item.ReadingTime.HasValue ? $"{item.ReadingTime} min" : "—")</td>
                    <td>
                        @if (item.IsActived) { <span class="badge-active"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Activo</span> }
                        else { <span class="badge-inactive"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Inactivo</span> }
                    </td>
                    <td style="text-align:center;">
                        <div style="display:flex; gap:6px; justify-content:center;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="margin:0;"
                                  onsubmit="return confirm('Eliminar este artigo?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-btn danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" style="text-align:center; padding:40px; color:var(--md-text-muted);">
                    <i class="bi bi-newspaper" style="font-size:32px; display:block; margin-bottom:8px;"></i>
                    Nenhum artigo encontrado.
                </td></tr>
            }
        </tbody>
    </table>
</div>
