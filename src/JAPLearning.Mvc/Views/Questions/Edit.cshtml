@model JAPLearning.Mvc.ViewModels.Entities.QuestionViewModel
@{
    ViewData["Title"] = "Editar Questão";
    var selectedTeamId   = ViewBag.SelectedTeamId   as Guid?;
    var selectedCourseId = ViewBag.SelectedCourseId as Guid?;
    var selectedTopicId  = ViewBag.SelectedTopicId  as Guid?;
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Editar Questão</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Questões</a> / Editar</p>
    </div>
</div>

<div style="display:flex; gap:24px; flex-wrap:wrap; align-items:flex-start;">
    <div class="md-card form-card" style="flex:1; min-width:400px;">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="row g-3">

                <!-- Equipa (3) + Formação (3) + Tópico (3) + Lição (3) -->
                <div class="col-md-3">
                    <div class="md-form-row">
                        <label class="md-label">Equipa</label>
                        <select id="teamSelect" asp-items="ViewBag.Teams" class="md-select">
                            <option value="">Seleccionar...</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="md-form-row">
                        <label class="md-label">Formação</label>
                        <select id="courseSelect" class="md-select" disabled="@(!selectedTeamId.HasValue)">
                            <option value="">— Equipa primeiro —</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="md-form-row">
                        <label class="md-label">Tópico</label>
                        <select id="topicSelect" class="md-select" disabled="@(!selectedCourseId.HasValue)">
                            <option value="">— Formação primeiro —</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="md-form-row">
                        <label asp-for="LessonId" class="md-label">Lição <span class="text-danger">*</span></label>
                        <select asp-for="LessonId" id="lessonSelect" class="md-select" disabled="@(!selectedTopicId.HasValue)">
                            <option value="">— Tópico primeiro —</option>
                        </select>
                        <span asp-validation-for="LessonId" class="text-danger" style="font-size:12px;"></span>
                    </div>
                </div>

                <!-- Questão (8) + Activa (4) -->
                <div class="col-md-8">
                    <div class="md-form-row">
                        <label asp-for="Name" class="md-label">Questão <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="md-input" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                    </div>
                </div>
                <div class="col-md-4" style="display:flex; align-items:flex-end; padding-bottom:4px;">
                    <div class="md-form-check">
                        <input asp-for="IsActived" type="checkbox" />
                        <label asp-for="IsActived">Activa</label>
                    </div>
                </div>

                <!-- Descrição (12) -->
                <div class="col-12">
                    <div class="md-form-row">
                        <label asp-for="Description" class="md-label">Descrição / Contexto</label>
                        <textarea asp-for="Description" class="md-input" rows="3"></textarea>
                    </div>
                </div>

            </div>

            <div style="display:flex; gap:12px; margin-top:24px;">
                <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
                <a asp-action="Index" class="btn-md-ghost">Cancelar</a>
            </div>
        </form>
    </div>

    @if (Model.Options.Any())
    {
        <div class="md-card" style="min-width:320px; max-width:420px;">
            <h6 style="color:var(--md-text-primary); margin-bottom:16px; font-size:14px; font-weight:600;">
                <i class="bi bi-list-check"></i> Opções de Resposta
            </h6>
            @foreach (var opt in Model.Options)
            {
                <div style="display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--md-border);">
                    @if (opt.IsCorrect)
                    {
                        <i class="bi bi-check-circle-fill" style="color:#4caf82; flex-shrink:0;"></i>
                    }
                    else
                    {
                        <i class="bi bi-circle" style="color:var(--md-text-muted); flex-shrink:0;"></i>
                    }
                    <span style="color:var(--md-text-primary); font-size:14px; flex:1;">@opt.Name</span>
                    <a asp-controller="QuestionOptions" asp-action="Edit" asp-route-id="@opt.Id"
                       class="action-btn" title="Editar opção" style="padding:4px 8px;">
                        <i class="bi bi-pencil"></i>
                    </a>
                </div>
            }
            <div style="margin-top:14px;">
                <a asp-controller="QuestionOptions" asp-action="Create" class="btn-md-secondary" style="font-size:13px; padding:6px 14px;">
                    <i class="bi bi-plus"></i> Adicionar Opção
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="md-card" style="min-width:280px; text-align:center; padding:32px;">
            <i class="bi bi-list-check" style="font-size:28px; color:var(--md-text-muted); display:block; margin-bottom:10px;"></i>
            <p style="color:var(--md-text-muted); font-size:13px; margin-bottom:16px;">Ainda sem opções de resposta.</p>
            <a asp-controller="QuestionOptions" asp-action="Create" class="btn-md-primary" style="font-size:13px;">
                <i class="bi bi-plus"></i> Adicionar Opção
            </a>
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
    const teamSel   = document.getElementById('teamSelect');
    const courseSel = document.getElementById('courseSelect');
    const topicSel  = document.getElementById('topicSelect');
    const lessonSel = document.getElementById('lessonSelect');

    const initTeamId   = '@(selectedTeamId?.ToString() ?? "")';
    const initCourseId = '@(selectedCourseId?.ToString() ?? "")';
    const initTopicId  = '@(selectedTopicId?.ToString() ?? "")';
    const initLessonId = '@Model.LessonId';

    function resetSelect(sel, placeholder) {
        sel.innerHTML = `<option value="">${placeholder}</option>`;
        sel.disabled = true;
    }

    function loadCourses(teamId, selectVal) {
        return fetch(`/Questions/GetCoursesByTeam?teamId=${teamId}`)
            .then(r => r.json()).then(data => {
                courseSel.innerHTML = '<option value="">Seleccionar formação...</option>';
                data.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.value; opt.text = c.text;
                    if (c.value === selectVal) opt.selected = true;
                    courseSel.appendChild(opt);
                });
                courseSel.disabled = data.length === 0;
            });
    }

    function loadTopics(courseId, selectVal) {
        return fetch(`/Questions/GetTopicsByCourse?courseId=${courseId}`)
            .then(r => r.json()).then(data => {
                topicSel.innerHTML = '<option value="">Seleccionar tópico...</option>';
                data.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.value; opt.text = t.text;
                    if (t.value === selectVal) opt.selected = true;
                    topicSel.appendChild(opt);
                });
                topicSel.disabled = data.length === 0;
            });
    }

    function loadLessons(topicId, selectVal) {
        return fetch(`/Questions/GetLessonsByTopic?topicId=${topicId}`)
            .then(r => r.json()).then(data => {
                lessonSel.innerHTML = '<option value="">Seleccionar lição...</option>';
                data.forEach(l => {
                    const opt = document.createElement('option');
                    opt.value = l.value; opt.text = l.text;
                    if (l.value === selectVal) opt.selected = true;
                    lessonSel.appendChild(opt);
                });
                lessonSel.disabled = data.length === 0;
            });
    }

    // Pré-selecção em cascata no load
    if (initTeamId) {
        teamSel.value = initTeamId;
        loadCourses(initTeamId, initCourseId).then(() => {
            if (initCourseId) {
                loadTopics(initCourseId, initTopicId).then(() => {
                    if (initTopicId) loadLessons(initTopicId, initLessonId);
                });
            }
        });
    }

    // Eventos de mudança
    teamSel.addEventListener('change', function () {
        resetSelect(courseSel, '— Seleccione a equipa primeiro —');
        resetSelect(topicSel,  '— Seleccione a formação primeiro —');
        resetSelect(lessonSel, '— Seleccione o tópico primeiro —');
        if (this.value) loadCourses(this.value, '');
    });

    courseSel.addEventListener('change', function () {
        resetSelect(topicSel,  '— Seleccione a formação primeiro —');
        resetSelect(lessonSel, '— Seleccione o tópico primeiro —');
        if (this.value) loadTopics(this.value, '');
    });

    topicSel.addEventListener('change', function () {
        resetSelect(lessonSel, '— Seleccione o tópico primeiro —');
        if (this.value) loadLessons(this.value, '');
    });
})();
</script>
}

