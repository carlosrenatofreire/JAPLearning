@model List<JAPLearning.Mvc.ViewModels.Entities.QuestionViewModel>
@{
    ViewData["Title"] = "Questões";
}
@await Html.PartialAsync("_CrudStyles")

@if (TempData["Success"] != null)
{
    <div class="alert-success-md"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="page-header">
    <div>
        <h4 class="page-header-title">Questões</h4>
        <p class="page-header-sub">Gestão de questões dos testes por lição</p>
    </div>
    <a asp-action="Create" class="btn-md-primary"><i class="bi bi-plus-lg"></i> Nova Questão</a>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">
    <table class="crud-table">
        <thead>
            <tr>
                <th>Questão</th>
                <th>Lição</th>
                <th>Opções</th>
                <th>Estado</th>
                <th style="width:100px; text-align:center;">Acções</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:var(--md-text-primary); font-weight:600;">@item.Name</td>
                    <td><span class="md-badge md-badge-info">@item.LessonName</span></td>
                    <td>
                        <span style="color:var(--md-text-muted); font-size:13px;">
                            @item.Options.Count opção(ões)
                            @{
                                var correct = item.Options.Count(o => o.IsCorrect);
                                if (correct > 0)
                                {
                                    <span class="badge-active ms-1">@correct correcta(s)</span>
                                }
                            }
                        </span>
                    </td>
                    <td>
                        @if (item.IsActived) { <span class="badge-active"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Activo</span> }
                        else { <span class="badge-inactive"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Inactivo</span> }
                    </td>
                    <td style="text-align:center;">
                        <div style="display:flex; gap:6px; justify-content:center;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="margin:0;"
                                  onsubmit="return confirm('Eliminar esta questão e todas as suas opções?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-btn danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" style="text-align:center; padding:40px; color:var(--md-text-muted);">
                    <i class="bi bi-question-circle" style="font-size:32px; display:block; margin-bottom:8px;"></i>
                    Nenhuma questão encontrada.
                </td></tr>
            }
        </tbody>
    </table>
</div>
