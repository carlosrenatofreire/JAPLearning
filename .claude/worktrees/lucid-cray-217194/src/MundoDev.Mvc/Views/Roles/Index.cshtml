@model List<MundoDev.Mvc.ViewModels.Parameters.RoleViewModel>
@{
    ViewData["Title"] = "Perfis";
}
@await Html.PartialAsync("_CrudStyles")

@if (TempData["Success"] != null)
{
    <div class="alert-success-md"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="page-header">
    <div>
        <h4 class="page-header-title">Perfis</h4>
        <p class="page-header-sub">Gestão de perfis de acesso ao sistema</p>
    </div>
    <a asp-action="Create" class="btn-md-primary"><i class="bi bi-plus-lg"></i> Novo Perfil</a>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">
    <table class="crud-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Estado</th>
                <th style="width:100px; text-align:center;">Acções</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:var(--md-text-primary); font-weight:600;">@item.Name</td>
                    <td>@(item.Description ?? "—")</td>
                    <td>
                        @if (item.IsActived)
                        {
                            <span class="badge-active"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Activo</span>
                        }
                        else
                        {
                            <span class="badge-inactive"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Inactivo</span>
                        }
                    </td>
                    <td style="text-align:center;">
                        <div style="display:flex; gap:6px; justify-content:center;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="margin:0;"
                                  onsubmit="return confirm('Eliminar este perfil?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-btn danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" style="text-align:center; padding:40px; color:var(--md-text-muted);">
                    <i class="bi bi-inbox" style="font-size:32px; display:block; margin-bottom:8px;"></i>
                    Nenhum registo encontrado.
                </td></tr>
            }
        </tbody>
    </table>
</div>
