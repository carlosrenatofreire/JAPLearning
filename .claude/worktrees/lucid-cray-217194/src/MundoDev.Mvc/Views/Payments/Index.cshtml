@model List<MundoDev.Mvc.ViewModels.Entities.PaymentViewModel>
@{
    ViewData["Title"] = "Pagamentos";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Pagamentos</h4>
        <p class="page-header-sub">Registo de pagamentos processados</p>
    </div>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">
    <table class="crud-table">
        <thead>
            <tr>
                <th>Utilizador</th>
                <th>Pedido</th>
                <th>Tipo</th>
                <th>Gateway</th>
                <th>ID Transacção</th>
                <th>Data Pagamento</th>
                <th style="width:80px; text-align:center;">Detalhes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:var(--md-text-primary); font-weight:600;">@item.UserFullName</td>
                    <td style="font-family:monospace; font-size:12px; color:var(--md-text-muted);">
                        @item.OrderId.ToString()[..8]…
                    </td>
                    <td>
                        @switch (item.PaymentType)
                        {
                            case MundoDev.Business.Models.Enums.PaymentType.CreditCard:
                                <span class="md-badge md-badge-info"><i class="bi bi-credit-card"></i> Cartão</span>
                                break;
                            case MundoDev.Business.Models.Enums.PaymentType.BankTransfer:
                                <span class="md-badge md-badge-success"><i class="bi bi-bank"></i> Transferência</span>
                                break;
                            case MundoDev.Business.Models.Enums.PaymentType.MbWay:
                                <span class="md-badge md-badge-warning"><i class="bi bi-phone"></i> MBWay</span>
                                break;
                            default:
                                <span class="md-badge">@item.PaymentType</span>
                                break;
                        }
                    </td>
                    <td>@(item.Gateway ?? "—")</td>
                    <td style="font-family:monospace; font-size:12px;">@(item.TransactionId ?? "—")</td>
                    <td>@item.PaidDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td style="text-align:center;">
                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn" title="Ver detalhes">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" style="text-align:center; padding:40px; color:var(--md-text-muted);">
                    <i class="bi bi-cash-stack" style="font-size:32px; display:block; margin-bottom:8px;"></i>
                    Nenhum pagamento registado.
                </td></tr>
            }
        </tbody>
    </table>
</div>
