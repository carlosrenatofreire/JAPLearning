@model MundoDev.Mvc.ViewModels.Entities.QuestionViewModel
@{
    ViewData["Title"] = "Nova Questão";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Nova Questão</h4>
        <p class="page-header-sub"><a asp-action="Index" style="color:var(--md-accent);">Questões</a> / Criar</p>
    </div>
</div>

<div class="md-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation-summary"></div>

        <div class="mb-3">
            <label class="md-label">Lição <span class="text-danger">*</span></label>
            <select asp-for="LessonId" asp-items="ViewBag.Lessons" class="md-input">
                <option value="">— Seleccionar —</option>
            </select>
            <span asp-validation-for="LessonId" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label class="md-label">Questão <span class="text-danger">*</span></label>
            <input asp-for="Name" class="md-input" placeholder="Texto da questão" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="mb-3">
            <label class="md-label">Descrição / Contexto</label>
            <textarea asp-for="Description" class="md-input" rows="2" placeholder="Contexto adicional (opcional)"></textarea>
        </div>

        <div class="mb-4">
            <label class="md-form-check">
                <input asp-for="IsActived" type="checkbox" />
                <span>Activa</span>
            </label>
        </div>

        <div style="display:flex; gap:12px; align-items:center;">
            <button type="submit" class="btn-md-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn-md-secondary">Cancelar</a>
            <span style="color:var(--md-text-muted); font-size:13px; margin-left:8px;">
                <i class="bi bi-info-circle"></i> Após criar, adicione as opções de resposta em <a asp-controller="QuestionOptions" asp-action="Create" style="color:var(--md-accent);">Opções de Questão</a>.
            </span>
        </div>
    </form>
</div>
