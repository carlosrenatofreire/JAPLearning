@model MundoDev.Mvc.ViewModels.Student.ChangePasswordViewModel
@{
    ViewData["Title"]      = "Alterar Senha";
    ViewData["ActiveMenu"] = "profile";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}
@await Html.PartialAsync("_CrudStyles")

<div class="page-header">
    <div>
        <h4 class="page-header-title">Alterar Senha</h4>
        <p class="page-header-sub">Defina uma nova senha de acesso</p>
    </div>
    <a asp-action="PersonalData" class="btn-md-ghost">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="md-card">
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert-danger-md" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="md-form-group">
                    <label asp-for="CurrentPassword" class="md-label"></label>
                    <input asp-for="CurrentPassword" class="md-input" type="password" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="md-form-group">
                    <label asp-for="NewPassword" class="md-label"></label>
                    <input asp-for="NewPassword" class="md-input" type="password" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="md-form-group">
                    <label asp-for="ConfirmPassword" class="md-label"></label>
                    <input asp-for="ConfirmPassword" class="md-input" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div style="margin-top:24px;">
                    <button type="submit" class="btn-md-primary">
                        <i class="bi bi-shield-lock"></i> Actualizar Senha
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
