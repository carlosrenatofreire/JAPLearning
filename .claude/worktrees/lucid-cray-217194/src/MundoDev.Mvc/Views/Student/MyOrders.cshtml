@model List<MundoDev.Mvc.ViewModels.Entities.OrderViewModel>
@{
    ViewData["Title"]      = "Meus Pedidos";
    ViewData["ActiveMenu"] = "my-orders";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="page-header">
    <div>
        <h4 class="page-header-title">Meus Pedidos</h4>
        <p class="page-header-sub">Histórico de subscrições e pagamentos</p>
    </div>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">
    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="border-bottom:1px solid var(--md-border);">
                <th style="padding:14px 20px; text-align:left; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--md-text-muted); white-space:nowrap;">Plano</th>
                <th style="padding:14px 20px; text-align:left; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--md-text-muted); white-space:nowrap;">Início</th>
                <th style="padding:14px 20px; text-align:left; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--md-text-muted); white-space:nowrap;">Validade</th>
                <th style="padding:14px 20px; text-align:left; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--md-text-muted); white-space:nowrap;">Valor</th>
                <th style="padding:14px 20px; text-align:left; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--md-text-muted); white-space:nowrap;">Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr style="border-bottom:1px solid var(--md-border);">
                    <td style="padding:16px 20px; font-weight:600; color:var(--md-text-primary); white-space:nowrap;">@order.PlanName</td>
                    <td style="padding:16px 20px; color:var(--md-text-muted); white-space:nowrap;">@order.StartLicense.ToString("dd/MM/yyyy")</td>
                    <td style="padding:16px 20px; color:var(--md-text-muted); white-space:nowrap;">@order.EndLicense.ToString("dd/MM/yyyy")</td>
                    <td style="padding:16px 20px; font-weight:600; white-space:nowrap;">@order.Value.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</td>
                    <td style="padding:16px 20px;">
                        @if (order.IsActived)
                        {
                            <span style="display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;background:rgba(34,197,94,.12);color:#22c55e;font-size:12px;font-weight:600;">
                                <i class="bi bi-circle-fill" style="font-size:6px;"></i> @order.StatusName
                            </span>
                        }
                        else
                        {
                            <span style="display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;background:rgba(148,163,184,.1);color:var(--md-text-muted);font-size:12px;font-weight:600;">
                                <i class="bi bi-circle-fill" style="font-size:6px;"></i> @order.StatusName
                            </span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" style="text-align:center; padding:60px 20px; color:var(--md-text-muted);">
                    <i class="bi bi-bag-x" style="font-size:36px; display:block; margin-bottom:12px; opacity:.5;"></i>
                    Nenhum pedido encontrado.
                </td></tr>
            }
        </tbody>
    </table>
</div>
