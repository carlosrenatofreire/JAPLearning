@model List<MundoDev.Mvc.ViewModels.Entities.OrderViewModel>
@{
    ViewData["Title"] = "Pedidos";
}
@await Html.PartialAsync("_CrudStyles")

@if (TempData["Success"] != null)
{
    <div class="alert-success-md"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}

<div class="page-header">
    <div>
        <h4 class="page-header-title">Pedidos</h4>
        <p class="page-header-sub">Gestão de pedidos de subscrição</p>
    </div>
    <a asp-action="Create" class="btn-md-primary"><i class="bi bi-plus-lg"></i> Novo Pedido</a>
</div>

<div class="md-card" style="padding:0; overflow:hidden;">
    <table class="crud-table">
        <thead>
            <tr>
                <th>Utilizador</th>
                <th>Plano</th>
                <th>Início</th>
                <th>Fim</th>
                <th>Valor</th>
                <th>Estado</th>
                <th style="width:100px; text-align:center;">Acções</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:var(--md-text-primary); font-weight:600;">@item.UserFullName</td>
                    <td><span class="md-badge md-badge-info">@item.PlanName</span></td>
                    <td>@item.StartLicense.ToString("dd/MM/yyyy")</td>
                    <td>@item.EndLicense.ToString("dd/MM/yyyy")</td>
                    <td style="color:var(--md-accent); font-weight:600;">
                        @((item.Value - item.Discount).ToString("C", new System.Globalization.CultureInfo("pt-PT")))
                    </td>
                    <td>
                        @if (item.StatusName == "Activo" || item.StatusName == "Aprovado")
                        { <span class="badge-active">@item.StatusName</span> }
                        else if (item.StatusName == "Pendente")
                        { <span class="md-badge md-badge-warning">@item.StatusName</span> }
                        else
                        { <span class="badge-inactive">@item.StatusName</span> }
                    </td>
                    <td style="text-align:center;">
                        <div style="display:flex; gap:6px; justify-content:center;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="margin:0;"
                                  onsubmit="return confirm('Eliminar este pedido?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-btn danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" style="text-align:center; padding:40px; color:var(--md-text-muted);">
                    <i class="bi bi-bag-check" style="font-size:32px; display:block; margin-bottom:8px;"></i>
                    Nenhum pedido encontrado.
                </td></tr>
            }
        </tbody>
    </table>
</div>
