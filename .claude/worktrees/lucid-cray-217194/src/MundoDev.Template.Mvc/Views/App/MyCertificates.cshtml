@{
    ViewData["Title"] = "Meus Certificados";
    ViewData["ActiveMenu"] = "certificates";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="row g-4">
    @for (int i = 1; i <= 3; i++)
    {
        <div class="col-md-6 col-lg-4">
            <div class="md-card text-center">
                <div style="background:linear-gradient(135deg, rgba(232,80,26,0.1), rgba(160,31,58,0.05)); border:1px solid rgba(232,80,26,0.2); border-radius:var(--md-radius); padding:28px; margin-bottom:16px;">
                    <i class="bi bi-award-fill" style="font-size:48px; color:var(--md-accent);"></i>
                    <p style="font-weight:800; font-size:13px; text-transform:uppercase; letter-spacing:.1em; color:var(--md-accent); margin:12px 0 4px;">MundoDev</p>
                    <p style="font-weight:700; font-size:15px; color:var(--md-text-primary); margin:0;">Certificado de Conclusão</p>
                </div>
                <p style="font-weight:700; font-size:14px; color:var(--md-text-primary); margin-bottom:4px;">Sistema de Gestão de KPIs</p>
                <p style="font-size:12px; color:var(--md-text-muted); margin-bottom:16px;">Emitido em 01/05/2026</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a href="#" class="btn-md-primary" style="font-size:13px; padding:8px 16px;">
                        <i class="bi bi-download"></i> PDF
                    </a>
                    <a href="#" class="btn-md-ghost" style="font-size:13px; padding:8px 16px; border:1px solid var(--md-border);">
                        <i class="bi bi-linkedin"></i> LinkedIn
                    </a>
                </div>
            </div>
        </div>
    }
</div>
