@{
    var statusCode = (int)(ViewData["StatusCode"] ?? 500);
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";

    var (icon, headline, description, showHome, showBack) = statusCode switch
    {
        401 => ("bi-lock-fill",
                "Sessão Expirada",
                "Precisa de estar autenticado para aceder a esta página. Faça login e tente novamente.",
                false, false),
        403 => ("bi-shield-lock-fill",
                "Acesso Negado",
                "Não tem permissão para aceder a este recurso. Se acredita que isto é um erro, contacte o suporte.",
                true, true),
        404 => ("bi-map-fill",
                "Página Não Encontrada",
                "A página que procura não existe ou foi movida. Verifique o endereço ou volte ao início.",
                true, true),
        500 => ("bi-exclamation-triangle-fill",
                "Erro Interno",
                "Algo correu mal do nosso lado. Já fomos notificados e estamos a trabalhar para resolver.",
                true, false),
        _   => ("bi-question-circle-fill",
                "Ocorreu um Erro",
                "Algo inesperado aconteceu. Tente novamente ou volte à página inicial.",
                true, true)
    };

    var accentColor = statusCode switch
    {
        401 => "#f59e0b",
        403 => "#ef4444",
        404 => "var(--md-accent)",
        500 => "#ef4444",
        _   => "var(--md-accent)"
    };
}

<style>
    .error-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 0;
    }
    .error-card {
        text-align: center;
        max-width: 520px;
        width: 100%;
    }
    .error-code-display {
        font-size: 96px;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.04em;
        background: var(--md-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 8px;
    }
    .error-icon-wrap {
        width: 72px; height: 72px;
        border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 24px;
        font-size: 32px;
    }
    .error-headline {
        font-size: 26px;
        font-weight: 800;
        margin-bottom: 12px;
        color: var(--md-text-primary);
    }
    .error-description {
        font-size: 15px;
        color: var(--md-text-secondary);
        line-height: 1.7;
        margin-bottom: 36px;
    }
    .error-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }
</style>

<div class="container">
    <div class="error-page">
        <div class="error-card">

            <div class="error-icon-wrap" style="background: rgba(232,80,26,0.12);">
                <i class="bi @icon" style="color: @accentColor;"></i>
            </div>

            <div class="error-code-display">@statusCode</div>

            <h1 class="error-headline">@headline</h1>
            <p class="error-description">@description</p>

            <div class="error-actions">
                @if (statusCode == 401)
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn-md-primary">
                        <i class="bi bi-box-arrow-in-right"></i> Fazer Login
                    </a>
                }
                @if (showBack)
                {
                    <button onclick="history.back()" class="btn-md-outline">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </button>
                }
                @if (showHome)
                {
                    <a asp-controller="Home" asp-action="Index" class="btn-md-outline">
                        <i class="bi bi-house"></i> Página Inicial
                    </a>
                }
                @if (statusCode == 500)
                {
                    <a href="mailto:suporte@mundodev.app.br" class="btn-md-outline">
                        <i class="bi bi-envelope"></i> Contactar Suporte
                    </a>
                }
            </div>

        </div>
    </div>
</div>
