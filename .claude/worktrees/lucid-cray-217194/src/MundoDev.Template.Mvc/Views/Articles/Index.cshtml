@{
    ViewData["Title"] = "Artigos";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<div class="container">
    <div style="padding:60px 0 40px; border-bottom:1px solid var(--md-border); margin-bottom:48px;">
        <p style="color:var(--md-accent); font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; margin-bottom:10px;">Blog</p>
        <h1 style="font-size:38px; font-weight:900; margin-bottom:12px;">Artigos</h1>
        <p style="color:var(--md-text-secondary); font-size:16px; max-width:540px; margin:0;">
            Conteúdo técnico sobre arquitectura de software, .NET e boas práticas corporativas.
        </p>
    </div>

    <div class="row g-4 mb-5">
        @for (int i = 1; i <= 6; i++)
        {
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Articles" asp-action="Detail" asp-route-id="@i"
                   style="display:block; background:var(--md-bg-card); border:1px solid var(--md-border); border-radius:var(--md-radius-lg); overflow:hidden; text-decoration:none; transition:var(--md-transition);"
                   onmouseover="this.style.borderColor='rgba(232,80,26,0.35)'; this.style.transform='translateY(-3px)'"
                   onmouseout="this.style.borderColor='var(--md-border)'; this.style.transform='translateY(0)'">
                    <div style="height:160px; background:linear-gradient(135deg, rgba(232,80,26,0.15), rgba(160,31,58,0.08)); display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-file-earmark-text" style="font-size:48px; color:rgba(232,80,26,0.3);"></i>
                    </div>
                    <div style="padding:20px;">
                        <span class="md-badge md-badge-accent mb-3 d-inline-block">Arquitectura</span>
                        <p style="font-weight:700; font-size:15px; color:var(--md-text-primary); margin-bottom:8px; line-height:1.4;">
                            Como aplicar o C4 Model em projectos .NET reais
                        </p>
                        <p style="font-size:13px; color:var(--md-text-secondary); margin-bottom:14px; line-height:1.6;">
                            Aprenda a documentar a arquitectura do seu sistema de forma clara e eficaz usando os 4 níveis do C4 Model.
                        </p>
                        <div style="display:flex; align-items:center; gap:10px; font-size:12px; color:var(--md-text-muted);">
                            <div class="md-avatar" style="width:24px;height:24px;font-size:10px;">CF</div>
                            <span>Carlos Freire</span>
                            <span>·</span>
                            <span>13 Mai 2026</span>
                            <span>·</span>
                            <span>8 min leitura</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>
