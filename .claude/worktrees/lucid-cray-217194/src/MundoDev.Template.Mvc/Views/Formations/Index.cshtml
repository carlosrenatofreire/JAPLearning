@{
    ViewData["Title"] = "Formações Gratuitas";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<div class="container">
    <div style="padding:60px 0 40px; border-bottom:1px solid var(--md-border); margin-bottom:48px;">
        <span class="md-badge md-badge-success mb-3">100% Gratuito</span>
        <h1 style="font-size:38px; font-weight:900; margin-bottom:12px;">
            Formações <span class="md-gradient-text">Gratuitas</span>
        </h1>
        <p style="color:var(--md-text-secondary); font-size:16px; max-width:560px; margin:0;">
            Os fundamentos que todo arquiteto .NET precisa de dominar — sem custos, sem cartão de crédito.
            São também pré-requisitos para os projectos pagos da plataforma.
        </p>
    </div>

    <div class="row g-4 mb-5">

        <!-- Formação 1 -->
        <div class="col-md-6">
            <a asp-controller="Formations" asp-action="Detail" asp-route-id="1" class="md-course-card">
                <div class="md-course-card-thumb" style="background:linear-gradient(135deg,rgba(99,102,241,0.15),rgba(139,92,246,0.15)); border-bottom:1px solid var(--md-border);">
                    <div style="text-align:center; padding:32px 20px;">
                        <div style="width:64px;height:64px;border-radius:16px;background:linear-gradient(135deg,#6366F1,#8B5CF6);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:900;color:#fff;margin:0 auto 12px;">AS</div>
                        <span class="md-badge md-badge-success">Grátis</span>
                    </div>
                </div>
                <div class="md-course-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="md-badge" style="background:rgba(99,102,241,0.15); color:#a5b4fc;">Fundamentos</span>
                        <span style="color:var(--md-warning); font-size:12px;">★☆☆ Iniciante</span>
                    </div>
                    <p class="md-course-card-title">Fundamentos de Arquitetura de Software</p>
                    <div class="md-course-card-meta">
                        <span><i class="bi bi-play-circle"></i> 12 aulas</span>
                        <span><i class="bi bi-clock"></i> 3h 00min</span>
                        <span><i class="bi bi-folder"></i> 4 módulos</span>
                    </div>
                    <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--md-border-light); display:flex; align-items:center; gap:8px;">
                        <img src="/images/carlos-freire.jpg" alt="Carlos Freire" style="width:26px;height:26px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                        <span style="font-size:12px; color:var(--md-text-muted);">Carlos Freire</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Formação 2 -->
        <div class="col-md-6">
            <a asp-controller="Formations" asp-action="Detail" asp-route-id="2" class="md-course-card">
                <div class="md-course-card-thumb" style="background:linear-gradient(135deg,rgba(14,165,233,0.15),rgba(6,182,212,0.15)); border-bottom:1px solid var(--md-border);">
                    <div style="text-align:center; padding:32px 20px;">
                        <div style="width:64px;height:64px;border-radius:16px;background:linear-gradient(135deg,#0ea5e9,#06b6d4);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:900;color:#fff;margin:0 auto 12px;">C4</div>
                        <span class="md-badge md-badge-success">Grátis</span>
                    </div>
                </div>
                <div class="md-course-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="md-badge" style="background:rgba(14,165,233,0.15); color:#7dd3fc;">Fundamentos</span>
                        <span style="color:var(--md-warning); font-size:12px;">★☆☆ Iniciante</span>
                    </div>
                    <p class="md-course-card-title">Fundamentos do C4 Model</p>
                    <div class="md-course-card-meta">
                        <span><i class="bi bi-play-circle"></i> 8 aulas</span>
                        <span><i class="bi bi-clock"></i> 2h 00min</span>
                        <span><i class="bi bi-folder"></i> 4 módulos</span>
                    </div>
                    <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--md-border-light); display:flex; align-items:center; gap:8px;">
                        <img src="/images/carlos-freire.jpg" alt="Carlos Freire" style="width:26px;height:26px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                        <span style="font-size:12px; color:var(--md-text-muted);">Carlos Freire</span>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- CTA -->
    <div class="text-center py-5" style="border-top:1px solid var(--md-border);">
        <p style="color:var(--md-text-secondary); margin-bottom:20px; font-size:15px;">
            Depois dos fundamentos, estás pronto para os projectos reais.
        </p>
        <a asp-controller="Projects" asp-action="Index" class="btn-md-primary">
            Ver Projectos <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>
